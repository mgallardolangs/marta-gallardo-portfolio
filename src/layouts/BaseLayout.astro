---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import MotionRuntime from '../components/MotionRuntime.astro';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  alternateLocales?: Lang[];
  alternateLinks?: Partial<Record<Lang, string>>;
  xDefaultPath?: string;
}

const { lang: requestedLang } = Astro.props;
const lang = requestedLang ?? getLangFromUrl(Astro.url);
const i = t(lang);
const {
  title = `${i.hero.name} — UGC & SEO`,
  description = i.about.text,
  image,
  alternateLocales,
  alternateLinks,
  xDefaultPath,
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <title>{title}</title>
  <SeoHead
    lang={lang}
    title={title}
    description={description}
    pathname={Astro.url.pathname}
    image={image}
    alternateLocales={alternateLocales}
    alternateLinks={alternateLinks}
    xDefaultPath={xDefaultPath}
  />
  <ClientRouter />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen bg-cream text-charcoal">
  <MotionRuntime />
  <Header lang={lang} alternateLinks={alternateLinks} />
  <main class="relative">
    <slot />
  </main>
  <Footer lang={lang} />
  <script is:inline>
    // Netlify Identity emails link to the site root; the widget only loads in /admin.
    if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
      location.replace("/admin" + location.hash);
    }
  </script>
</body>
</html>
