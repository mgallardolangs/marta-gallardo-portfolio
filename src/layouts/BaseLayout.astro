---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const { title = `${i.hero.name} — UGC & SEO`, description = i.about.text } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  <!-- Netlify Identity widget (needed for CMS login redirects) -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <!-- Scroll progress bar -->
  <style>
    .scroll-progress {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--color-blush-300), var(--color-rose-gold));
      transform-origin: left;
      z-index: 100;
    }
    @supports (animation-timeline: scroll()) {
      .scroll-progress {
        animation: scrollProgress linear;
        animation-timeline: scroll();
      }
      @keyframes scrollProgress {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
      }
    }
  </style>
</head>
<body class="min-h-screen bg-cream text-charcoal">
  <div class="scroll-progress"></div>
  <Header lang={lang} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} />
  <!-- ponytail: redirect to /admin after Netlify Identity login confirmation -->
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      });
    }
  </script>
</body>
</html>
