---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdminToolbar from '../components/admin/AdminToolbar';
import AdminInit from '../components/admin/AdminInit';
import { getLangFromUrl, t } from '../i18n';
import es from '../i18n/es.json';
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import { siteData } from '../lib/siteData';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const { title = `Admin — ${i.hero.name}`, description = '' } = Astro.props;
const allI18n = JSON.stringify({ es, en, fr });
const allSite = JSON.stringify(siteData);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="min-h-screen bg-cream text-charcoal">
  <AdminInit client:load i18nJson={allI18n} siteJson={allSite} lang={lang} />

  <!-- Minimal admin toolbar — small floating pill, not a full bar -->
  <div class="fixed bottom-6 right-6 z-[100] print:hidden">
    <AdminToolbar client:load />
  </div>

  <!-- Site content — always visible, auth checked on publish only -->
  <Header lang={lang} adminMode={true} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} adminMode={true} />

  <script is:inline>
    // On production: check auth before allowing publish (not before viewing)
    // The site always renders — auth is only needed when clicking Publish
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', function(user) {
        if (!user) {
          window.netlifyIdentity.on('login', function() { location.reload(); });
        }
      });
    }
  </script>
</body>
</html>
