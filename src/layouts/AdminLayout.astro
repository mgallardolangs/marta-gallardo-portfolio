---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/700-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdminToolbar from '../components/admin/AdminToolbar';
import AdminInit from '../components/admin/AdminInit';
import { getLangFromUrl, t } from '../i18n';
import es from '../i18n/es.json';
import en from '../i18n/en.json';
import fr from '../i18n/fr.json';
import de from '../i18n/de.json';
import it from '../i18n/it.json';
import ca from '../i18n/ca.json';
import { siteData } from '../lib/siteData';

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const { title = `Admin — ${i.hero.name}` } = Astro.props;
const sanitizeAdminTranslations = <T extends { translationPage?: Record<string, unknown> }>(dictionary: T) => ({
  ...dictionary,
  translationPage: dictionary.translationPage
    ? {
        ...dictionary.translationPage,
        heroMark: '',
      }
    : dictionary.translationPage,
});
const allI18n = JSON.stringify({
  es: sanitizeAdminTranslations(es),
  en: sanitizeAdminTranslations(en),
  fr: sanitizeAdminTranslations(fr),
  de: sanitizeAdminTranslations(de),
  it: sanitizeAdminTranslations(it),
  ca: sanitizeAdminTranslations(ca),
});
const allSite = JSON.stringify(siteData);
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="min-h-screen bg-cream text-charcoal">
  <AdminInit client:load i18nJson={allI18n} siteJson={allSite} lang={lang} />
  <div class="fixed bottom-6 right-6 z-[100] print:hidden">
    <AdminToolbar client:load />
  </div>
  <Header lang={lang} adminMode={true} />
  <main>
    <slot />
  </main>
  <Footer lang={lang} adminMode={true} />
</body>
</html>
