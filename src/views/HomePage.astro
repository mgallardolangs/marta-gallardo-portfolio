---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ScrollReveal from '../components/ScrollReveal';
import RichText from '../components/RichText.astro';
import GsapPageRuntime from '../components/GsapPageRuntime.astro';
import HomeHeroPortrait from '../components/HomeHeroPortrait.astro';
import ClayWordmark from '../components/ClayWordmark.astro';
import TypedTitle from '../components/TypedTitle.astro';
import { getLangFromUrl, getLocalizedPath, getLocalizedRoute, t, type Lang } from '../i18n';
import { getPageSeo, siteData } from '../lib/siteData';
import { getLatestAndArchive, scopeBlogPostsToLocale } from '../lib/blog';
import { netlifyImage } from '../lib/netlifyImage';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const i = t(lang);
const pageTitle = i.home.hero.title;
const pageDescription = i.home.hero.description;
const pageSeo = getPageSeo(siteData, 'home', lang, {
  title: { [lang]: pageTitle },
  description: { [lang]: pageDescription },
});
const localizedPosts = scopeBlogPostsToLocale(await getCollection('blog'), lang);
const { latest, archive } = getLatestAndArchive(localizedPosts);
const latestPosts = latest ? [latest, ...archive].slice(0, 3) : archive.slice(0, 3);
const homeServices = [
  // Each service keeps its brand colour (DESIGN.md): SEO burgundy, translation hazel, UGC strawberry.
  { route: 'seo', title: i.home.services.items.seo, description: i.home.services.descriptions.seo, card: 'clay-card--ink', token: 'clay-token--paper', icon: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21M8 10.5h5M10.5 8v5"/>' },
  { route: 'translation', title: i.home.services.items.translation, description: i.home.services.descriptions.translation, card: 'clay-card--paper', token: 'clay-token--hazel', icon: '<path d="M4 5h9v7H8l-4 3z"/><path d="M11 12v2h5l4 3v-9h-7"/>' },
  { route: 'ugc', title: i.home.services.items.ugc, description: i.home.services.descriptions.ugc, card: 'clay-card--amaranth', token: '', icon: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 5h2M10.5 10.5v4l3.5-2z"/>' },
];
import { accentHtml } from '../lib/accentHtml';
---

<BaseLayout lang={lang} title={pageSeo.title} description={pageSeo.description}>
  <GsapPageRuntime />
  <div class="overflow-x-hidden bg-paper">
      <!-- home-hero:start -->
      <section data-home-hero class="home-hero bg-paper px-6 pt-20 pb-16 md:pt-24 md:pb-20">
        <div class="site-container home-hero__stage">
          <div class="home-hero__copy">
            <!-- CSS-only entrance: the heading is painted on first render (LCP), no React needed for the hero -->
            <div class="home-hero__intro flex flex-col gap-8 md:gap-10">
              <div class="home-hero__clip">
                <h1 class="home-hero__title" set:html={accentHtml(i.home.hero.title, i.home.hero.titleAccent) ?? i.home.hero.title} />
              </div>

              <div class="home-hero__clip">
                <RichText text={i.home.hero.description} class="home-hero__description" />
              </div>

              <div class="home-hero__clip">
                <div class="home-hero__actions">
                  <a href={getLocalizedRoute('contact', lang)} class="home-hero__cta home-hero__cta--primary">
                    <span class="home-hero__cta-label">{i.home.hero.ctaDiagnosis}</span>
                  </a>
                  <a href="#home-services" data-home-services-cta class="home-hero__cta home-hero__cta--secondary">
                    <span class="home-hero__cta-label">{i.home.hero.ctaServices}</span>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <div class="home-hero__portrait-shell">
            {/* 3D clay render + CSS tilt: fixed size (no layout shift), loads after the heading and the portrait */}
            {siteData.heroLogo3d ? (
              <p class="home-hero__logo3d" data-logo-tilt>
                <img src={siteData.heroLogo3d} alt={i.home.hero.kicker} width={720} height={136} loading="eager" fetchpriority="low" decoding="async" />
              </p>
            ) : (
              <ClayWordmark as="p" class="home-hero__logo" label={i.home.hero.kicker} />
            )}
            <HomeHeroPortrait
              fan={[
                { src: '/images/site/nicho-idiomas.webp', alt: i.home.hero.photos.languages },
                { src: '/images/site/nicho-viajes.webp', alt: i.home.hero.photos.travel },
              ]}
            >
              <img
                src={netlifyImage(siteData.heroCutoutPhoto ?? siteData.heroMainPhoto, { width: 548 })}
                alt={i.hero.name}
                width={548}
                height={1000}
                sizes="(min-width: 1024px) 300px, 55vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </HomeHeroPortrait>
          </div>
        </div>
      </section>
      <!-- home-hero:end -->

      <section data-home-authority class="bg-ink px-6 py-20 text-paper md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center lg:gap-16">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-7">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth">{i.home.about.eyebrow}</p>
            <h2 class="font-heading text-4xl leading-none text-paper md:text-6xl" set:html={accentHtml(i.home.about.title, i.home.about.titleAccent) ?? i.home.about.title} />
            <RichText text={i.home.about.description} class="max-w-2xl font-body text-lg leading-8 text-paper/80" />
            <div class="site-text-cta-row">
              <a href={getLocalizedRoute('about', lang)} class="site-text-cta">
                {i.home.about.cta}
                <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </ScrollReveal>

          <ScrollReveal client:visible direction="left">
            <!-- A passport booklet: burgundy cover on the left, data page on the right (stacks on phones) -->
            <div class="home-passport">
              <div class="home-passport__cover" aria-hidden="true">
                <span class="home-passport__cover-title">{i.home.about.passport.cover}</span>
                <span class="home-passport__emblem">MG</span>
                <span class="home-passport__cover-brand">marttelier</span>
              </div>
              <div class="home-passport__page">
                <p class="home-passport__label">{i.home.about.passport.label}</p>
                <div class="home-passport__id">
                  <img
                    src={netlifyImage(siteData.heroMainPhoto, { width: 200 })}
                    alt=""
                    width={200}
                    height={250}
                    loading="lazy"
                    decoding="async"
                    class="home-passport__photo"
                  />
                  <dl class="home-passport__fields">
                    <div><dt>{i.home.about.passport.surnameLabel}</dt><dd>{i.home.about.passport.surname}</dd></div>
                    <div><dt>{i.home.about.passport.nameLabel}</dt><dd>{i.home.about.passport.name}</dd></div>
                    <div><dt>{i.home.about.passport.professionLabel}</dt><dd>{i.home.about.passport.profession}</dd></div>
                  </dl>
                </div>
                <dl class="home-passport__rows">
                  <div>
                    <dt>{i.home.about.passport.degreeLabel}</dt>
                    <dd>{i.home.about.passport.degree}</dd>
                  </div>
                  <div>
                    <dt>{i.home.about.passport.seoLabel}</dt>
                    <dd>
                      <ul class="home-passport__list" role="list">
                        {i.home.about.passport.seoItems.map((item) => <li>{item}</li>)}
                      </ul>
                    </dd>
                  </div>
                  <div>
                    <dt>{i.home.about.languagesLabel}</dt>
                    <dd>
                      <ul class="home-passport__stamps" role="list">
                        {i.home.about.languages.map((language, index) => (
                          <li class="home-passport__stamp" style={`--tilt: ${[-8, 5, -4, 9, -6, 4][index % 6]}deg`}>{language}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                </dl>
                <p class="home-passport__mrz" aria-hidden="true">P&lt;MTLGALLARDO&lt;&lt;MARTA&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;<br />SEO&lt;TRADUCCION&lt;UGC&lt;&lt;ES&lt;EN&lt;FR&lt;&lt;&lt;&lt;</p>
              </div>
            </div>
          </ScrollReveal>
        </div>
      </section>

      <section id="home-services" class="home-services scroll-mt-24 bg-clay px-6 py-16 md:scroll-mt-28 md:py-24">
        <div class="site-container flex flex-col gap-10 md:gap-14">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-5 md:gap-6">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-hazel">{i.nav.services}</p>
            <h2 class="home-services__title font-heading text-4xl leading-none text-ink md:text-5xl xl:text-6xl" set:html={accentHtml(i.home.services.title, i.home.services.titleAccent) ?? i.home.services.title} />
          </ScrollReveal>

          <div class="home-services__grid">
            {homeServices.map((service, index) => (
              <a href={getLocalizedRoute(service.route, lang)} class:list={['clay-card home-services__card', service.card]}>
                <span class:list={['clay-token', service.token]} aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={service.icon} />
                </span>
                <h3 class="font-heading font-semibold">{service.title}</h3>
                <p class="font-body">{service.description}</p>
                <span class="home-services__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>


      <section class="bg-paper px-6 py-20 md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start lg:gap-16">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
            <div class="w-16 border-t-2 border-amaranth"></div>
            <h2 class="font-heading text-4xl leading-none text-ink md:text-6xl" set:html={accentHtml(i.home.visibility.title, i.home.visibility.titleAccent) ?? i.home.visibility.title} />
            <RichText text={i.home.visibility.text} class="max-w-2xl font-body text-lg leading-8 text-ink-muted" />
          </ScrollReveal>

          <ScrollReveal client:visible direction="left">
            <div class="flex flex-col gap-6">
            <h3 class="font-body text-xs font-semibold uppercase tracking-[0.3em] text-hazel">{i.home.visibility.stepsTitle}</h3>
            <ol class="home-steps" role="list">
              {i.home.visibility.steps.map((step, index) => (
                <li class="home-step">
                  <span class:list={['home-step__num clay-token', ['clay-token', 'clay-token--hazel', 'clay-token--amaranth'][index]]} aria-hidden="true">{index + 1}</span>
                  <div>
                    <h3 class="font-heading font-semibold text-ink">{step.title}</h3>
                    <p class="font-body">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
            <a href={getLocalizedRoute('contact', lang)} class="home-hero__cta home-hero__cta--primary home-steps__cta">
              <span class="home-hero__cta-label">{i.home.hero.ctaDiagnosis}</span>
            </a>
            </div>
          </ScrollReveal>
        </div>
      </section>

      <section class="bg-clay px-6 py-20 md:py-24">
        <div class="site-container flex flex-col gap-10 md:gap-14">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-hazel">{i.blog.eyebrow}</p>
            <TypedTitle
              as="h2"
              text={i.home.latestArticles.title}

              accent={i.home.latestArticles.titleAccent}
              trigger="visible"
              class="font-heading text-4xl leading-none text-ink md:text-6xl"
            />
          </ScrollReveal>

          {latestPosts.length > 0 && (
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {latestPosts.map((post, index) => (
                <article class="group clay-card clay-card--paper home-post-card h-full">
                  <a href={getLocalizedPath(`/blog/${post.data.slug}`, lang)} class="home-post-card__media" tabindex="-1" aria-hidden="true">
                    {post.data.image ? (
                      <img
                        src={netlifyImage(post.data.image, { width: 720 })}
                        alt={post.data.title}
                        width={720}
                        height={450}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                      />
                    ) : (
                      <div class="flex aspect-[16/10] items-center justify-center">
                        <span class="font-body text-xs font-semibold uppercase tracking-[0.28em] text-amaranth">{i.blog.latestStory}</span>
                      </div>
                    )}
                  </a>
                  <div class="home-post-card__body">
                    <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ink-muted">
                      {String(index + 1).padStart(2, '0')} · {post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                    </p>
                    <a href={getLocalizedPath(`/blog/${post.data.slug}`, lang)} class="transition hover:text-hazel">
                      <h3 class="font-heading text-2xl leading-tight text-ink md:text-3xl">{post.data.title}</h3>
                    </a>
                    <p class="flex-1 font-body text-sm leading-7 text-ink-muted">{post.data.description}</p>
                    <a href={getLocalizedPath(`/blog/${post.data.slug}`, lang)} class="blog-read-more">
                      {i.blog.readMore}
                      <span class="blog-read-more__arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    </div>
  <script>
    // Tilt the 3D logo towards the pointer: only transforms, throttled to one update per frame.
    const tilt = document.querySelector<HTMLElement>('[data-logo-tilt]');
    const hero = document.querySelector<HTMLElement>('[data-home-hero]');
    if (tilt && hero && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
      let frame = 0;
      hero.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const box = tilt.getBoundingClientRect();
          const x = (event.clientX - (box.left + box.width / 2)) / window.innerWidth;
          const y = (event.clientY - (box.top + box.height / 2)) / window.innerHeight;
          tilt.style.setProperty('--ry', `${(x * 28).toFixed(2)}deg`);
          tilt.style.setProperty('--rx', `${(-y * 22).toFixed(2)}deg`);
        });
      });
      hero.addEventListener('pointerleave', () => {
        tilt.style.setProperty('--ry', '0deg');
        tilt.style.setProperty('--rx', '0deg');
      });
    }
  </script>
</BaseLayout>
