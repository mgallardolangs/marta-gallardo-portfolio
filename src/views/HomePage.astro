---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ScrollReveal from '../components/ScrollReveal';
import RichText from '../components/RichText.astro';
import OvalMediaOrbit from '../components/OvalMediaOrbit';
import GsapPageRuntime from '../components/GsapPageRuntime.astro';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';
import HomeHeroPortrait from '../components/HomeHeroPortrait.astro';
import TypedTitle from '../components/TypedTitle.astro';
import { getLangFromUrl, getLocalizedPath, getLocalizedRoute, t, type Lang } from '../i18n';
import { getPageSeo, siteData } from '../lib/siteData';
import { getLatestAndArchive, scopeBlogPostsToLocale } from '../lib/blog';
import { netlifyImage } from '../lib/netlifyImage';

interface Props {
  lang?: Lang;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const i = t(lang);
const pageTitle = i.home.hero.title;
const pageDescription = i.home.hero.description;
const pageSeo = getPageSeo(siteData, 'home', lang, {
  title: { [lang]: pageTitle },
  description: { [lang]: pageDescription },
});
const localizedPosts = scopeBlogPostsToLocale(await getCollection('blog'), lang);
const { latest, archive } = getLatestAndArchive(localizedPosts);
const latestPosts = latest ? [latest, ...archive].slice(0, 3) : archive.slice(0, 3);
const homeServices = [
  { route: 'seo', title: i.home.services.items.seo, description: i.home.services.descriptions.seo },
  { route: 'translation', title: i.home.services.items.translation, description: i.home.services.descriptions.translation },
  { route: 'ugc', title: i.home.services.items.ugc, description: i.home.services.descriptions.ugc },
];
import { accentHtml } from '../lib/accentHtml';
---

<BaseLayout lang={lang} title={pageSeo.title} description={pageSeo.description}>
  <GsapPageRuntime />
  <div class="overflow-x-hidden bg-paper">
      <!-- home-hero:start -->
      <section data-home-hero class="home-hero bg-paper px-6 pt-20 pb-16 md:pt-24 md:pb-20">
        <div class="site-container home-hero__stage">
          <div class="home-hero__copy">
            <StaggerContainer client:visible className="flex flex-col gap-8 md:gap-10" staggerDelay={0.1}>
              <div class="home-hero__clip">
                <StaggerItem>
                  <p class="home-hero__kicker">{i.home.hero.kicker}</p>
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <TypedTitle as="h1" text={i.home.hero.title} accent={i.home.hero.titleAccent} trigger="load" class="home-hero__title" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <RichText text={i.home.hero.description} class="home-hero__description" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <div class="home-hero__actions">
                    <a href={getLocalizedRoute('contact', lang)} class="home-hero__cta home-hero__cta--primary">
                      <span class="home-hero__cta-label">{i.home.hero.ctaDiagnosis}</span>
                    </a>
                    <a href="#home-services" data-home-services-cta class="home-hero__cta home-hero__cta--secondary">
                      <span class="home-hero__cta-label">{i.home.hero.ctaServices}</span>
                    </a>
                  </div>
                </StaggerItem>
              </div>
            </StaggerContainer>
          </div>

          <ScrollReveal client:visible direction="none" className="home-hero__portrait-shell">
            <HomeHeroPortrait>
              <img
                src={netlifyImage(siteData.heroMainPhoto, { width: 1200 })}
                alt={i.hero.name}
                width={1200}
                height={1600}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </HomeHeroPortrait>
          </ScrollReveal>
        </div>
      </section>
      <!-- home-hero:end -->

      <section id="home-services" class="scroll-mt-24 bg-hazel px-6 py-16 text-paper md:scroll-mt-28 md:py-20">
        <div class="site-container space-y-10">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-5 md:gap-6">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-paper/80">{i.nav.services}</p>
            <h2 class="font-heading text-4xl leading-none text-paper md:text-6xl" set:html={accentHtml(i.home.services.title, i.home.services.titleAccent) ?? i.home.services.title} />
          </ScrollReveal>

          <div class="border-t border-paper/18">
            {homeServices.map((service, index) => (
              <a
                href={getLocalizedRoute(service.route, lang)}
                class="group flex items-start justify-between gap-5 border-b border-paper/18 py-5 md:py-7"
              >
                <div class="flex min-w-0 items-start gap-4 md:gap-6">
                  <span class="pt-1 font-body text-[0.68rem] font-semibold tracking-[0.24em] text-paper/80">{`0${index + 1}`}</span>
                  <div class="min-w-0">
                    <h3 class="font-heading text-2xl font-normal leading-tight decoration-amaranth decoration-2 underline-offset-8 group-hover:underline group-focus-visible:underline md:text-4xl">{service.title}</h3>
                    <p class="mt-2 max-w-3xl font-body text-sm leading-7 text-paper/85 md:text-base md:leading-8">{service.description}</p>
                  </div>
                </div>
                <span class="mt-1 shrink-0 font-body text-xl text-paper transition-transform group-hover:translate-x-1 group-focus-visible:translate-x-1" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section data-home-orbit class="home-orbit bg-ink px-6 py-16 text-paper md:py-24">
        <div class="site-container grid gap-8 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)_minmax(0,12rem)] lg:grid-rows-[auto_1fr_auto] lg:items-center xl:grid-cols-[minmax(0,21rem)_minmax(0,1fr)_minmax(0,14rem)]">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-5 lg:col-start-1 lg:row-start-1 lg:self-start">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth">{i.home.orbit.kicker}</p>
            <h2 class="max-w-[8ch] font-heading text-[2.8rem] leading-[0.9] tracking-[-0.08em] text-paper md:text-[4.25rem] xl:text-[5.5rem]">
              {i.home.orbit.title}
            </h2>
          </ScrollReveal>

          <ScrollReveal client:visible direction="left" className="order-3 lg:col-start-1 lg:row-start-3 lg:order-none lg:self-end">
            <p class="font-body text-[0.72rem] font-semibold uppercase tracking-[0.34em] text-white/60 md:text-xs">
              {i.home.orbit.note}
            </p>
          </ScrollReveal>

          <ScrollReveal client:visible direction="left" className="order-2 lg:col-start-3 lg:row-start-1 lg:order-none lg:justify-self-end lg:self-start">
            <p class="font-body text-[0.72rem] font-semibold uppercase tracking-[0.34em] text-white/60 md:text-xs">
              {i.home.orbit.index}
            </p>
          </ScrollReveal>

          <div class="order-4 min-w-0 w-full lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:order-none lg:translate-x-6">
            <OvalMediaOrbit client:visible items={siteData.orbitMedia} lang={lang} />
          </div>
        </div>
      </section>

      <section class="bg-paper px-6 py-20 md:py-24">
        <div class="site-container space-y-14">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
            <div class="w-16 border-t border-amaranth"></div>
            <h2 class="font-heading text-4xl leading-none text-ink md:text-6xl" set:html={accentHtml(i.home.visibility.title, i.home.visibility.titleAccent) ?? i.home.visibility.title} />
            <RichText text={i.home.visibility.text} class="max-w-3xl font-body text-lg leading-8 text-ink-muted md:text-xl" />
          </ScrollReveal>

          <ScrollReveal client:visible>
            <div class="border-t border-black/10 pt-8">
              <p class="text-accent-ink mb-4 font-body text-xs font-semibold uppercase tracking-[0.3em]">{i.home.about.languagesLabel}</p>
              <StaggerContainer client:visible className="flex flex-wrap gap-3" staggerDelay={0.08}>
                {i.home.about.languages.map((language) => (
                  <StaggerItem className="inline-flex">
                    <span class="border border-black/10 bg-paper px-4 py-2 text-sm text-ink">{language}</span>
                  </StaggerItem>
                ))}
              </StaggerContainer>
            </div>
          </ScrollReveal>
        </div>
      </section>

      <section class="bg-ink px-6 py-20 text-paper md:py-24">
        <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-7">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth">{i.home.about.eyebrow}</p>
            <h2 class="font-heading text-4xl leading-none text-paper md:text-6xl" set:html={accentHtml(i.home.about.title, i.home.about.titleAccent) ?? i.home.about.title} />
          </ScrollReveal>
          <ScrollReveal client:visible direction="left" className="flex flex-col gap-8 lg:justify-self-end">
            <RichText text={i.home.about.description} class="max-w-3xl font-body text-lg leading-8 text-white/76 md:text-xl" />
            <div class="site-text-cta-row">
              <a href={getLocalizedRoute('about', lang)} class="site-text-cta">
                {i.home.about.cta}
                <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </ScrollReveal>
        </div>
      </section>

      <section class="bg-paper px-6 py-20 md:py-24">
        <div class="site-container space-y-12">
          <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-hazel">{i.blog.eyebrow}</p>
            <TypedTitle
              as="h2"
              text={i.home.latestArticles.title}

              accent={i.home.latestArticles.titleAccent}
              trigger="visible"
              class="font-heading text-4xl leading-none text-ink md:text-6xl"
            />
          </ScrollReveal>

          {latestPosts.length > 0 && (
            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
              {latestPosts.map((post, index) => (
                <article class="group flex h-full flex-col border-t border-ink/20 pt-5">
                  <a href={getLocalizedPath(`/blog/${post.data.slug}`, lang)} class="mb-5 block overflow-hidden border border-ink/10 bg-ink/5">
                    {post.data.image ? (
                      <img
                        src={netlifyImage(post.data.image, { width: 720 })}
                        alt={post.data.title}
                        width={720}
                        height={450}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                      />
                    ) : (
                      <div class="flex aspect-[16/10] items-center justify-center">
                        <span class="font-body text-xs font-semibold uppercase tracking-[0.28em] text-amaranth">{i.blog.latestStory}</span>
                      </div>
                    )}
                  </a>
                  <div class="flex flex-1 flex-col gap-4">
                    <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ink-muted">
                      {String(index + 1).padStart(2, '0')} · {post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                    </p>
                    <a href={getLocalizedPath(`/blog/${post.data.slug}`, lang)} class="transition hover:text-hazel">
                      <h3 class="font-heading text-2xl leading-tight text-ink md:text-3xl">{post.data.title}</h3>
                    </a>
                    <p class="flex-1 font-body text-sm leading-7 text-ink-muted">{post.data.description}</p>
                    <a href={getLocalizedPath(`/blog/${post.data.slug}`, lang)} class="blog-read-more">
                      {i.blog.readMore}
                      <span class="blog-read-more__arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    </div>
</BaseLayout>
