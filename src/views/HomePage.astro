---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal';
import RichText from '../components/RichText.astro';
import OvalMediaOrbit from '../components/OvalMediaOrbit';
import ParallaxLayer from '../components/ParallaxLayer';
import FloatingIcon from '../components/FloatingIcon';
import GsapPageRuntime from '../components/GsapPageRuntime.astro';
import { ArrowWavy } from '../components/DoodleArrows';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';
import HomeHeroAbstractVisual from '../components/HomeHeroAbstractVisual.astro';
import TypedTitle from '../components/TypedTitle.astro';
import { getLangFromUrl, getLocalizedPath, t } from '../i18n';
import { siteData } from '../lib/siteData';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const instagramAlt = siteData.orbitMedia.find((item) => item.id === 'instagram-proof')?.alt[lang] ?? 'Instagram';
---

<BaseLayout title={`${i.hero.name} — ${i.home.hero.kicker}`} description={i.home.hero.description}>
  <GsapPageRuntime />
  <div class="overflow-x-hidden bg-paper">
      <section data-home-hero class="home-hero bg-paper px-6 pt-28 pb-16 md:pt-32 md:pb-20">
        <div class="site-container home-hero__stage">
          <div class="home-hero__copy">
            <StaggerContainer client:visible className="space-y-6 md:space-y-8" staggerDelay={0.1}>
              <div class="home-hero__clip">
                <StaggerItem>
                  <p class="home-hero__kicker">{i.home.hero.kicker}</p>
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <TypedTitle as="h1" text={i.hero.name} trigger="load" class="home-hero__title" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <div class="home-hero__meta">
                    <span>{i.hero.age}</span>
                    <span class="home-hero__separator">✦</span>
                    <span>{i.hero.city}</span>
                  </div>
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <RichText text={i.home.hero.description} class="home-hero__description" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <div class="home-hero__actions">
                    <a href={getLocalizedPath('/ugc', lang)} class="home-hero__cta home-hero__cta--primary">
                      <span class="home-hero__cta-label">{i.hero.ugcLabel}</span>
                    </a>
                    <a href={getLocalizedPath('/translation-seo', lang)} class="home-hero__cta home-hero__cta--secondary">
                      <span class="home-hero__cta-label">{i.hero.seoLabel}</span>
                    </a>
                  </div>
                </StaggerItem>
              </div>
            </StaggerContainer>
          </div>

          <ScrollReveal client:visible direction="none" className="home-hero__visual-shell">
            <HomeHeroAbstractVisual />
          </ScrollReveal>
        </div>
      </section>

      <section class="border-b border-black/10 bg-white px-6 py-20 md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div class="relative overflow-hidden border border-black/10 bg-paper px-4 py-8 md:px-6 md:py-10">
            <OvalMediaOrbit client:visible items={siteData.orbitMedia} lang={lang} />
          </div>

          <ScrollReveal client:visible direction="right" className="space-y-6 lg:pl-8 xl:pl-14">
            <div class="w-16 border-t border-amaranth"></div>
            <h2 class="font-heading text-4xl leading-none text-ink md:text-6xl">{i.about.title}</h2>
            {i.home.about.highlight && (
              <p class="max-w-md font-body text-xl leading-8 text-ink">{i.home.about.highlight}</p>
            )}
            <RichText text={i.about.text} class="max-w-2xl font-body text-lg leading-8 text-ink-muted md:text-xl" />
          </ScrollReveal>
        </div>

        <ScrollReveal client:visible className="site-container mt-12">
          <div class="border-t border-black/10 pt-8 text-center">
            <p class="text-accent-ink mb-4 font-body text-xs font-semibold uppercase tracking-[0.3em]">{i.home.about.languagesLabel}</p>
            <StaggerContainer client:visible className="flex flex-wrap justify-center gap-3" staggerDelay={0.08}>
              {i.home.about.languages.map((language) => (
                <StaggerItem className="inline-flex">
                  <span class="border border-black/10 bg-paper px-4 py-2 text-sm text-ink">{language}</span>
                </StaggerItem>
              ))}
            </StaggerContainer>
          </div>
        </ScrollReveal>
      </section>

      <section class="border-b border-white/10 bg-ink px-6 py-10" aria-hidden="true">
        <div class="site-container">
          <div class="relative mx-auto h-px max-w-5xl bg-white/12">
            <span class="absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 -translate-y-1/2 items-center gap-3 bg-ink px-4 font-body text-[0.68rem] font-semibold uppercase tracking-[0.34em] text-amaranth">
              <span class="h-px w-8 bg-amaranth"></span>
              MG
              <span class="h-px w-8 bg-amaranth"></span>
            </span>
          </div>
        </div>
      </section>

      <section class="bg-ink px-6 py-20 text-paper md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="relative min-h-[32rem] border border-white/10 bg-white/5 p-5 md:min-h-[38rem] md:p-8">
            <ParallaxLayer client:visible speed={-0.18} className="absolute -left-2 top-8 z-20 md:-left-8 md:top-12">
              <FloatingIcon client:visible intensity={10}>
                <div class="flex h-28 w-28 items-center justify-center border border-white/12 bg-paper text-center font-body text-xs font-semibold uppercase tracking-[0.18em] text-ink shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-36 md:w-36">
                  {i.home.gallery.shotOne}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.22} className="absolute right-0 top-0 z-20 md:right-4">
              <FloatingIcon client:visible intensity={12}>
                <div class="flex h-24 w-32 items-center justify-center border border-white/12 bg-white text-center font-body text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-ink shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-28 md:w-40">
                  {i.home.gallery.shotTwo}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={-0.12} className="absolute -bottom-4 left-6 z-20 md:bottom-8 md:left-10">
              <FloatingIcon client:visible intensity={14}>
                <div class="flex h-28 w-40 items-center justify-center border border-white/12 bg-white text-center font-body text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-ink shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-32 md:w-44">
                  {i.home.gallery.shotThree}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.18} className="absolute bottom-14 right-2 z-20 md:right-0">
              <FloatingIcon client:visible intensity={11}>
                <div class="flex h-20 w-28 items-center justify-center border border-white/12 bg-amaranth text-center font-body text-[0.6rem] font-semibold uppercase tracking-[0.24em] text-ink shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-24 md:w-36 md:text-xs">
                  {i.home.gallery.shotFour}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ScrollReveal client:visible direction="up" className="relative mx-auto flex aspect-[9/16] w-full max-w-[22rem] items-center justify-center overflow-hidden border border-white/12 bg-white/8">
              <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.12),rgba(255,255,255,0.02))]"></div>
              <div class="absolute left-1/2 top-4 h-1.5 w-24 -translate-x-1/2 rounded-full bg-white/20"></div>
              <div class="absolute inset-x-[22%] top-10 h-24 rounded-full bg-white/10 blur-3xl"></div>
              <div class="relative z-10 max-w-sm text-center">
                <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth">{i.home.video.note}</p>
                <p class="mt-5 font-heading text-4xl text-paper md:text-5xl">{i.home.video.placeholder}</p>
              </div>
              <ArrowWavy client:visible className="absolute bottom-8 right-8 hidden w-24 text-amaranth md:block" />
            </ScrollReveal>
          </div>

          <ScrollReveal client:visible direction="right" className="space-y-6">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.36em] text-amaranth">{i.home.video.eyebrow}</p>
            <h2 class="font-heading text-4xl leading-none text-paper md:text-6xl">{i.home.video.title}</h2>
            <RichText text={i.home.video.description} class="max-w-xl font-body text-lg leading-8 text-white/74 md:text-xl" />
            {siteData.instagramScreenshot ? (
              <div class="mt-6 overflow-hidden border border-white/10">
                <img
                  src={siteData.instagramScreenshot}
                  alt={instagramAlt}
                  width={1251}
                  height={495}
                  loading="lazy"
                  decoding="async"
                  class="w-full"
                />
              </div>
            ) : (
              <div class="mt-6 flex aspect-[4/3] items-center justify-center border border-dashed border-white/20 bg-white/5">
                <p class="font-body text-sm text-white/60">📱 Instagram screenshot</p>
              </div>
            )}
          </ScrollReveal>
        </div>
      </section>
    </div>
</BaseLayout>
