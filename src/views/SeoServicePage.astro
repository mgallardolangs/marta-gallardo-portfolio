---
import BaseLayout from '../layouts/BaseLayout.astro';
import GsapPageRuntime from '../components/GsapPageRuntime.astro';
import RichText from '../components/RichText.astro';
import ScrollReveal from '../components/ScrollReveal';
import ServiceSwitcher from '../components/translation/ServiceSwitcher';
import RelatedArticles from '../components/RelatedArticles.astro';
import TypedTitle from '../components/TypedTitle.astro';
import ServiceGlance from '../components/services/ServiceGlance.astro';
import ServiceSteps from '../components/services/ServiceSteps.astro';
import { accentHtml } from '../lib/accentHtml';
import { getLangFromUrl, getLocalizedRoute, t } from '../i18n';
import { getPageSeo, siteData } from '../lib/siteData';
import { getTranslationArsenalColumns } from '../lib/translationPage.js';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.seoPage;
const pageDescription = page.hero.paragraphs.join(' ');
const pageSeo = getPageSeo(siteData, 'seo', lang, {
  title: { [lang]: page.hero.title },
  description: { [lang]: pageDescription },
});
const arsenal = getTranslationArsenalColumns(lang, siteData, 'seo');
// SEO skills come from site data (editable in the admin); each has a category that groups them under a heading
const skillCategories: Record<string, string> = page.arsenal.skillCategories ?? {};
const skillGroups = [
  ...Object.entries(skillCategories).map(([key, title]) => ({ title, skills: arsenal.skills.filter((skill) => skill.category === key) })),
  { title: '', skills: arsenal.skills.filter((skill) => !skill.category || !(skill.category in skillCategories)) },
].filter((group) => group.skills.length > 0);
// Local SEO signal for Elche, the province of Alicante and the Costa Blanca (no street address: Marta works from home).
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `Marttelier · ${siteData.person.name}`,
  url: new URL(getLocalizedRoute('seo', lang), Astro.site ?? Astro.url).toString(),
  description: pageSeo.description,
  serviceType: ['SEO local', 'SEO internacional', 'Auditoría SEO', 'Consultoría SEO'],
  address: { '@type': 'PostalAddress', addressLocality: 'Elche', addressRegion: 'Alicante', addressCountry: 'ES' },
  areaServed: [
    { '@type': 'City', name: 'Elche' },
    { '@type': 'AdministrativeArea', name: 'Provincia de Alicante' },
    { '@type': 'Place', name: 'Costa Blanca' },
  ],
  availableLanguage: ['es', 'en', 'fr'],
  founder: { '@type': 'Person', name: siteData.person.name },
};
---

<BaseLayout title={pageSeo.title} description={pageSeo.description}>
  <GsapPageRuntime />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <div class="bg-paper" data-seo-service-page>
    <section data-service-hero class="px-6 pb-16 pt-28 md:pb-20 md:pt-32">
      <div class="site-container service-hero">
        <!-- Static heading (no typing effect) so it paints on first render (LCP) -->
        <div class="flex flex-col gap-8">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-hazel">{page.hero.eyebrow}</p>
          <h1 class="max-w-[16ch] font-heading text-5xl leading-[0.95] tracking-[-0.04em] text-ink md:text-7xl" set:html={accentHtml(page.hero.title, page.hero.titleAccent) ?? page.hero.title} />
          {page.hero.paragraphs.map((paragraph) => (
            <RichText text={paragraph} class="max-w-3xl font-body text-base leading-8 text-ink-muted md:text-lg" />
          ))}
        </div>
        <div class="service-hero__side">
          <ServiceGlance title={page.glanceTitle} items={page.glance} tone="ink" />
          <div class="service-hero__actions">
            <a href={getLocalizedRoute('contact', lang)} class="home-hero__cta home-hero__cta--primary">
              <span class="home-hero__cta-label">{i.home.hero.ctaDiagnosis}</span>
            </a>
            <a href="#seo-services" class="home-hero__cta home-hero__cta--secondary">
              <span class="home-hero__cta-label">{i.home.hero.ctaServices}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="seo-services" class="scroll-mt-24 bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container flex flex-col gap-10">
        <div class="space-y-5">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.services.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.services.title}

            accent={page.services.titleAccent}
            trigger="visible"
            class="font-heading text-4xl text-paper md:text-5xl"
          />
        </div>
        <div class="service-panel">
        <ServiceSwitcher
          client:load
          title={page.services.title}
          items={page.services.items.map((service) => ({
            id: service.id,
            name: service.title,
            kicker: service.kicker,
            headline: service.headline ?? service.title,
            description: service.description,
            points: service.points,
          }))}
        />
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20">
      <div class="site-container grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel">{page.international.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.international.title}

            accent={page.international.titleAccent}
            trigger="visible"
            class="font-heading text-4xl leading-none text-ink md:text-5xl"
          />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="flex flex-col gap-6">
          <RichText text={page.international.description} class="max-w-3xl font-body text-base leading-8 text-ink-muted md:text-lg" />
          <div class="site-text-cta-row">
            <a href={getLocalizedRoute('translation', lang)} class="site-text-cta">
              {page.international.translationLinkLabel}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
        <div class="seo-markets lg:col-span-2" data-seo-markets>
          <p class="seo-markets__title">{page.international.marketsTitle}</p>
          <ul class="seo-markets__grid" role="list">
            {page.international.markets.map((market, index) => (
              <li class:list={['clay-card seo-market', index === 0 ? 'clay-card--paper' : index === 1 ? 'clay-card--ink' : 'seo-market--amaranth']} lang={market.code.toLowerCase()}>
                <p class="seo-market__head"><span class="seo-market__code">{market.code}</span><span>{market.name}</span></p>
                {index > 0 ? (
                  <p class="seo-market__literal"><span>{page.international.literalLabel}</span><s>{market.literal}</s></p>
                ) : (
                  <p class="seo-market__literal"><span>{page.international.originLabel}</span></p>
                )}
                <p class="seo-market__search"><span class="seo-market__icon" aria-hidden="true"></span>{market.query}</p>
                {index > 0 && <p class="seo-market__real">✓ {page.international.realLabel}</p>}
              </li>
            ))}
          </ul>
          <p class="seo-markets__note">{page.international.marketsNote}</p>
          <ol class="seo-pillars" role="list">
            {page.international.pillars.map((pillar, index) => (
              <li class="seo-pillar">
                <span class:list={['home-step__num', ['clay-token', 'clay-token clay-token--hazel', 'clay-token clay-token--amaranth'][index % 3]]} aria-hidden="true">{index + 1}</span>
                <div>
                  <h3 class="font-heading text-lg font-semibold text-ink">{pillar.title}</h3>
                  <p class="font-body text-sm leading-6 text-ink-muted">{pillar.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="max-w-3xl space-y-5">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.why.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.why.title}

            accent={page.why.titleAccent}
            trigger="visible"
            class="font-heading text-4xl leading-none text-paper md:text-5xl"
          />
          <RichText text={page.why.stats ? page.why.description.replace(/\s*[^.!?]*:\s*$/, '') : page.why.description} class="font-body text-base leading-8 text-paper/72 md:text-lg" />
        </div>

        {page.why.stats && (
          <div class="space-y-6">
            <dl class="grid grid-cols-2 gap-3 md:grid-cols-4">
              {page.why.stats.map((stat) => (
                <div class="service-stat">
                  <dt class="service-stat__label">{stat.label}</dt>
                  <dd class="service-stat__value">{stat.value}</dd>
                </div>
              ))}
            </dl>
            <div class="flex flex-col gap-4 border-t border-paper/18 pt-6 md:flex-row md:items-center md:justify-between">
              <p class="font-body text-base leading-7 text-paper/80 md:text-lg">{page.why.ctaText}</p>
              <a href={getLocalizedRoute('contact', lang)} class="service-cta-light">
                {i.home.hero.ctaDiagnosis}
              </a>
            </div>
          </div>
        )}

        <div class="service-arsenal">
          <article class="service-arsenal__panel">
            <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.toolsTitle}</p>
            <span class="mt-4 block h-px bg-paper/18"></span>
            <div class="service-tools-grid">
              {arsenal.tools.map((tool) => (
                <div class="service-tool">
                  {tool.logoSrc ? (
                    <img src={tool.logoSrc} alt="" width="40" height="40" loading="lazy" decoding="async" class="h-10 w-10 object-contain" />
                  ) : (
                    <span class="service-tool__mono" aria-hidden="true">{tool.label.replace(/^Google\s+/, '').slice(0, 2)}</span>
                  )}
                  <p class="font-body text-[0.68rem] font-medium uppercase tracking-[0.1em]">{tool.label}</p>
                </div>
              ))}
            </div>
          </article>

          <article class="service-arsenal__panel service-arsenal__panel--skills">
            <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.skillsTitle}</p>
            <span class="mt-4 block h-px bg-paper/18"></span>
            <div class="service-skill-groups">
              {skillGroups.map((group) => (
                <div class="service-skill-group">
                  {group.title && <h3 class="service-skill-group__title">{group.title}</h3>}
                  <ul class="flex flex-wrap gap-2" role="list">
                    {group.skills.map((skill) => <li class="service-chip">{skill.label}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-clay px-6 py-16 md:py-20" data-seo-budget>
      <div class="site-container seo-closing">
        <div class="seo-closing__intro">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel">{page.budget.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.budget.title}

            accent={page.budget.titleAccent}
            trigger="visible"
            class="font-heading text-4xl leading-none text-ink md:text-5xl"
          />
          <RichText text={page.budget.description} class="font-body text-base leading-8 text-ink-muted" />
        </div>
        {page.budget.highlight && (
          <aside class="seo-budget-highlight seo-closing__offer">
            {page.budget.highlightTitle && (
              <h3 class="font-heading text-2xl leading-tight text-ink">{page.budget.highlightTitle}</h3>
            )}
            <RichText text={page.budget.highlight} class="font-body text-sm leading-7 text-ink" />
            <a href={getLocalizedRoute('contact', lang)} class="home-hero__cta home-hero__cta--primary service-final-cta">
              <span class="home-hero__cta-label">{i.home.hero.ctaDiagnosis}</span>
            </a>
          </aside>
        )}
        <div class="seo-closing__steps">
          <ServiceSteps title={i.home.visibility.stepsTitle} steps={i.home.visibility.steps} />
        </div>
      </div>
    </section>

    <RelatedArticles lang={lang} routeKey="seo" />
  </div>
</BaseLayout>
