---
import BaseLayout from '../layouts/BaseLayout.astro';
import GsapPageRuntime from '../components/GsapPageRuntime.astro';
import RichText from '../components/RichText.astro';
import ScrollReveal from '../components/ScrollReveal';
import ServiceSwitcher from '../components/translation/ServiceSwitcher';
import TypedTitle from '../components/TypedTitle.astro';
import { getLangFromUrl, getLocalizedRoute, t } from '../i18n';
import { getPageSeo, siteData } from '../lib/siteData';
import { getTranslationArsenalColumns } from '../lib/translationPage.js';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.translationServicePage;
const pageSeo = getPageSeo(siteData, 'translation', lang, {
  title: { [lang]: page.hero.title },
  description: { [lang]: page.hero.description },
});
const arsenal = getTranslationArsenalColumns(lang, siteData, 'translation');
---

<BaseLayout title={pageSeo.title} description={pageSeo.description}>
  <GsapPageRuntime />
  <div class="bg-paper" data-translation-service-page>
    <section class="px-6 pb-16 pt-28 md:pb-20 md:pt-32">
      <div class="site-container max-w-7xl">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-hazel">{page.hero.eyebrow}</p>
          <TypedTitle
            as="h1"
            text={page.hero.title}
            accent={page.hero.titleAccent}
            trigger="load"
            class="max-w-[18ch] font-heading text-5xl leading-[0.96] tracking-[-0.04em] text-ink md:text-7xl"
          />
          <RichText text={page.hero.description} class="max-w-5xl font-body text-lg leading-8 text-ink-muted" />
          <div class="site-text-cta-row">
            <a
              href={getLocalizedRoute('contact', lang)}
              data-translation-cta="contact"
              class="site-text-cta"
            >
              {i.translationPage.hero.ctaSecondary}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.localization.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.localization.title}

            accent={page.localization.titleAccent}
            trigger="visible"
            class="font-heading text-4xl text-paper md:text-5xl"
          />
        </div>
        <ServiceSwitcher
          client:load
          title={page.localization.title}
          items={page.localization.items.map((service) => ({
            id: service.id,
            name: service.title,
            headline: service.title,
            description: service.description,
          }))}
        />
      </div>
    </section>

    <section class="px-6 py-16 md:py-20">
      <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel">{page.multilingualSeo.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.multilingualSeo.title}

            accent={page.multilingualSeo.titleAccent}
            trigger="visible"
            class="font-heading text-4xl leading-none text-ink md:text-5xl"
          />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="flex flex-col gap-6">
          <RichText text={page.multilingualSeo.description} class="max-w-3xl font-body text-base leading-8 text-ink-muted md:text-lg" />
          <div class="site-text-cta-row">
            <a href={getLocalizedRoute('seo', lang)} class="site-text-cta">
              {page.multilingualSeo.seoLinkLabel}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.digitalContent.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.digitalContent.title}

            accent={page.digitalContent.titleAccent}
            trigger="visible"
            class="font-heading text-4xl text-paper md:text-5xl"
          />
        </div>
        <ServiceSwitcher
          client:load
          title={page.digitalContent.title}
          items={page.digitalContent.items.map((service) => ({
            id: service.id,
            name: service.title,
            headline: service.title,
            description: service.description,
          }))}
        />
      </div>
    </section>

    <section class="px-6 py-16 md:py-20" data-translation-arsenal>
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel">{page.arsenal.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.arsenal.title}

            accent={page.arsenal.titleAccent}
            trigger="visible"
            class="font-heading text-4xl text-ink md:text-5xl"
          />
        </div>

        <div class="grid gap-4 lg:grid-cols-3">
          <article class="border border-ink p-5" data-translation-panel="languages">
            <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-hazel">{page.arsenal.languagesTitle}</p>
            <span class="mt-4 block h-px bg-ink/12"></span>
            <div class="mt-4">
              {arsenal.languages.map((language) => (
                <div class="flex items-center justify-between gap-4 border-b border-ink/10 py-3 last:border-b-0">
                  <p class="font-heading text-xl text-ink">{language.label}</p>
                  <p class="text-right font-body text-sm font-medium text-hazel">{language.level}</p>
                </div>
              ))}
            </div>
          </article>

          <article class="border border-ink p-5" data-translation-panel="tools">
            <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-hazel">{page.arsenal.toolsTitle}</p>
            <span class="mt-4 block h-px bg-ink/12"></span>
            <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
              {arsenal.tools.map((tool) => (
                <div class="group flex aspect-square min-w-0 flex-col items-center justify-center gap-3 bg-hazel px-3 py-4 text-center text-paper transition hover:bg-amaranth hover:text-ink">
                  <img src={tool.logoSrc} alt="" width="40" height="40" loading="lazy" decoding="async" class="h-10 w-10 object-contain" />
                  <p class="font-body text-[0.68rem] font-medium uppercase tracking-[0.1em]">{tool.label}</p>
                </div>
              ))}
            </div>
          </article>

          <article class="border border-ink p-5" data-translation-panel="skills">
            <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-hazel">{page.arsenal.skillsTitle}</p>
            <span class="mt-4 block h-px bg-ink/12"></span>
            <div class="mt-4 flex flex-col gap-2">
              {arsenal.skills.map((skill) => (
                <span class="border border-ink/16 px-3 py-3 font-body text-[0.68rem] uppercase tracking-[0.08em] text-ink" data-translation-skill>
                  {skill.label}
                </span>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
