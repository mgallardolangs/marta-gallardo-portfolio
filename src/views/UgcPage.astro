---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal';
import TypedTitle from '../components/TypedTitle.astro';
import UgcContactSheet from '../components/UgcContactSheet';
import { getLangFromUrl, getLocalizedRoute, t } from '../i18n';
import { getPageSeo, siteData } from '../lib/siteData';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const pageTitle = i.ugcPage.pageTitle;
const pageDescription = i.ugcPage.pageDescription;
const pageSeo = getPageSeo(siteData, 'ugc', lang, {
  title: { [lang]: pageTitle },
  description: { [lang]: pageDescription },
});
---

<BaseLayout title={pageSeo.title} description={pageSeo.description}>
  <div class="bg-paper">
    <section data-ugc-hero class="px-6 pt-20 pb-5 md:pt-24 md:pb-6">
      <div class="site-container">
        <ScrollReveal client:visible className="w-full">
          <p class="text-xs font-semibold uppercase tracking-[0.34em] text-hazel">
            {i.ugcPage.hero.eyebrow}
          </p>
          <div class="mt-5 grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] lg:items-end">
            <TypedTitle
              as="h1"
              text={i.ugcPage.pageTitle}

              accent={i.ugcPage.pageTitleAccent}
              trigger="load"
              class="block text-4xl leading-none text-ink md:text-6xl"
            />
            <h2 class="text-balance text-lg font-semibold uppercase leading-[1.18] tracking-[0.13em] text-ink md:text-2xl lg:justify-self-end lg:text-right lg:text-3xl">
              {i.ugcPage.contactSheet.headline}
            </h2>
          </div>
        </ScrollReveal>

        <div class="mt-5 overflow-hidden" aria-hidden="true">
          <div class="ugc-hero-rule h-px bg-ink/20" />
        </div>
      </div>
    </section>

    <section class="px-6 pb-16 md:pb-20">
      <div class="site-container">
        <UgcContactSheet
          client:load
          items={siteData.ugcPortfolio}
          lang={lang}
          copy={i.ugcPage.contactSheet}
        />
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20" data-ugc-benefits>
      <div class="site-container grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{i.ugcPage.benefits.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={i.ugcPage.benefits.title}

            accent={i.ugcPage.benefits.titleAccent}
            trigger="visible"
            class="font-heading text-4xl leading-none text-paper md:text-5xl"
          />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left">
          <p class="max-w-3xl font-body text-base leading-8 text-paper/74 md:text-lg">{i.ugcPage.benefits.description}</p>
        </ScrollReveal>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20" data-ugc-process>
      <div class="site-container space-y-10">
        <div class="max-w-3xl space-y-5">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel">{i.ugcPage.process.eyebrow}</p>
          <TypedTitle
            as="h2"
            text={i.ugcPage.process.title}

            accent={i.ugcPage.process.titleAccent}
            trigger="visible"
            class="font-heading text-4xl leading-none text-ink md:text-5xl"
          />
        </div>

        <div class="relative">
          <span class="absolute left-6 top-4 block h-[calc(100%-2rem)] w-px bg-ink/20 md:hidden" aria-hidden="true"></span>
          <span class="absolute left-10 right-10 top-8 hidden h-px bg-ink/20 md:block" aria-hidden="true"></span>
          <div class="grid items-stretch gap-6 md:grid-cols-5">
            {i.ugcPage.process.steps.map((step, index) => (
              <article class="group relative flex h-full flex-col pl-16 md:pl-0" data-ugc-process-step tabindex="0">
                <span class="absolute left-0 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-ink/24 bg-paper font-body text-sm font-semibold uppercase tracking-[0.16em] text-hazel transition group-hover:-translate-y-1 group-hover:border-amaranth group-hover:bg-amaranth group-hover:text-ink group-focus-visible:-translate-y-1 group-focus-visible:border-amaranth group-focus-visible:bg-amaranth group-focus-visible:text-ink md:relative md:mx-auto">
                  0{index + 1}
                </span>
                <div class="border border-ink/18 px-5 py-6 transition group-hover:-translate-y-1 group-hover:border-amaranth/60 group-focus-visible:-translate-y-1 group-focus-visible:border-amaranth/60 md:mt-6 md:min-h-[170px] md:flex-1">
                  <h3 class="font-heading text-2xl text-ink">{step.title}</h3>
                  <p class="mt-4 text-sm leading-7 text-ink-muted">{step.description}</p>
                  {step.items && (
                    <ul class="mt-3 list-disc space-y-1 pl-4 text-sm leading-7 text-ink-muted">
                      {step.items.map((item) => <li>{item}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>

        {i.ugcPage.process.closing && (
          <div class="flex flex-col gap-5 border-t border-ink/12 pt-8 md:flex-row md:items-center md:justify-between">
            <p class="max-w-2xl font-body text-base leading-8 text-ink md:text-lg">{i.ugcPage.process.closing}</p>
            <a href={getLocalizedRoute('contact', lang)} class="site-text-cta">
              {i.footer.cta}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .ugc-hero-rule {
    transform-origin: left;
    animation: ugc-hero-rule-draw 0.7s ease-out both;
  }

  @keyframes ugc-hero-rule-draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }

    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
