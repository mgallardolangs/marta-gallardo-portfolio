---
import BaseLayout from '../layouts/BaseLayout.astro';
import RichText from '../components/RichText.astro';
import TypedTitle from '../components/TypedTitle.astro';
import GsapPageRuntime from '../components/GsapPageRuntime.astro';
import ExperienceTabs from '../components/translation/ExperienceTabs';
import ServiceSwitcher from '../components/translation/ServiceSwitcher';
import { getLangFromUrl, getLocalizedPath, t } from '../i18n';
import { siteData } from '../lib/siteData';
import { getTranslationArsenalColumns } from '../lib/translationPage.js';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.translationPage;
const arsenalColumns = getTranslationArsenalColumns(lang, siteData);

const pageTitle = `${i.hero.name} — ${i.nav.translationSeo}`;
const pageDescription = page.hero.text.replaceAll('\n', ' ').replace(/\s+/g, ' ').trim();
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <GsapPageRuntime />
  <div class="bg-paper" data-translation-page>
    <section class="relative overflow-hidden border-b border-ink px-6 pb-18 pt-28 md:pb-20 md:pt-32">
      <div class="site-container relative">
        <div class="max-w-4xl space-y-6 pr-12 md:pr-20">
          <p class="inline-flex border border-ink px-3 py-2 font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">
            {page.hero.eyebrow}
          </p>

          <TypedTitle
            as="h1"
            text={page.hero.title}
            trigger="load"
            class="max-w-[14ch] font-heading text-5xl leading-[0.92] tracking-[-0.04em] text-ink md:text-7xl"
          />

          <RichText text={page.hero.text} class="max-w-3xl text-lg leading-8 text-ink-muted" />

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href={getLocalizedPath('/ugc', lang)}
              data-translation-cta="portfolio"
              class="inline-flex items-center gap-3 border border-amaranth bg-amaranth px-5 py-3 text-xs font-semibold uppercase tracking-[0.24em] text-ink transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_0_var(--color-ink)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_4px_0_var(--color-ink)] focus-visible:outline-none"
            >
              {page.hero.ctaPrimary}
            </a>
            <a
              href={getLocalizedPath('/contact', lang)}
              data-translation-cta="contact"
              class="inline-flex items-center gap-3 border border-ink bg-paper px-5 py-3 text-xs font-semibold uppercase tracking-[0.24em] text-ink transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_0_var(--color-ink)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_4px_0_var(--color-ink)] focus-visible:outline-none"
            >
              {page.hero.ctaSecondary}
            </a>
          </div>
        </div>

        <p class="pointer-events-none absolute bottom-0 right-0 origin-bottom-right -rotate-90 font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-ink/38">
          {page.heroMark}
        </p>
      </div>
    </section>

    <section class="bg-ink px-6 py-14 text-paper md:py-18">
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.servicesEyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.services.title}
            trigger="visible"
            class="font-heading text-4xl text-paper md:text-5xl"
          />
        </div>

        <ServiceSwitcher client:load items={page.services.items} title={page.services.title} />
      </div>
    </section>

    <section class="px-6 py-14 md:py-18" data-arsenal-section>
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.arsenalEyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.arsenal.title}
            trigger="visible"
            class="font-heading text-4xl text-ink md:text-5xl"
          />
        </div>

        <div class="border border-ink">
          <div class="grid gap-0 lg:grid-cols-[0.82fr_0.88fr_1.3fr]">
            <article class="border-b border-ink p-5 lg:border-b-0 lg:border-r" data-arsenal-panel="languages">
              <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.languagesTitle}</p>
              <span class="mt-4 block h-px bg-ink/12" data-arsenal-line></span>
              <div class="mt-5" data-arsenal-items>
                {arsenalColumns.languages.map((language) => (
                  <div class="flex items-center justify-between gap-4 border-b border-ink/10 py-3 last:border-b-0" data-arsenal-item>
                    <p class="font-heading text-2xl text-ink">{language.label}</p>
                    <p class="text-sm font-medium text-amaranth">{language.level}</p>
                  </div>
                ))}
              </div>
            </article>

            <article class="border-b border-ink p-5 lg:border-b-0 lg:border-r" data-arsenal-panel="tools">
              <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.toolsTitle}</p>
              <span class="mt-4 block h-px bg-ink/12" data-arsenal-line></span>
              <div class="mt-5 grid grid-cols-3 gap-2" data-arsenal-items>
                {arsenalColumns.tools.map((tool) => (
                  <div class="group flex aspect-square flex-col items-center justify-center gap-3 bg-ink px-3 py-4 text-center text-paper transition hover:bg-amaranth hover:text-ink" data-arsenal-item>
                    <div class="flex h-10 w-10 items-center justify-center">
                      <img src={tool.logoSrc} alt="" width="24" height="24" loading="lazy" decoding="async" class="h-6 max-h-[24px] w-6 max-w-[24px] object-contain" />
                    </div>
                    <p class="text-[0.68rem] font-medium uppercase tracking-[0.12em] text-paper transition group-hover:text-ink">{tool.label}</p>
                  </div>
                ))}
              </div>
            </article>

            <article class="p-5" data-arsenal-panel="skills">
              <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.skillsTitle}</p>
              <span class="mt-4 block h-px bg-ink/12" data-arsenal-line></span>
              <div class="mt-5 grid gap-6 md:grid-cols-2" data-arsenal-items>
                <div class="space-y-3">
                  <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ink-muted">{page.skillGroups.translation}</p>
                  <div class="flex flex-col gap-2">
                    {arsenalColumns.skillGroups.translation.map((skill) => (
                      <span class="border border-ink/12 px-3 py-2 text-[0.68rem] uppercase tracking-[0.08em] text-ink" data-arsenal-item>{skill.label}</span>
                    ))}
                  </div>
                </div>
                <div class="space-y-3">
                  <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ink-muted">{page.skillGroups.seo}</p>
                  <div class="flex flex-col gap-2">
                    {arsenalColumns.skillGroups.seo.map((skill) => (
                      <span class="border border-ink/12 px-3 py-2 text-[0.68rem] uppercase tracking-[0.08em] text-ink" data-arsenal-item>{skill.label}</span>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18">
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.experienceEyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.experienceSectionTitle}
            trigger="visible"
            class="font-heading text-4xl text-ink md:text-5xl"
          />
        </div>

        <ExperienceTabs
          client:load
          tabListAriaLabel={page.browserTabsAriaLabel}
          profileLabel={page.browserTabs.profileLabel}
          statement={page.experienceStatement ?? page.experienceSectionTitle}
          tabs={{
            education: {
              label: page.browserTabs.education,
              intro: page.education.intro,
              studies: page.education.studies,
            },
            experience: {
              label: page.browserTabs.experience,
              intro: page.experience.intro,
              cards: page.experience.cards,
            },
          }}
        />
      </div>
    </section>

    <section class="bg-ink px-6 py-14 text-paper md:py-18" data-methodology-section>
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.methodologyEyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.methodologyDisplayTitle}
            trigger="visible"
            class="max-w-4xl font-heading text-4xl text-paper md:text-5xl"
          />
        </div>

        <div class="relative">
          <span class="absolute left-6 top-4 block h-[calc(100%-2rem)] w-px bg-paper/18 md:hidden" data-methodology-connector></span>
          <span class="absolute left-10 right-10 top-8 hidden h-px bg-paper/18 md:block" data-methodology-connector></span>

          <div class="grid gap-6 md:grid-cols-4">
            {page.methodology.steps.map((step, index) => (
              <article class="group relative pl-16 md:pl-0" data-methodology-step tabindex="0">
                <div class="absolute left-0 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-paper/24 font-body text-sm font-semibold uppercase tracking-[0.16em] text-amaranth transition group-hover:-translate-y-1 group-hover:border-amaranth group-hover:bg-amaranth group-hover:text-ink group-focus-visible:-translate-y-1 group-focus-visible:border-amaranth group-focus-visible:bg-amaranth group-focus-visible:text-ink md:relative md:mx-auto">
                  0{index + 1}
                </div>
                <div class="border border-paper/18 px-5 py-6 transition group-hover:-translate-y-1 group-hover:border-amaranth/60 group-focus-visible:-translate-y-1 group-focus-visible:border-amaranth/60 md:mt-6">
                  <h3 class="font-heading text-2xl text-paper">{step.title}</h3>
                  <p class="mt-4 text-sm leading-7 text-paper/72">{step.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18" data-why-section>
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth">{page.whyEyebrow}</p>
          <TypedTitle
            as="h2"
            text={page.whyChooseMe.title}
            trigger="visible"
            class="max-w-3xl font-heading text-4xl text-ink md:text-5xl"
          />
        </div>

        <div class="grid gap-0 border border-ink md:grid-cols-3 md:divide-x md:divide-ink">
          {page.whyChooseMe.cards.map((card, index) => (
            <article class="group relative overflow-hidden border-b border-ink last:border-b-0 md:border-b-0" data-why-card tabindex="0">
              <span class="absolute inset-x-0 bottom-0 h-full origin-bottom scale-y-0 bg-ink transition duration-300 group-hover:scale-y-100 group-focus-visible:scale-y-100"></span>
              <div class="relative space-y-5 px-5 py-6 transition duration-300 group-hover:text-paper group-focus-visible:text-paper">
                <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-amaranth">{`[ 0${index + 1} ]`}</p>
                <h3 class="font-heading text-3xl text-ink transition duration-300 group-hover:text-paper group-focus-visible:text-paper">{card.title}</h3>
                <p class="text-sm leading-7 text-ink-muted transition duration-300 group-hover:text-paper/76 group-focus-visible:text-paper/76">{card.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    import { cleanupTranslationPageMotion, initTranslationPageMotion } from '../lib/translationPageMotion.ts';

    const mountTranslationPage = () => {
      void initTranslationPageMotion();
    };
    const cleanupTranslationPage = () => {
      cleanupTranslationPageMotion();
    };
    const pageLoadHandlerKey = '__mgInitTranslationPage';
    const beforePreparationHandlerKey = '__mgCleanupTranslationPage';
    const docWithHandler = document as Document & Record<string, (() => void) | undefined>;

    docWithHandler[pageLoadHandlerKey] && document.removeEventListener('astro:page-load', docWithHandler[pageLoadHandlerKey]);
    docWithHandler[beforePreparationHandlerKey]
      && document.removeEventListener('astro:before-preparation', docWithHandler[beforePreparationHandlerKey]);
    docWithHandler[pageLoadHandlerKey] = mountTranslationPage;
    docWithHandler[beforePreparationHandlerKey] = cleanupTranslationPage;

    mountTranslationPage();
    document.addEventListener('astro:page-load', mountTranslationPage);
    document.addEventListener('astro:before-preparation', cleanupTranslationPage);
  </script>
</BaseLayout>
