---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, getLocalizedPath, t } from '../i18n';
import { scopeBlogPostsToLocale } from '../lib/blog';
import ScrollReveal from '../components/ScrollReveal';
import TypedTitle from '../components/TypedTitle.astro';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);

const posts = scopeBlogPostsToLocale(await getCollection('blog'), lang)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`${i.blog.title} — ${i.hero.name}`}>
  <section class="border-b border-black/10 bg-paper px-6 pt-28 pb-12 md:pt-32 md:pb-16">
      <div class="site-container max-w-6xl">
        <ScrollReveal client:visible>
          <div class="max-w-4xl">
            <div class="inline-flex items-center gap-4 border-y border-black/12 py-3">
              <p class="text-accent-ink font-body text-xs font-semibold uppercase tracking-[0.34em]">{i.blog.title}</p>
            </div>
            <TypedTitle
              as="h1"
              text={i.blog.title}
              trigger="load"
              class="mt-6 font-heading text-5xl leading-none text-ink md:text-7xl"
            />
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-white px-6 py-10 md:py-14">
      <div class="site-container max-w-6xl">
        {posts.length === 0 ? (
          <p class="border-y border-black/10 py-8 font-body text-lg text-ink-muted">{i.blog.emptyState}</p>
        ) : (
          <div class="border-t border-black/10">
            {posts.map((post, index) => (
              <article class={`grid gap-8 border-b border-black/10 py-8 md:grid-cols-[1.1fr_0.9fr] md:items-start md:py-10 ${index === 0 ? 'pt-10' : ''}`}>
                <div class="space-y-5">
                  <div class="flex flex-wrap items-center gap-3 text-sm text-ink-muted">
                    <time class="font-body uppercase tracking-[0.18em]">
                      {post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    {post.data.tags.map((tag) => (
                      <span class="text-accent-ink border border-black/10 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.24em]">{tag}</span>
                    ))}
                  </div>

                  <div class="space-y-3">
                    <h2 class="font-heading text-3xl leading-tight text-ink md:text-5xl">{post.data.title}</h2>
                    <p class="max-w-2xl font-body text-base leading-8 text-ink-muted md:text-lg">{post.data.description}</p>
                  </div>

                  <a
                    href={getLocalizedPath(`/blog/${post.id}`, lang)}
                    class="text-accent-ink inline-flex items-center gap-3 border-b border-amaranth pb-1 font-body text-xs font-semibold uppercase tracking-[0.28em] transition hover:text-ink"
                  >
                    {i.blog.readMore}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>

                <a href={getLocalizedPath(`/blog/${post.id}`, lang)} class="group block self-start border border-black/10 bg-paper">
                  {post.data.image ? (
                    <img src={post.data.image} alt={post.data.title} width={1600} height={1200} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition duration-300 group-hover:scale-[1.02]" />
                  ) : (
                    <div class="text-accent-ink flex aspect-[4/3] items-center justify-center bg-blush-50">✦</div>
                  )}
                </a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
</BaseLayout>
