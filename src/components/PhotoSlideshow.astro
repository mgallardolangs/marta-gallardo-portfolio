---
interface Props {
  photos: string[];
  class?: string;
  interval?: number;
}

const {
  photos = [],
  class: className = '',
  interval = 4000,
} = Astro.props;

const slideshowPhotos = photos.filter(Boolean);
---

<div
  class={`photo-slideshow relative overflow-hidden rounded-[2rem] bg-paper shadow-[0_30px_80px_rgb(232_50_86_/_0.15)] ${className}`}
  data-interval={String(interval)}
>
  {slideshowPhotos.length > 0 ? (
    slideshowPhotos.map((src, idx) => (
      <img
        src={src}
        alt=""
        class={`slideshow-img absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
        loading="lazy"
      />
    ))
  ) : (
    <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-paper via-white to-paper p-8">
      <div class="relative flex h-full w-full items-center justify-center">
        <div class="absolute left-[12%] top-[16%] flex h-[58%] w-[40%] rotate-[-8deg] items-center justify-center rounded-[2rem] border border-black/10 bg-paper/45 shadow-[0_18px_40px_rgb(232_50_86_/_0.14)] backdrop-blur-sm">
          <span class="text-4xl opacity-45">📸</span>
        </div>
        <div class="absolute right-[12%] bottom-[16%] flex h-[58%] w-[40%] rotate-[8deg] items-center justify-center rounded-[2rem] border border-black/10 bg-paper/60 shadow-[0_18px_40px_rgb(232_50_86_/_0.18)] backdrop-blur-sm">
          <span class="text-4xl opacity-55">📸</span>
        </div>
      </div>
    </div>
  )}
</div>

<script>
  const initPhotoSlideshows = () => {
    document.querySelectorAll('.photo-slideshow').forEach((container) => {
      if (!(container instanceof HTMLElement) || container.dataset.initialized === 'true') return;

      const images = Array.from(container.querySelectorAll('.slideshow-img'));
      if (images.length <= 1) {
        container.dataset.initialized = 'true';
        return;
      }

      const interval = Number.parseInt(container.dataset.interval || '4000', 10);
      let current = 0;

      window.setInterval(() => {
        images[current]?.classList.replace('opacity-100', 'opacity-0');
        current = (current + 1) % images.length;
        images[current]?.classList.replace('opacity-0', 'opacity-100');
      }, interval);

      container.dataset.initialized = 'true';
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPhotoSlideshows, { once: true });
  } else {
    initPhotoSlideshows();
  }

  document.addEventListener('astro:page-load', initPhotoSlideshows);
</script>
