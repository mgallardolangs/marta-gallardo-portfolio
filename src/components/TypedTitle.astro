---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  text: string;
  trigger?: 'load' | 'visible';
  class?: string;
}

const { as = 'h1', text, trigger = 'load', class: className = '' } = Astro.props;
const Tag = as;
---

<Tag class={className} data-typed-title data-typed-trigger={trigger} data-typed-text={text}>
  <span class="sr-only">{text}</span>
  <span class="typed-title" aria-hidden="true">
    <span class="typed-title__reserve">{text}</span>
    <span class="typed-title__visual" data-typed-title-visual>{text}</span>
    <span class="typed-title__cursor-space"></span>
  </span>
</Tag>

<style>
  .typed-title {
    display: inline-grid;
    grid-template-columns: minmax(0, max-content) 0.46em;
    align-items: start;
  }

  .typed-title__reserve,
  .typed-title__visual {
    grid-area: 1 / 1;
    white-space: pre-wrap;
  }

  .typed-title__reserve {
    visibility: hidden;
    pointer-events: none;
  }

  .typed-title__visual {
    min-width: 1ch;
  }

  .typed-title__cursor-space {
    grid-area: 1 / 2;
    width: 0.46em;
    visibility: hidden;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .typed-title__visual {
      min-width: 0;
    }
  }
</style>

<script>
  import Typed from 'typed.js';

  declare global {
    interface Window {
      __mgTypedTitleBound?: boolean;
      __mgTypedTitleState?: {
        controllers: Map<HTMLElement, { typed?: Typed; observer?: IntersectionObserver }>;
      };
    }
  }

  const ROOT_SELECTOR = '[data-typed-title]';
  const VISUAL_SELECTOR = '[data-typed-title-visual]';
  const COMPLETE_ATTR = 'data-typed-title-complete';
  const typedState = window.__mgTypedTitleState ??= { controllers: new Map() };

  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  const destroyController = (root: HTMLElement) => {
    const controller = typedState.controllers.get(root);
    controller?.observer?.disconnect();
    controller?.typed?.destroy();
    typedState.controllers.delete(root);

    const text = root.dataset.typedText ?? '';
    const visual = root.querySelector<HTMLElement>(VISUAL_SELECTOR);
    if (visual) {
      visual.textContent = text;
    }
    delete root.dataset.typedTitleComplete;
  };

  const finishStatic = (root: HTMLElement) => {
    const visual = root.querySelector<HTMLElement>(VISUAL_SELECTOR);
    if (visual) {
      visual.textContent = root.dataset.typedText ?? '';
    }
    root.dataset.typedTitleComplete = 'true';
  };

  const startTyped = (root: HTMLElement) => {
    const existing = typedState.controllers.get(root);

    if (existing?.typed || root.dataset.typedTitleComplete === 'true') {
      return;
    }

    const visual = root.querySelector<HTMLElement>(VISUAL_SELECTOR);
    const text = root.dataset.typedText ?? '';
    const trigger = root.dataset.typedTrigger === 'visible' ? 'visible' : 'load';

    if (!visual || !text) {
      root.dataset.typedTitleComplete = 'true';
      return;
    }

    visual.textContent = '';

    const typed = new Typed(visual, {
      strings: [text],
      contentType: 'null',
      typeSpeed: trigger === 'visible' ? 32 : 42,
      startDelay: trigger === 'visible' ? 0 : 160,
      autoInsertCss: false,
      showCursor: true,
      cursorChar: '_',
      loop: false,
      smartBackspace: false,
      backSpeed: 0,
      backDelay: 0,
      onComplete: () => {
        root.dataset.typedTitleComplete = 'true';
      },
    });

    typedState.controllers.set(root, { ...existing, typed });
  };

  const initRoot = (root: HTMLElement) => {
    if (typedState.controllers.has(root) || root.dataset.typedTitleComplete === 'true') {
      return;
    }

    if (mediaQuery.matches) {
      finishStatic(root);
      return;
    }

    const trigger = root.dataset.typedTrigger === 'visible' ? 'visible' : 'load';

    if (trigger === 'visible') {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) {
              return;
            }

            observer.disconnect();
            startTyped(root);
          });
        },
        { threshold: 0.35 },
      );

      typedState.controllers.set(root, { observer });
      observer.observe(root);
      return;
    }

    startTyped(root);
  };

  const initAll = () => {
    document.querySelectorAll<HTMLElement>(ROOT_SELECTOR).forEach((root) => {
      initRoot(root);
    });
  };

  const destroyAll = () => {
    Array.from(typedState.controllers.keys()).forEach((root) => {
      destroyController(root);
    });
  };

  if (!window.__mgTypedTitleBound) {
    window.__mgTypedTitleBound = true;
    document.addEventListener('astro:before-preparation', destroyAll);
    document.addEventListener('astro:page-load', initAll);
    mediaQuery.addEventListener?.('change', () => {
      destroyAll();
      initAll();
    });
  }

  initAll();
</script>
