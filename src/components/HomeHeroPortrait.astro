---
import { netlifyImage } from '../lib/netlifyImage';

interface FanPhoto {
  src: string;
  alt: string;
}

interface Props {
  class?: string;
  /** Two photos fanned out behind the portrait: [left, right]. */
  fan?: [FanPhoto, FanPhoto];
}

const { class: className = '', fan } = Astro.props;
---

<div class={`home-hero__portrait ${className}`.trim()} data-home-hero-portrait>
  {fan && fan.map((photo, index) => (
    <figure class:list={['home-hero__fan', index === 0 ? 'home-hero__fan--left' : 'home-hero__fan--right']}>
      <img
        src={netlifyImage(photo.src, { width: 480 })}
        alt={photo.alt}
        width={480}
        height={640}
        loading="eager"
        fetchpriority="low"
        decoding="async"
      />
    </figure>
  ))}
  <div class="home-hero__portrait-media" data-home-hero-portrait-media>
    <slot />
  </div>
</div>
