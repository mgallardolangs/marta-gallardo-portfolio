---
// RichText — renders \n as paragraph breaks and **text** as <strong>
// Handles both literal \n and escaped \\n from JSON files
interface Props {
  text: string;
  class?: string;
}

const { text, class: className = '' } = Astro.props;

function parseBold(segment: string): string {
  return segment.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}

// Split on literal \n (from JSON \\n) or actual newlines
const parts = text.split(/\\n|\n/).map(s => s.trim()).filter(Boolean);
---
<div class={className}>
  {parts.map((part, idx) => (
    <p set:html={parseBold(part)} class={idx > 0 ? 'mt-3' : ''} />
  ))}
</div>
