---
import { t, getLangFromUrl, getLocalizedPath, langNames, type Lang } from '../i18n';
import siteData from '../data/images.json';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
const allLangs = Object.keys(langNames) as Lang[];
const social = siteData.socialLinks || { linkedin: 'https://linkedin.com', instagram: 'https://instagram.com' };

// ponytail: derive active page from URL pathname
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const strippedPath = pathname.replace(`/${lang}`, '') || '/';

function isActive(path: string): boolean {
  if (path === '/') return strippedPath === '/' || strippedPath === '';
  return strippedPath.startsWith(path);
}

const navClass = (path: string) =>
  `transition-colors hover:text-rose-gold ${isActive(path) ? 'text-rose-gold font-medium border-b-2 border-rose-gold pb-0.5' : ''}`;
---
<header class="fixed top-0 left-0 right-0 z-50 bg-cream/80 backdrop-blur-md border-b border-blush-100">
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <!-- Logo / Name -->
    <a href={getLocalizedPath('/', lang)} class="font-heading text-2xl font-semibold tracking-wide text-charcoal hover:text-rose-gold transition-colors">
      MG
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8 font-body text-sm tracking-wide">
      <li><a href={getLocalizedPath('/', lang)} class={navClass('/')}>{i.nav.home}</a></li>
      <li><a href={getLocalizedPath('/ugc', lang)} class={navClass('/ugc')}>{i.nav.ugc}</a></li>
      <li><a href={getLocalizedPath('/translation-seo', lang)} class={navClass('/translation-seo')}>{i.nav.translationSeo}</a></li>
      <li><a href={getLocalizedPath('/blog', lang)} class={navClass('/blog')}>{i.nav.blog}</a></li>
      <li><a href={getLocalizedPath('/contact', lang)} class={navClass('/contact')}>{i.nav.contact}</a></li>
    </ul>

    <!-- Right side: social + lang switcher -->
    <div class="flex items-center gap-4">
      <!-- LinkedIn -->
      <a href={social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="text-charcoal hover:text-rose-gold transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <!-- Instagram -->
      <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="text-charcoal hover:text-rose-gold transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
      </a>
      <!-- Language switcher -->
      <div class="relative group">
        <button class="text-sm font-body tracking-wide text-charcoal hover:text-rose-gold transition-colors flex items-center gap-1" aria-label={i.language.label}>
          {langNames[lang]}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="absolute right-0 top-full mt-2 bg-white shadow-lg rounded-lg py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 min-w-[100px]">
          {allLangs.map(l => (
            <a href={getLocalizedPath(Astro.url.pathname.replace(`/${lang}`, '') || '/', l)}
               class={`block px-4 py-1.5 text-sm hover:bg-blush-50 transition-colors ${l === lang ? 'text-rose-gold font-medium' : 'text-charcoal'}`}>
              {langNames[l]}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden text-charcoal" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream border-t border-blush-100 px-6 py-4">
    <ul class="flex flex-col gap-4 font-body text-sm">
      <li><a href={getLocalizedPath('/', lang)} class={`block ${navClass('/')}`}>{i.nav.home}</a></li>
      <li><a href={getLocalizedPath('/ugc', lang)} class={`block ${navClass('/ugc')}`}>{i.nav.ugc}</a></li>
      <li><a href={getLocalizedPath('/translation-seo', lang)} class={`block ${navClass('/translation-seo')}`}>{i.nav.translationSeo}</a></li>
      <li><a href={getLocalizedPath('/blog', lang)} class={`block ${navClass('/blog')}`}>{i.nav.blog}</a></li>
      <li><a href={getLocalizedPath('/contact', lang)} class={`block ${navClass('/contact')}`}>{i.nav.contact}</a></li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
