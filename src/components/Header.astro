---
import { getLocalizedPath, langNames, stripLocaleFromPath, t, visibleLangs, type Lang } from '../i18n';
import { siteData } from '../lib/siteData';

interface Props {
  lang: Lang;
  adminMode?: boolean;
}

const { lang, adminMode = false } = Astro.props;
const i = t(lang);
const pathname = Astro.url.pathname;
const publicPath = stripLocaleFromPath(pathname).replace(/^\/admin(?=\/|$)/, '') || '/';
const strippedPath = publicPath === '/' ? '/' : publicPath.replace(/\/$/, '');
const navPath = (path: string) => (adminMode ? `/admin${path === '/' ? '' : path}` : getLocalizedPath(path, lang));
const languagePath = (nextLang: Lang) => getLocalizedPath(strippedPath === '' ? '/' : strippedPath, nextLang);

const navItems = [
  { href: '/', label: i.nav.home },
  { href: '/ugc', label: i.nav.ugc },
  { href: '/translation-seo', label: i.nav.translationSeo },
  { href: '/blog', label: i.nav.blog },
  { href: '/contact', label: i.nav.contact },
];

const isActive = (path: string) => {
  if (path === '/') return strippedPath === '/' || strippedPath === '';
  return strippedPath === path || strippedPath.startsWith(`${path}/`);
};
---
<header
  class="site-header fixed inset-x-0 top-0 z-50 px-4 py-4 md:px-6"
  data-header-root
  data-compact="false"
  data-hidden="false"
  data-admin={adminMode ? 'true' : 'false'}
>
  <div class="site-header__shell mx-auto flex w-full max-w-7xl items-center justify-between rounded-full border border-black/8 bg-cream/92 px-4 py-3 text-charcoal backdrop-blur md:px-6">
    <a href={navPath('/')} class="site-header__brand inline-flex items-center gap-2 text-base font-semibold tracking-[0.36em] text-charcoal transition hover:text-rose-gold">
      <span class="font-heading text-lg">MG</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <nav aria-label="Primary" class="flex items-center gap-5">
        {navItems.map((item) => (
          <a
            href={navPath(item.href)}
            class="nav-link group"
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
            <span class="nav-link__text">
              <span>{item.label}</span>
              <span aria-hidden="true">{item.label}</span>
            </span>
            <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href={siteData.socialLinks.linkedin} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" class="social-control">
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M20.45 20.45H16.9v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77A1.75 1.75 0 0 0 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45A1.76 1.76 0 0 0 24 22.27V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        <a href={siteData.socialLinks.instagram} target="_blank" rel="noreferrer noopener" aria-label="Instagram" class="social-control">
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M12 0C8.74 0 8.33.01 7.05.07 2.69.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07 3.26 0 3.67-.01 4.95-.07 4.36-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95 0-3.26-.01-3.67-.07-4.95-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.69-4.92-4.92A69.57 69.57 0 0 1 2.16 12c0-3.2.01-3.58.07-4.85.15-3.23 1.67-4.77 4.92-4.92A69.56 69.56 0 0 1 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
        </a>
        {!adminMode && (
          <button
            type="button"
            class="social-control"
            aria-label={i.language.label}
            aria-haspopup="menu"
            aria-expanded="false"
            data-lang-toggle
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
              <path d="M12 3c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9Zm0 0c2.27 2.46 3.5 5.71 3.5 9S14.27 18.54 12 21m0-18C9.73 5.46 8.5 8.71 8.5 12s1.23 6.54 3.5 9m-8.36-6h16.72M3.64 9h16.72" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
            </svg>
          </button>
        )}
      </div>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      {!adminMode && (
        <button
          type="button"
          class="social-control"
          aria-label={i.language.label}
          aria-haspopup="menu"
          aria-expanded="false"
          data-lang-toggle
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
            <path d="M12 3c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9Zm0 0c2.27 2.46 3.5 5.71 3.5 9S14.27 18.54 12 21m0-18C9.73 5.46 8.5 8.71 8.5 12s1.23 6.54 3.5 9m-8.36-6h16.72M3.64 9h16.72" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
          </svg>
        </button>
      )}
      <button type="button" class="social-control" data-menu-toggle aria-expanded="false" aria-label={i.nav.openMenu}>
        <span class="sr-only">{i.nav.openMenu}</span>
        <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
          <path d="M5 7h14M5 12h14M5 17h14" stroke-linecap="round" stroke-width="1.8" />
        </svg>
      </button>
    </div>
  </div>

  {!adminMode && (
    <div class="language-popover-wrap mx-auto w-full max-w-7xl px-4 md:px-6">
      <div class="relative flex justify-end">
        <div class="language-menu" data-lang-menu hidden role="menu" aria-label={i.language.label}>
          {visibleLangs.map((locale) => (
            <a
              href={languagePath(locale)}
              class:list={['language-menu__link', locale === lang && 'is-active']}
              role="menuitem"
            >
              {langNames[locale]}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="mobile-panel" data-mobile-panel hidden>
    <div class="mobile-panel__content">
      <div class="flex items-center justify-between border-b border-black/8 pb-4">
        <span class="font-heading text-xl tracking-[0.28em]">MG</span>
        <button type="button" class="social-control" data-menu-close aria-label={i.nav.closeMenu}>
          <span class="sr-only">{i.nav.closeMenu}</span>
          <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" stroke-width="1.8" />
          </svg>
        </button>
      </div>

      <nav aria-label="Mobile" class="mt-8 flex flex-col gap-5">
        {navItems.map((item) => (
          <a href={navPath(item.href)} class="mobile-nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
            <span class="mobile-nav-link__line">
              <span>{item.label}</span>
              <span aria-hidden="true">{item.label}</span>
            </span>
          </a>
        ))}
      </nav>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href={siteData.socialLinks.linkedin} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" class="social-control">
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M20.45 20.45H16.9v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77A1.75 1.75 0 0 0 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45A1.76 1.76 0 0 0 24 22.27V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        <a href={siteData.socialLinks.instagram} target="_blank" rel="noreferrer noopener" aria-label="Instagram" class="social-control">
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M12 0C8.74 0 8.33.01 7.05.07 2.69.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07 3.26 0 3.67-.01 4.95-.07 4.36-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95 0-3.26-.01-3.67-.07-4.95-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.69-4.92-4.92A69.57 69.57 0 0 1 2.16 12c0-3.2.01-3.58.07-4.85.15-3.23 1.67-4.77 4.92-4.92A69.56 69.56 0 0 1 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
        </a>
      </div>

      {!adminMode && (
        <div class="mt-10 flex items-center gap-3">
          {visibleLangs.map((locale) => (
            <a href={languagePath(locale)} class:list={['language-chip', locale === lang && 'is-active']}>
              {langNames[locale]}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .site-header {
    transition: transform 0.35s ease, padding 0.35s ease;
  }

  .site-header[data-hidden='true'] {
    transform: translateY(calc(-100% - 0.75rem));
  }

  .site-header[data-compact='true'] {
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }

  .site-header[data-compact='true'] .site-header__shell {
    border-radius: 1.25rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    box-shadow: 0 14px 40px rgba(6, 4, 3, 0.08);
  }

  .site-header__shell {
    transition: border-radius 0.3s ease, padding 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 8px 30px rgba(6, 4, 3, 0.05);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    overflow: hidden;
    padding: 0.15rem 0;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .nav-link__text {
    display: grid;
    height: 1.05rem;
    overflow: hidden;
    color: rgba(6, 4, 3, 0.8);
    transition: color 0.2s ease;
  }

  .nav-link__text > span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 1.05rem;
    transform: translateY(0);
    transition: transform 0.24s ease;
  }

  .nav-link__bracket {
    color: var(--color-amaranth);
    font-size: 0.9rem;
    opacity: 0;
    transform: translateY(0.3rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-link:hover .nav-link__text,
  .nav-link:focus-visible .nav-link__text,
  .nav-link[aria-current='page'] .nav-link__text {
    color: var(--color-amaranth);
  }

  .nav-link:hover .nav-link__text > span,
  .nav-link:focus-visible .nav-link__text > span,
  .nav-link[aria-current='page'] .nav-link__text > span {
    transform: translateY(-100%);
  }

  .nav-link:hover .nav-link__bracket,
  .nav-link:focus-visible .nav-link__bracket,
  .nav-link[aria-current='page'] .nav-link__bracket {
    opacity: 1;
    transform: translateY(0);
  }

  .social-control {
    display: inline-flex;
    height: 2.6rem;
    width: 2.6rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(6, 4, 3, 0.08);
    background: rgba(255, 255, 255, 0.7);
    color: var(--color-ink);
    box-shadow: 0 6px 0 rgba(232, 50, 86, 0.22);
    transition: transform 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .social-control:hover,
  .social-control:focus-visible {
    transform: translateY(-3px);
    color: var(--color-amaranth);
    border-color: rgba(232, 50, 86, 0.24);
    box-shadow: 0 10px 0 rgba(232, 50, 86, 0.28);
  }

  .language-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.8rem);
    min-width: 5rem;
    border-radius: 1rem;
    border: 1px solid rgba(6, 4, 3, 0.08);
    background: rgba(244, 245, 241, 0.98);
    padding: 0.4rem;
    box-shadow: 0 20px 50px rgba(6, 4, 3, 0.1);
  }

  .language-menu__link,
  .language-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.6rem 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .language-menu__link {
    width: 100%;
  }

  .language-menu__link:hover,
  .language-menu__link:focus-visible,
  .language-menu__link.is-active,
  .language-chip:hover,
  .language-chip:focus-visible,
  .language-chip.is-active {
    background: rgba(232, 50, 86, 0.1);
    color: var(--color-amaranth);
  }

  .mobile-panel {
    position: fixed;
    inset: 0;
    z-index: 48;
    background: rgba(244, 245, 241, 0.96);
    backdrop-filter: blur(18px);
  }

  .mobile-panel__content {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 1.25rem 1.1rem 2rem;
  }

  .mobile-nav-link {
    overflow: hidden;
    border-bottom: 1px solid rgba(6, 4, 3, 0.08);
    padding-bottom: 0.9rem;
    font-size: clamp(1.8rem, 8vw, 2.6rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .mobile-nav-link__line {
    display: grid;
    overflow: hidden;
    color: rgba(6, 4, 3, 0.88);
  }

  .mobile-nav-link__line > span {
    min-height: 1.15em;
    transition: transform 0.24s ease;
  }

  .mobile-nav-link:hover .mobile-nav-link__line > span,
  .mobile-nav-link:focus-visible .mobile-nav-link__line > span,
  .mobile-nav-link[aria-current='page'] .mobile-nav-link__line > span {
    transform: translateY(-100%);
    color: var(--color-amaranth);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__shell,
    .nav-link__text > span,
    .nav-link__bracket,
    .social-control,
    .mobile-nav-link__line > span {
      transition: none;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      __mgHeaderCleanup?: () => void;
      __mgHeaderBound?: boolean;
    }
  }

  const initHeader = () => {
    window.__mgHeaderCleanup?.();

    const header = document.querySelector<HTMLElement>('[data-header-root]');
    if (!header) return;

    const mobilePanel = header.querySelector<HTMLElement>('[data-mobile-panel]');
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menuClose = header.querySelector<HTMLButtonElement>('[data-menu-close]');
    const langToggles = Array.from(header.querySelectorAll<HTMLButtonElement>('[data-lang-toggle]'));
    const languageMenu = header.querySelector<HTMLElement>('[data-lang-menu]');
    let lastScrollY = window.scrollY;
    let bodyOverflow = '';

    const syncHeader = () => {
      const isMobileMenuOpen = mobilePanel ? !mobilePanel.hidden : false;
      header.dataset.compact = window.scrollY > 80 ? 'true' : 'false';

      if (!window.matchMedia('(min-width: 768px)').matches || isMobileMenuOpen) {
        header.dataset.hidden = 'false';
        return;
      }

      const delta = window.scrollY - lastScrollY;
      if (window.scrollY <= 120 || delta < -8) {
        header.dataset.hidden = 'false';
      } else if (delta > 8) {
        header.dataset.hidden = 'true';
      }

      lastScrollY = window.scrollY;
    };

    const setLanguageMenu = (open: boolean) => {
      if (!languageMenu) return;
      languageMenu.hidden = !open;
      langToggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(open)));
    };

    const setMobileMenu = (open: boolean) => {
      if (!mobilePanel || !menuToggle) return;

      mobilePanel.hidden = !open;
      menuToggle.setAttribute('aria-expanded', String(open));
      header.dataset.hidden = 'false';

      if (open) {
        bodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = bodyOverflow;
      }
    };

    const closeMenus = () => {
      setLanguageMenu(false);
      setMobileMenu(false);
    };

    const onScroll = () => syncHeader();
    const onFocusIn = () => {
      header.dataset.hidden = 'false';
    };
    const onPointerDown = (event: PointerEvent) => {
      const target = event.target instanceof Node ? event.target : null;
      if (target && !header.contains(target)) {
        closeMenus();
      }
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        closeMenus();
      }
    };

    menuToggle && (menuToggle.onclick = () => setMobileMenu(mobilePanel?.hidden ?? true));
    menuClose && (menuClose.onclick = () => setMobileMenu(false));
    langToggles.forEach((toggle) => {
      toggle.onclick = () => setLanguageMenu(languageMenu?.hidden ?? true);
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    header.addEventListener('focusin', onFocusIn);
    document.addEventListener('pointerdown', onPointerDown);
    document.addEventListener('keydown', onKeyDown);
    syncHeader();

    window.__mgHeaderCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      header.removeEventListener('focusin', onFocusIn);
      document.removeEventListener('pointerdown', onPointerDown);
      document.removeEventListener('keydown', onKeyDown);
      if (menuToggle) menuToggle.onclick = null;
      if (menuClose) menuClose.onclick = null;
      langToggles.forEach((toggle) => {
        toggle.onclick = null;
      });
      document.body.style.overflow = bodyOverflow;
    };
  };

  if (!window.__mgHeaderBound) {
    window.__mgHeaderBound = true;
    document.addEventListener('astro:before-swap', () => window.__mgHeaderCleanup?.());
    document.addEventListener('astro:page-load', initHeader);
  }

  initHeader();
</script>
