---
import { getLocalizedPath, getLocalizedRoute, langNames, resolvePublicRouteKey, t, type Lang } from '../i18n';
import { resolveHeaderLanguageLinks } from '../lib/headerLanguageLinks';
import { getPublicLanguagePicker, siteData } from '../lib/siteData';
import AdminTextMirror from './admin/AdminTextMirror';

interface Props {
  lang: Lang;
  adminMode?: boolean;
  alternateLinks?: Partial<Record<Lang, string>>;
}

const { lang, adminMode = false, alternateLinks } = Astro.props;
const i = t(lang);
const pathname = Astro.url.pathname;
const currentRoute = resolvePublicRouteKey(pathname);
const adminPath = pathname.replace(/^\/admin(?=\/|$)/, '') || '/';
const navPath = (path: string) => (adminMode ? `/admin${path === '/' ? '' : path}` : getLocalizedPath(path, lang));
const publicLanguagePicker = getPublicLanguagePicker(siteData);
const languagePickerPath = currentRoute ? pathname : getLocalizedRoute('home', lang);
const availableLanguages = resolveHeaderLanguageLinks({
  path: languagePickerPath,
  visibleLangs: publicLanguagePicker,
  getLocalizedPath,
  alternateLinks,
});

const publicNavItems = [
  { route: 'home', label: i.nav.home },
  { route: 'about', label: i.nav.about },
  { route: 'blog', label: i.nav.blog },
  { route: 'contact', label: i.nav.contact },
];

const publicServiceItems = [
  { route: 'seo', label: i.nav.seo },
  { route: 'translation', label: i.nav.translation },
  { route: 'ugc', label: i.nav.ugcService },
];

const adminNavItems = [
  { href: '/', label: i.nav.home, i18nKey: 'nav.home' },
  { href: '/about', label: i.nav.about, i18nKey: 'nav.about' },
  { href: '/blog', label: i.nav.blog, i18nKey: 'nav.blog' },
  { href: '/contact', label: i.nav.contact, i18nKey: 'nav.contact' },
];
const adminServiceItems = [
  { href: '/seo', label: i.nav.seo, i18nKey: 'nav.seo' },
  { href: '/translation-seo', label: i.nav.translation, i18nKey: 'nav.translation' },
  { href: '/ugc', label: i.nav.ugcService, i18nKey: 'nav.ugcService' },
];

const isActive = (path: string) => {
  const normalizedPath = adminPath === '' ? '/' : adminPath.replace(/\/$/, '') || '/';
  if (path === '/') return normalizedPath === '/';
  return normalizedPath === path || normalizedPath.startsWith(`${path}/`);
};
const isServiceActive = publicServiceItems.some(({ route }) => route === currentRoute);
const isAdminServiceActive = adminServiceItems.some(({ href }) => isActive(href));
const publicHref = (route: string) => getLocalizedRoute(route, lang);
---
<header
  class="site-header fixed inset-x-0 top-0 z-50 px-4 py-4 md:px-6"
  data-header-root
  data-compact="false"
  data-hidden="false"
  data-surface="light"
  data-admin={adminMode ? 'true' : 'false'}
>
  <div class="site-header__shell mx-auto flex w-full max-w-7xl items-center justify-between text-ink">
    <a href={navPath('/')} class="site-header__brand inline-flex items-center gap-2 text-base font-semibold tracking-[0.36em] text-ink transition hover:text-amaranth">
      <span class="font-heading text-lg">MG</span>
    </a>

    <div class="hidden items-center gap-6 md:ml-auto md:flex">
      {adminMode ? (
        <nav aria-label="Primary" class="flex items-center gap-4">
          {adminNavItems.slice(0, 2).map((item) => (
            <a href={navPath(item.href)} class="nav-link group" aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
              <span class="nav-link__text">
                <span><AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} /></span>
                <span aria-hidden="true"><AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} /></span>
              </span>
              <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
            </a>
          ))}
          <details class="services-nav" data-service-menu>
            <summary class="nav-link group" aria-controls="admin-service-menu-desktop" aria-current={isAdminServiceActive ? 'page' : undefined}>
              <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
              <span class="nav-link__text">
                <span><AdminTextMirror client:load i18nKey="nav.services" fallback={i.nav.services} />⌄</span>
                <span aria-hidden="true"><AdminTextMirror client:load i18nKey="nav.services" fallback={i.nav.services} />⌄</span>
              </span>
              <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
            </summary>
            <div class="service-submenu" id="admin-service-menu-desktop" role="group" aria-label={i.nav.services}>
              {adminServiceItems.map((item) => (
                <a href={navPath(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} />
                </a>
              ))}
            </div>
          </details>
          {adminNavItems.slice(2).map((item) => (
            <a href={navPath(item.href)} class="nav-link group" aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
              <span class="nav-link__text">
                <span><AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} /></span>
                <span aria-hidden="true"><AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} /></span>
              </span>
              <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
            </a>
          ))}
        </nav>
      ) : (
        <nav aria-label="Primary" class="flex items-center gap-4">
          {publicNavItems.slice(0, 2).map((item) => (
            <a href={publicHref(item.route)} class="nav-link group" aria-current={currentRoute === item.route ? 'page' : undefined}>
              <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
              <span class="nav-link__text">
                <span>{item.label}</span>
                <span aria-hidden="true">{item.label}</span>
              </span>
              <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
            </a>
          ))}
          <details class="services-nav" data-service-menu>
            <summary class="nav-link group" aria-controls="site-service-menu-desktop" aria-current={isServiceActive ? 'page' : undefined}>
              <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
              <span class="nav-link__text">
                <span>{i.nav.services}⌄</span>
                <span aria-hidden="true">{i.nav.services}⌄</span>
              </span>
              <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
            </summary>
            <div class="service-submenu" id="site-service-menu-desktop" role="group" aria-label={i.nav.services}>
              {publicServiceItems.map((item) => (
                <a href={publicHref(item.route)} aria-current={currentRoute === item.route ? 'page' : undefined}>
                  {item.label}
                </a>
              ))}
            </div>
          </details>
          {publicNavItems.slice(2).map((item) => (
            <a href={publicHref(item.route)} class="nav-link group" aria-current={currentRoute === item.route ? 'page' : undefined}>
              <span class="nav-link__bracket nav-link__bracket--left" aria-hidden="true">[</span>
              <span class="nav-link__text">
                <span>{item.label}</span>
                <span aria-hidden="true">{item.label}</span>
              </span>
              <span class="nav-link__bracket nav-link__bracket--right" aria-hidden="true">]</span>
            </a>
          ))}
        </nav>
      )}

      <div class="flex items-center gap-3">
        <a href={siteData.socialLinks.linkedin} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" class="social-control">
          <span class="social-control__linkedin-mark" aria-hidden="true">in</span>
        </a>
        <a href={siteData.socialLinks.instagram} target="_blank" rel="noreferrer noopener" aria-label="Instagram" class="social-control">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current" aria-hidden="true"><path d="M12 0C8.74 0 8.33.01 7.05.07 2.69.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07 3.26 0 3.67-.01 4.95-.07 4.36-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95 0-3.26-.01-3.67-.07-4.95-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.69-4.92-4.92A69.57 69.57 0 0 1 2.16 12c0-3.2.01-3.58.07-4.85.15-3.23 1.67-4.77 4.92-4.92A69.56 69.56 0 0 1 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
        </a>
        {!adminMode && (
          <button
            type="button"
            class="social-control"
            aria-label={i.language.label}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="site-language-menu"
            data-lang-toggle
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
              <path d="M12 3c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9Zm0 0c2.27 2.46 3.5 5.71 3.5 9S14.27 18.54 12 21m0-18C9.73 5.46 8.5 8.71 8.5 12s1.23 6.54 3.5 9m-8.36-6h16.72M3.64 9h16.72" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
            </svg>
          </button>
        )}
      </div>
    </div>

    <div class="flex items-center gap-2 md:hidden">
      {!adminMode && (
        <button
          type="button"
          class="social-control"
          aria-label={i.language.label}
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="site-language-menu"
          data-lang-toggle
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
            <path d="M12 3c4.97 0 9 4.03 9 9s-4.03 9-9 9-9-4.03-9-9 4.03-9 9-9Zm0 0c2.27 2.46 3.5 5.71 3.5 9S14.27 18.54 12 21m0-18C9.73 5.46 8.5 8.71 8.5 12s1.23 6.54 3.5 9m-8.36-6h16.72M3.64 9h16.72" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" />
          </svg>
        </button>
      )}
      <button type="button" class="social-control" data-menu-toggle aria-expanded="false" aria-controls="site-mobile-panel" aria-label={i.nav.openMenu}>
        <span class="sr-only">{i.nav.openMenu}</span>
        <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
          <path d="M5 7h14M5 12h14M5 17h14" stroke-linecap="round" stroke-width="1.8" />
        </svg>
      </button>
    </div>
  </div>

  {!adminMode && (
    <div class="language-popover-wrap mx-auto w-full max-w-7xl px-4 md:px-6">
      <div class="relative flex justify-end">
        <div class="language-menu" id="site-language-menu" data-lang-menu hidden role="menu" aria-label={i.language.label}>
        {availableLanguages.map(({ lang: locale, href }) => (
            <a
            href={href}
              class:list={['language-menu__link', locale === lang && 'is-active']}
              role="menuitem"
            >
              {langNames[locale]}
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <div class="mobile-panel" id="site-mobile-panel" data-mobile-panel hidden>
    <div class="mobile-panel__content">
      <div class="flex items-center justify-between border-b border-ink/8 pb-4">
        <span class="font-heading text-xl tracking-[0.28em]">MG</span>
        <button type="button" class="social-control" data-menu-close aria-label={i.nav.closeMenu}>
          <span class="sr-only">{i.nav.closeMenu}</span>
          <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-current" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" stroke-width="1.8" />
          </svg>
        </button>
      </div>

      <nav aria-label="Mobile" class="mt-8 flex flex-col gap-5">
        {adminMode ? (
          <>
            {adminNavItems.slice(0, 2).map((item) => (
              <a href={navPath(item.href)} class="mobile-nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                <AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} />
              </a>
            ))}
            <details class="mobile-services" data-service-menu>
              <summary class="mobile-nav-link" aria-controls="admin-service-menu-mobile" aria-current={isAdminServiceActive ? 'page' : undefined}>
                <AdminTextMirror client:load i18nKey="nav.services" fallback={i.nav.services} />
                <span class="mobile-services__indicator" aria-hidden="true">+</span>
              </summary>
              <div class="mobile-service-menu" id="admin-service-menu-mobile">
                {adminServiceItems.map((item) => (
                  <a href={navPath(item.href)} class="mobile-nav-link mobile-service-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                    <AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} />
                  </a>
                ))}
              </div>
            </details>
            {adminNavItems.slice(2).map((item) => (
              <a href={navPath(item.href)} class="mobile-nav-link" aria-current={isActive(item.href) ? 'page' : undefined}>
                <AdminTextMirror client:load i18nKey={item.i18nKey} fallback={item.label} />
              </a>
            ))}
          </>
        ) : (
          <>
            {publicNavItems.slice(0, 2).map((item) => (
              <a href={publicHref(item.route)} class="mobile-nav-link" aria-current={currentRoute === item.route ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
            <details class="mobile-services" data-service-menu>
              <summary class="mobile-nav-link" aria-controls="site-service-menu-mobile" aria-current={isServiceActive ? 'page' : undefined}>
                {i.nav.services}
                <span class="mobile-services__indicator" aria-hidden="true">+</span>
              </summary>
              <div class="mobile-service-menu" id="site-service-menu-mobile">
                {publicServiceItems.map((item) => (
                  <a href={publicHref(item.route)} class="mobile-nav-link mobile-service-link" aria-current={currentRoute === item.route ? 'page' : undefined}>
                    {item.label}
                  </a>
                ))}
              </div>
            </details>
            {publicNavItems.slice(2).map((item) => (
              <a href={publicHref(item.route)} class="mobile-nav-link" aria-current={currentRoute === item.route ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
          </>
        )}
      </nav>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href={siteData.socialLinks.linkedin} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" class="social-control">
          <span class="social-control__linkedin-mark" aria-hidden="true">in</span>
        </a>
        <a href={siteData.socialLinks.instagram} target="_blank" rel="noreferrer noopener" aria-label="Instagram" class="social-control">
          <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-current" aria-hidden="true"><path d="M12 0C8.74 0 8.33.01 7.05.07 2.69.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07 3.26 0 3.67-.01 4.95-.07 4.36-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95 0-3.26-.01-3.67-.07-4.95-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.69-4.92-4.92A69.57 69.57 0 0 1 2.16 12c0-3.2.01-3.58.07-4.85.15-3.23 1.67-4.77 4.92-4.92A69.56 69.56 0 0 1 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
        </a>
      </div>

      {!adminMode && (
        <div class="mt-10 flex items-center gap-3">
          {availableLanguages.map(({ lang: locale, href }) => (
            <a href={href} class:list={['language-chip', locale === lang && 'is-active']}>
              {langNames[locale]}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .site-header {
    transition: transform 0.35s ease, padding 0.35s ease;
  }

  .site-header[data-hidden='true'] {
    transform: translateY(calc(-100% - 0.75rem));
  }

  .site-header[data-compact='true'] {
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
  }

  .site-header__shell {
    transition: padding 0.3s ease;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    overflow: hidden;
    padding: 0.15rem 0;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .nav-link__text {
    display: grid;
    height: 1.05rem;
    overflow: hidden;
    color: rgb(6 4 3 / 0.8);
    transition: color 0.2s ease;
  }

  .site-header[data-surface='dark'] .site-header__shell,
  .site-header[data-surface='dark'] .site-header__brand,
  .site-header[data-surface='dark'] .social-control {
    color: var(--color-paper);
  }

  .site-header[data-surface='dark'] .social-control {
    border-color: rgb(244 245 241 / 0.4);
  }

  .site-header[data-surface='dark'] .nav-link__text {
    color: var(--color-paper);
  }

  .nav-link__text > span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 1.05rem;
    transform: translateY(0);
    transition: transform 0.24s ease;
  }

  .nav-link__bracket {
    color: var(--color-amaranth);
    font-size: 0.9rem;
    opacity: 0;
    transform: translateY(0.3rem);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .services-nav {
    position: relative;
  }

  .services-nav > summary,
  .mobile-services > summary {
    cursor: pointer;
    list-style: none;
  }

  .services-nav > summary::-webkit-details-marker,
  .mobile-services > summary::-webkit-details-marker {
    display: none;
  }

  .service-submenu {
    position: absolute;
    top: calc(100% + 0.8rem);
    left: -0.75rem;
    z-index: 60;
    display: grid;
    min-width: 16rem;
    gap: 0.2rem;
    border: 1px solid rgb(6 4 3 / 0.12);
    background: rgb(244 245 241 / 0.98);
    padding: 0.45rem;
    box-shadow: 0 20px 50px rgb(6 4 3 / 0.1);
  }

  .service-submenu a {
    display: block;
    padding: 0.7rem 0.8rem;
    color: rgb(6 4 3 / 0.8);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .service-submenu a:hover,
  .service-submenu a:focus-visible,
  .service-submenu a[aria-current='page'] {
    background: rgb(6 4 3 / 0.04);
    color: var(--color-amaranth);
  }

  .nav-link:hover .nav-link__text,
  .nav-link:focus-visible .nav-link__text,
  .nav-link[aria-current='page'] .nav-link__text {
    color: var(--color-amaranth);
  }

  .nav-link:hover .nav-link__text > span,
  .nav-link:focus-visible .nav-link__text > span,
  .nav-link[aria-current='page'] .nav-link__text > span {
    transform: translateY(-100%);
  }

  .nav-link:hover .nav-link__bracket,
  .nav-link:focus-visible .nav-link__bracket,
  .nav-link[aria-current='page'] .nav-link__bracket {
    opacity: 1;
    transform: translateY(0);
  }

  .social-control {
    display: inline-flex;
    height: 2.2rem;
    width: 2.2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgb(6 4 3 / 0.2);
    background: transparent;
    color: rgb(6 4 3 / 0.72);
    box-shadow: none;
    transition: transform 0.2s ease, color 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .social-control__linkedin-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    text-transform: lowercase;
    transform: translateY(-0.02em);
  }

  .social-control:hover,
  .social-control:focus-visible {
    transform: translateY(-3px);
    color: var(--color-amaranth);
    border-color: var(--color-ink);
    box-shadow: 0 4px 0 #E83256;
  }

  .language-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.8rem);
    min-width: 5rem;
    border-radius: 1rem;
    border: 1px solid rgb(6 4 3 / 0.12);
    background: rgb(244 245 241 / 0.98);
    padding: 0.4rem;
    box-shadow: 0 20px 50px rgb(6 4 3 / 0.1);
  }

  .language-menu__link,
  .language-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid transparent;
    padding: 0.6rem 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(6 4 3 / 0.84);
    transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .language-menu__link {
    width: 100%;
  }

  .language-menu__link:hover,
  .language-menu__link:focus-visible,
  .language-menu__link.is-active,
  .language-chip:hover,
  .language-chip:focus-visible,
  .language-chip.is-active {
    border-color: rgb(6 4 3 / 0.12);
    background: rgb(6 4 3 / 0.04);
    color: var(--color-amaranth);
  }

  .mobile-panel {
    position: fixed;
    inset: 0;
    z-index: 48;
    overflow-y: auto;
    background: var(--color-paper);
    overscroll-behavior: contain;
  }

  .mobile-panel__content {
    display: flex;
    min-height: 100dvh;
    flex-direction: column;
    padding: 1.25rem 1.1rem 2rem;
  }

  .mobile-nav-link {
    display: flex;
    width: 100%;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(6, 4, 3, 0.08);
    padding-bottom: 0.9rem;
    font-size: clamp(1.8rem, 8vw, 2.6rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: rgba(6, 4, 3, 0.88);
    transition: color 0.2s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible,
  .mobile-nav-link:active,
  .mobile-nav-link[aria-current='page'],
  .mobile-services[open] > .mobile-nav-link {
    color: var(--color-amaranth);
  }

  .mobile-services__indicator {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    transition: transform 0.2s ease;
  }

  .mobile-services[open] .mobile-services__indicator {
    transform: rotate(45deg);
  }

  .mobile-service-menu {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: -0.75rem 0 0 1rem;
  }

  .mobile-nav-link.mobile-service-link {
    border-bottom: 0;
    color: rgb(6 4 3 / 0.64);
    font-size: clamp(1.15rem, 5vw, 1.5rem);
    padding-bottom: 0.45rem;
  }

  .mobile-nav-link.mobile-service-link:hover,
  .mobile-nav-link.mobile-service-link:focus-visible,
  .mobile-nav-link.mobile-service-link:active,
  .mobile-nav-link.mobile-service-link[aria-current='page'] {
    color: var(--color-amaranth);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header__shell,
    .nav-link__text > span,
    .nav-link__bracket,
    .social-control,
    .mobile-nav-link,
    .mobile-services__indicator,
    .service-submenu a {
      transition: none;
    }
  }
</style>

<script>
  import { closeActiveHeaderOverlay, createHeaderOverlayState, getFocusTrapTarget, toggleLanguageMenu, toggleMobileMenu } from '../lib/headerOverlayState.js';
  import { getHeaderVisibilityState } from '../lib/headerOverlayState.js';

  declare global {
    interface Window {
      __mgHeaderCleanup?: () => void;
      __mgHeaderBound?: boolean;
    }
  }

  const initHeader = () => {
    window.__mgHeaderCleanup?.();

    const header = document.querySelector<HTMLElement>('[data-header-root]');
    if (!header) return;

    const mobilePanel = header.querySelector<HTMLElement>('[data-mobile-panel]');
    const menuToggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menuClose = header.querySelector<HTMLButtonElement>('[data-menu-close]');
    const langToggles = Array.from(header.querySelectorAll<HTMLButtonElement>('[data-lang-toggle]'));
    const languageMenu = header.querySelector<HTMLElement>('[data-lang-menu]');
    const mobileLinks = Array.from(header.querySelectorAll<HTMLAnchorElement>('a.mobile-nav-link, a.language-chip'));
    const languageLinks = Array.from(header.querySelectorAll<HTMLAnchorElement>('[data-lang-menu] [role="menuitem"]'));
    const serviceMenus = Array.from(header.querySelectorAll<HTMLDetailsElement>('[data-service-menu]'));
    let lastScrollY = window.scrollY;
    let headerHidden = false;
    let bodyOverflow = '';
    let overlayState = createHeaderOverlayState();
    let surfaceFrame: number | null = null;

    const getFocusableElements = (container: HTMLElement | null) => {
      if (!container) return [];
      return Array.from(
        container.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => !element.hasAttribute('hidden') && element.getClientRects().length > 0);
    };

    const trapFocus = (event: KeyboardEvent, container: HTMLElement | null) => {
      if (event.key !== 'Tab') return;

      const focusableElements = getFocusableElements(container);
      if (focusableElements.length === 0) return;

      const first = focusableElements[0];
      const last = focusableElements[focusableElements.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const focusOverlayTarget = (target: 'first-language-item' | 'mobile-close' | null) => {
      if (target === 'mobile-close') {
        requestAnimationFrame(() => {
          menuClose?.focus();
        });
        return;
      }

      if (target === 'first-language-item') {
        requestAnimationFrame(() => {
          languageMenu?.querySelector<HTMLElement>('[role="menuitem"]')?.focus();
        });
      }
    };

    const applyOverlayResult = ({
      state: nextState,
      focusTarget,
      restoreFocusTo,
    }: {
      state: ReturnType<typeof createHeaderOverlayState>;
      focusTarget: 'first-language-item' | 'mobile-close' | null;
      restoreFocusTo: HTMLElement | null;
    }) => {
      const wasBodyScrollLocked = overlayState.bodyScrollLocked;

      if (!wasBodyScrollLocked && nextState.bodyScrollLocked) {
        bodyOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
      }

      if (wasBodyScrollLocked && !nextState.bodyScrollLocked) {
        document.body.style.overflow = bodyOverflow;
      }

      overlayState = nextState;

      if (mobilePanel && menuToggle) {
        mobilePanel.hidden = !nextState.mobileMenuOpen;
        menuToggle.setAttribute('aria-expanded', String(nextState.mobileMenuOpen));
      }

      if (languageMenu) {
        languageMenu.hidden = !nextState.languageMenuOpen;
      }

      langToggles.forEach((toggle) => toggle.setAttribute('aria-expanded', String(nextState.languageMenuOpen)));
      syncHeader();

      restoreFocusTo?.focus();
      focusOverlayTarget(focusTarget);
    };

    const syncHeader = () => {
      const nextHeaderState = getHeaderVisibilityState({
        currentHidden: headerHidden,
        overlayState,
        isDesktop: window.matchMedia('(min-width: 768px)').matches,
        scrollY: window.scrollY,
        lastScrollY,
      });

      header.dataset.compact = nextHeaderState.compact ? 'true' : 'false';
      header.dataset.hidden = nextHeaderState.hidden ? 'true' : 'false';
      headerHidden = nextHeaderState.hidden;
      lastScrollY = nextHeaderState.lastScrollY;
    };
    const updateHeaderSurface = () => {
      if (surfaceFrame !== null) return;

      surfaceFrame = window.requestAnimationFrame(() => {
        surfaceFrame = null;
        const headerRect = header.getBoundingClientRect();
        const isDarkSurface = Array.from(document.querySelectorAll<HTMLElement>('.bg-ink')).some((surface) => {
          if (header.contains(surface)) return false;

          const surfaceRect = surface.getBoundingClientRect();
          const overlapHeight = Math.min(headerRect.bottom, surfaceRect.bottom) - Math.max(headerRect.top, surfaceRect.top);
          const overlapWidth = Math.min(headerRect.right, surfaceRect.right) - Math.max(headerRect.left, surfaceRect.left);
          return overlapHeight >= headerRect.height * 0.5 && overlapWidth >= headerRect.width * 0.5;
        });

        header.dataset.surface = isDarkSurface ? 'dark' : 'light';
      });
    };
    const closeMenus = () => {
      applyOverlayResult(closeActiveHeaderOverlay(overlayState));
    };

    const onScroll = () => {
      syncHeader();
      updateHeaderSurface();
    };
    const onFocusIn = () => {
      headerHidden = false;
      header.dataset.hidden = 'false';
    };
    const onPointerDown = (event: PointerEvent) => {
      const target = event.target instanceof Node ? event.target : null;
      if (target && !header.contains(target)) {
        closeMenus();
        serviceMenus.forEach((serviceMenu) => {
          serviceMenu.open = false;
        });
      }
    };
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        const openServiceMenu = serviceMenus.find((serviceMenu) => serviceMenu.open);
        if (openServiceMenu) {
          event.preventDefault();
          openServiceMenu.open = false;
          openServiceMenu.querySelector<HTMLElement>('summary')?.focus();
          return;
        }

        if (!overlayState.activeOverlay) return;
        event.preventDefault();
        applyOverlayResult(closeActiveHeaderOverlay(overlayState));
        return;
      }

      const activeOverlay = getFocusTrapTarget(overlayState);
      if (activeOverlay) {
        trapFocus(event, activeOverlay === 'mobile' ? mobilePanel : languageMenu);
      }
    };

    menuToggle && (menuToggle.onclick = () => {
      applyOverlayResult(toggleMobileMenu(overlayState, menuToggle));
    });
    menuClose && (menuClose.onclick = () => {
      applyOverlayResult(closeActiveHeaderOverlay(overlayState));
    });
    langToggles.forEach((toggle) => {
      toggle.onclick = () => {
        applyOverlayResult(toggleLanguageMenu(overlayState, toggle));
      };
    });
    mobileLinks.forEach((link) => {
      link.onclick = () => applyOverlayResult(closeActiveHeaderOverlay(overlayState));
    });
    languageLinks.forEach((link) => {
      link.onclick = () => applyOverlayResult(closeActiveHeaderOverlay(overlayState));
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateHeaderSurface);
    header.addEventListener('focusin', onFocusIn);
    document.addEventListener('pointerdown', onPointerDown);
    document.addEventListener('keydown', onKeyDown);
    syncHeader();
    updateHeaderSurface();

    window.__mgHeaderCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', updateHeaderSurface);
      if (surfaceFrame !== null) window.cancelAnimationFrame(surfaceFrame);
      header.removeEventListener('focusin', onFocusIn);
      document.removeEventListener('pointerdown', onPointerDown);
      document.removeEventListener('keydown', onKeyDown);
      if (menuToggle) menuToggle.onclick = null;
      if (menuClose) menuClose.onclick = null;
      langToggles.forEach((toggle) => {
        toggle.onclick = null;
      });
      mobileLinks.forEach((link) => {
        link.onclick = null;
      });
      languageLinks.forEach((link) => {
        link.onclick = null;
      });
      document.body.style.overflow = bodyOverflow;
    };
  };

  if (!window.__mgHeaderBound) {
    window.__mgHeaderBound = true;
    document.addEventListener('astro:before-swap', () => window.__mgHeaderCleanup?.());
    document.addEventListener('astro:page-load', initHeader);
  }

  initHeader();
</script>
