---
import { getLocalizedPath, t, type Lang } from '../i18n';
import { siteData } from '../lib/siteData';

interface Props {
  lang: Lang;
  adminMode?: boolean;
}

const { lang, adminMode = false } = Astro.props;
const i = t(lang);
const year = new Date().getFullYear();
const navPath = (path: string) => (adminMode ? `/admin${path === '/' ? '' : path}` : getLocalizedPath(path, lang));
const navItems = [
  { href: '/', label: i.nav.home },
  { href: '/ugc', label: i.nav.ugc },
  { href: '/translation-seo', label: i.nav.translationSeo },
  { href: '/blog', label: i.nav.blog },
  { href: '/contact', label: i.nav.contact },
];
---
<footer class="footer-shell bg-charcoal text-cream">
  <div class="mx-auto max-w-7xl px-6 py-14 md:px-10 md:py-20">
    <div
      class="footer-shell__reveal rounded-[2.25rem] border border-white/10 bg-charcoal px-6 py-10 md:px-10 md:py-14"
      data-footer-reveal
      data-reveal-mode="idle"
    >
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div class="space-y-5">
          <p class="font-body text-xs font-semibold uppercase tracking-[0.34em] text-paper">{i.footer.eyebrow}</p>
          <h2 class="font-heading text-5xl uppercase leading-none text-white md:text-7xl">{i.footer.headline}</h2>
          <p class="max-w-2xl text-base leading-7 text-white/70 md:text-lg">{i.footer.support}</p>
        </div>

        <div class="lg:justify-self-end">
          <a href={navPath('/contact')} class="footer-cta">
            {i.footer.cta}
          </a>
        </div>
      </div>

      <div class="mt-12 flex flex-col gap-10 border-t border-white/10 pt-10">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
          <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-4">
            {navItems.map((item) => (
              <a href={navPath(item.href)} class="footer-nav-link group">
                <span class="footer-nav-link__bracket" aria-hidden="true">[</span>
                <span class="footer-nav-link__line">
                  <span>{item.label}</span>
                  <span aria-hidden="true">{item.label}</span>
                </span>
                <span class="footer-nav-link__bracket" aria-hidden="true">]</span>
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-3">
            <a href={siteData.socialLinks.linkedin} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" class="footer-social">
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M20.45 20.45H16.9v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77A1.75 1.75 0 0 0 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45A1.76 1.76 0 0 0 24 22.27V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
            <a href={siteData.socialLinks.instagram} target="_blank" rel="noreferrer noopener" aria-label="Instagram" class="footer-social">
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current" aria-hidden="true"><path d="M12 0C8.74 0 8.33.01 7.05.07 2.69.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98 1.28.06 1.69.07 4.95.07 3.26 0 3.67-.01 4.95-.07 4.36-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95 0-3.26-.01-3.67-.07-4.95-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0Zm0 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.67 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.69-4.92-4.92A69.57 69.57 0 0 1 2.16 12c0-3.2.01-3.58.07-4.85.15-3.23 1.67-4.77 4.92-4.92A69.56 69.56 0 0 1 12 2.16Zm0 3.68a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32Zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.84a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z"/></svg>
            </a>
          </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-white/60 md:flex-row md:items-center md:justify-between">
          <div class="flex flex-wrap items-center gap-3 uppercase tracking-[0.28em] text-white/70">
            <span class="font-heading text-base tracking-[0.34em] text-white">MG</span>
            <span>{i.footer.location}</span>
          </div>
          <p>© {year} Marta Gallardo. {i.footer.rights}.</p>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import {
    getFooterRevealMode,
    hasFooterRevealSessionFlag,
    rememberFooterReveal,
  } from '../lib/footerReveal.js';

  const reveal = document.querySelector('[data-footer-reveal]');

  if (reveal instanceof HTMLElement) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mode = getFooterRevealMode({
      hasSessionFlag: hasFooterRevealSessionFlag(window.sessionStorage),
      prefersReducedMotion,
    });

    reveal.dataset.revealMode = mode;
    document.documentElement.dataset.footerRevealSeen = 'true';

    if (mode === 'play') {
      rememberFooterReveal(window.sessionStorage);
    }
  }
</script>

<style>
  .footer-shell__reveal {
    animation: footer-reveal 0.7s ease both;
  }

  :root[data-footer-reveal-seen='true'] .footer-shell__reveal:not([data-reveal-mode='play']),
  .footer-shell__reveal[data-reveal-mode='skip'] {
    animation: none;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(232, 50, 86, 0.45);
    background: var(--color-amaranth);
    padding: 0.95rem 1.5rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .footer-cta:hover,
  .footer-cta:focus-visible {
    transform: translateY(-2px);
    background: var(--color-paper);
    color: var(--color-amaranth);
  }

  .footer-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    overflow: hidden;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .footer-nav-link__line {
    display: grid;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.72);
  }

  .footer-nav-link__line > span {
    min-height: 1rem;
    transition: transform 0.24s ease;
  }

  .footer-nav-link__bracket {
    color: var(--color-amaranth);
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  .footer-nav-link:hover .footer-nav-link__line > span,
  .footer-nav-link:focus-visible .footer-nav-link__line > span {
    transform: translateY(-100%);
  }

  .footer-nav-link:hover .footer-nav-link__line,
  .footer-nav-link:focus-visible .footer-nav-link__line {
    color: var(--color-paper);
  }

  .footer-nav-link:hover .footer-nav-link__bracket,
  .footer-nav-link:focus-visible .footer-nav-link__bracket {
    opacity: 1;
  }

  .footer-social {
    display: inline-flex;
    height: 2.65rem;
    width: 2.65rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-paper);
    box-shadow: 0 6px 0 rgba(232, 50, 86, 0.18);
    transition: transform 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .footer-social:hover,
  .footer-social:focus-visible {
    transform: translateY(-3px);
    color: var(--color-amaranth);
    box-shadow: 0 10px 0 rgba(232, 50, 86, 0.25);
  }

  @keyframes footer-reveal {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-shell__reveal,
    .footer-cta,
    .footer-nav-link__line > span,
    .footer-nav-link__bracket,
    .footer-social {
      animation: none;
      transition: none;
    }
  }
</style>
