---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, t } from '../../../i18n';
import ScrollReveal from '../../../components/ScrollReveal';
import PageTransition from '../../../components/PageTransition';
import StaggerContainer, { StaggerItem } from '../../../components/StaggerContainer';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);

const posts = (await getCollection('blog'))
  .filter(post => post.data.lang === lang || lang === 'es') // ponytail: show all posts for default lang
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`${i.blog.title} — ${i.hero.name}`}>
  <div class="pt-24 pb-16 max-w-4xl mx-auto px-6">
    <PageTransition client:load>
      <ScrollReveal client:visible>
        <h1 class="font-heading text-5xl md:text-7xl font-light text-charcoal mb-4">{i.blog.title}</h1>
        <div class="w-20 h-0.5 bg-rose-gold mb-12"></div>
      </ScrollReveal>

      {posts.length === 0 ? (
        <p class="text-warm-gray font-body text-lg">No hay posts todavía. ¡Pronto!</p>
      ) : (
        <StaggerContainer client:visible className="grid gap-8">
          {posts.map(post => (
            <StaggerItem client:visible>
              <a href={`/blog/${post.id}`} class="group block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
                <div class="p-6 md:p-8">
                  {post.data.image && (
                    <div class="w-full h-48 bg-blush-100 rounded-xl mb-6 overflow-hidden">
                      <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" />
                    </div>
                  )}
                  <div class="flex items-center gap-3 mb-3">
                    <time class="text-sm text-warm-gray font-body">
                      {post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                    </time>
                    {post.data.tags.map(tag => (
                      <span class="text-xs bg-blush-50 text-rose-gold px-2 py-0.5 rounded-full">{tag}</span>
                    ))}
                  </div>
                  <h2 class="font-heading text-2xl md:text-3xl text-charcoal group-hover:text-rose-gold transition-colors mb-2">
                    {post.data.title}
                  </h2>
                  <p class="text-warm-gray font-body leading-relaxed">{post.data.description}</p>
                  <span class="inline-block mt-4 text-rose-gold text-sm font-medium group-hover:translate-x-1 transition-transform">
                    {i.blog.readMore} →
                  </span>
                </div>
              </a>
            </StaggerItem>
          ))}
        </StaggerContainer>
      )}
    </PageTransition>
  </div>
</BaseLayout>
