---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollReveal from '../components/ScrollReveal';
import PageTransition from '../components/PageTransition';
import StaggerContainer, { StaggerItem } from '../components/StaggerContainer';
import RichText from '../components/RichText.astro';
import { getLangFromUrl, t } from '../i18n';
import { siteData } from '../lib/siteData';
import { getTranslationToolTiles } from '../lib/translationPage.js';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.translationPage;
const toolTiles = getTranslationToolTiles(lang, siteData, page.skills.tools.items);

const pageTitle = `${i.hero.name} — ${i.nav.translationSeo}`;
const pageDescription = page.hero.text.replaceAll('\\n', ' ').replace(/\s+/g, ' ').trim();
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageTransition client:load className="pt-24">
    <section class="relative overflow-hidden border-b border-blush-100 bg-gradient-to-b from-blush-50 via-cream to-white">
      <div class="absolute inset-x-0 top-0 h-72 bg-blush-100/40 blur-3xl"></div>
      <div class="relative mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-24">
        <div class="max-w-4xl space-y-6">
          <p class="font-accent text-sm uppercase tracking-[0.28em] text-rose-gold">{page.hero.eyebrow}</p>
          <h1 class="font-heading text-5xl font-semibold leading-none text-charcoal md:text-7xl">{page.hero.title}</h1>
          <RichText text={page.hero.text} class="max-w-4xl text-lg leading-8 text-warm-gray" />
          <p class="max-w-3xl text-base font-medium leading-7 text-charcoal/80">{page.hero.availability}</p>
        </div>
      </div>
    </section>
  </PageTransition>

  <ScrollReveal client:visible className="mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-20">
    <section class="space-y-8">
      <div class="max-w-2xl">
        <h2 class="font-heading text-4xl text-charcoal md:text-5xl">{page.services.title}</h2>
      </div>
      <StaggerContainer client:visible className="grid gap-6 md:grid-cols-3" staggerDelay={0.12}>
        {page.services.items.map((service) => (
          <StaggerItem>
            <article class="h-full rounded-[1.75rem] border border-blush-100 bg-white p-8 shadow-sm transition-transform duration-300 hover:-translate-y-1">
              <h3 class="font-heading text-3xl text-charcoal">{service.name}</h3>
              <RichText text={service.description} class="mt-4 text-sm leading-7 text-warm-gray" />
            </article>
          </StaggerItem>
        ))}
      </StaggerContainer>
    </section>
  </ScrollReveal>

  <ScrollReveal client:visible className="mx-auto max-w-6xl px-6 py-4 md:px-10 md:py-8">
    <section class="rounded-[2rem] border border-blush-100 bg-white p-8 shadow-sm md:p-10">
      <div class="max-w-3xl">
        <p class="font-accent text-sm uppercase tracking-[0.22em] text-rose-gold">{page.experience.eyebrow}</p>
        <h2 class="mt-4 font-heading text-4xl text-charcoal md:text-5xl">{page.experience.title}</h2>
        <RichText text={page.experience.text} class="mt-4 text-base leading-8 text-warm-gray" />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {page.experience.cards.map((card) => (
          <article class="rounded-[1.75rem] border border-blush-100 bg-blush-50 p-6 md:p-7">
            <h3 class="font-heading text-2xl text-charcoal">{card.title}</h3>
            <p class="mt-4 font-accent text-xs uppercase tracking-[0.24em] text-rose-gold">{card.highlight}</p>
            <RichText text={card.text} class="mt-4 text-sm leading-7 text-warm-gray" />
          </article>
        ))}
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal client:visible className="mx-auto max-w-6xl px-6 py-12 md:px-10 md:py-16">
    <section class="rounded-[2rem] border border-blush-100 bg-charcoal p-8 text-cream shadow-sm md:p-10">
      <div class="max-w-3xl">
        <p class="font-accent text-sm uppercase tracking-[0.22em] text-blush-200">{page.skills.eyebrow}</p>
        <h2 class="mt-4 font-heading text-4xl text-white md:text-5xl">{page.skills.title}</h2>
        <RichText text={page.skills.text} class="mt-4 text-base leading-8 text-blush-50/90" />
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <article class="rounded-[1.75rem] border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <h3 class="font-heading text-2xl text-white">{page.skills.linguistic.title}</h3>
          <div class="mt-5 flex flex-wrap gap-3">
            {page.skills.linguistic.items.map((item) => (
              <span class="rounded-full border border-blush-200/30 bg-white/10 px-4 py-2 text-sm text-blush-50">{item}</span>
            ))}
          </div>
        </article>
        <article class="rounded-[1.75rem] border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
          <h3 class="font-heading text-2xl text-white">{page.skills.webOptimization.title}</h3>
          <div class="mt-5 flex flex-wrap gap-3">
            {page.skills.webOptimization.items.map((item) => (
              <span class="rounded-full border border-blush-200/30 bg-white/10 px-4 py-2 text-sm text-blush-50">{item}</span>
            ))}
          </div>
        </article>
        <article class="rounded-[1.75rem] border border-blush-100 bg-white p-6">
          <h3 class="font-heading text-2xl text-charcoal">{page.skills.tools.title}</h3>
          <div class="mt-5 grid grid-cols-3 gap-4 sm:grid-cols-4">
            {toolTiles.map((item) => (
              <div class="flex flex-col items-center gap-2 text-center">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-blush-50">
                  <img src={item.logoSrc} alt={item.label} class="h-7 w-7 object-contain" />
                </div>
                <span class="text-xs leading-tight text-warm-gray">{item.label}</span>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal client:visible className="mx-auto max-w-6xl px-6 py-4 md:px-10 md:py-8">
    <section class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div class="rounded-[2rem] border border-blush-100 bg-white p-8 shadow-sm">
        <p class="font-accent text-sm uppercase tracking-[0.22em] text-rose-gold">{page.education.eyebrow}</p>
        <h2 class="mt-4 font-heading text-4xl text-charcoal">{page.education.title}</h2>
        <RichText text={page.education.intro} class="mt-4 text-base leading-8 text-warm-gray" />
        <ul class="mt-6 space-y-4 text-base leading-8 text-charcoal">
          {page.education.studies.map((study) => (
            <li class="flex gap-3">
              <span class="mt-2 h-2.5 w-2.5 rounded-full bg-rose-gold"></span>
              <span>{study}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-[2rem] border border-blush-100 bg-blush-50 p-8 shadow-sm">
        <p class="font-accent text-sm uppercase tracking-[0.22em] text-rose-gold">{page.education.languagesEyebrow}</p>
        <h2 class="mt-4 font-heading text-4xl text-charcoal">{page.education.languagesTitle}</h2>
        <div class="mt-6 space-y-4">
          {page.education.languages.map((language) => (
            <div class="rounded-2xl border border-blush-100 bg-white px-5 py-4">
              <div class="flex items-center justify-between gap-4">
                <span class="font-heading text-2xl text-charcoal">{language.name}</span>
                <span class="rounded-full bg-blush-100 px-3 py-1 text-sm text-charcoal">{language.level}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal client:visible className="mx-auto max-w-6xl px-6 py-4 md:px-10 md:py-8">
    <section class="rounded-[2rem] border border-blush-100 bg-blush-50 p-8 shadow-sm md:p-10">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <p class="font-accent text-sm uppercase tracking-[0.22em] text-rose-gold">{page.servicesOffered.eyebrow}</p>
          <h2 class="mt-4 font-heading text-4xl text-charcoal">{page.servicesOffered.title}</h2>
        </div>
        <RichText text={page.servicesOffered.intro} class="max-w-xl text-sm leading-7 text-warm-gray" />
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {page.servicesOffered.items.map((item, index) => (
          <article class="rounded-[1.5rem] border border-blush-100 bg-white p-6 shadow-sm">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blush-100 font-accent text-lg text-rose-gold">
              0{index + 1}
            </div>
            <h3 class="mt-5 font-heading text-2xl text-charcoal">{item}</h3>
          </article>
        ))}
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal client:visible className="mx-auto max-w-6xl px-6 py-12 md:px-10">
    <section class="rounded-[2rem] border border-blush-100 bg-white p-8 shadow-sm md:p-10">
      <div class="max-w-3xl">
        <p class="font-accent text-sm uppercase tracking-[0.22em] text-rose-gold">{page.process.eyebrow}</p>
        <h2 class="mt-4 font-heading text-4xl text-charcoal">{page.process.title}</h2>
        <RichText text={page.process.intro} class="mt-4 text-base leading-8 text-warm-gray" />
      </div>

      <div class="relative mt-10">
        <div class="absolute bottom-6 left-[1.45rem] top-6 w-px bg-blush-200 md:left-10 md:right-10 md:top-10 md:h-px md:w-auto"></div>
        <div class="grid gap-6 md:grid-cols-4">
          {page.process.steps.map((step, index) => (
            <article class="relative pl-14 md:pl-0">
              <div class="absolute left-0 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-blush-200 bg-cream font-accent text-lg text-rose-gold md:relative md:mx-auto">
                {index + 1}
              </div>
              <div class="rounded-[1.5rem] border border-blush-100 bg-blush-50 p-6 md:mt-6">
                <p class="font-accent text-xs uppercase tracking-[0.24em] text-rose-gold">0{index + 1}</p>
                <h3 class="mt-3 font-heading text-2xl text-charcoal">{step.title}</h3>
                <RichText text={step.description} class="mt-3 text-sm leading-7 text-warm-gray" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </ScrollReveal>

  <StaggerContainer client:visible className="mx-auto grid max-w-6xl gap-6 px-6 py-4 md:grid-cols-3 md:px-10 md:py-8" staggerDelay={0.14}>
    <StaggerItem className="md:col-span-3">
      <section class="rounded-[2rem] border border-blush-100 bg-charcoal p-8 text-cream shadow-sm md:p-10">
        <p class="font-accent text-sm uppercase tracking-[0.22em] text-blush-200">{page.whyMe.eyebrow}</p>
        <h2 class="mt-4 font-heading text-4xl text-white">{page.whyMe.title}</h2>
        <RichText text={page.whyMe.text} class="mt-4 max-w-3xl text-base leading-8 text-blush-50/90" />
      </section>
    </StaggerItem>

    {page.whyMe.cards.map((card) => (
      <StaggerItem>
        <article class="h-full rounded-[2rem] border border-blush-100 bg-white p-8 shadow-sm">
          <h3 class="font-heading text-3xl text-charcoal">{card.title}</h3>
          <RichText text={card.text} class="mt-4 text-sm leading-7 text-warm-gray" />
        </article>
      </StaggerItem>
    ))}
  </StaggerContainer>
</BaseLayout>
