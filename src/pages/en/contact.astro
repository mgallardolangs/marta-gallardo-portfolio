---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../components/ScrollReveal';
import PageTransition from '../../components/PageTransition';
import { getLangFromUrl, t } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);

const fieldClass =
  'w-full rounded-2xl border border-blush-100 bg-cream px-4 py-3 font-body text-base text-charcoal outline-none transition focus:border-blush-200 focus:ring-2 focus:ring-blush-100/80';
const labelClass = 'mb-2 block font-body text-sm tracking-wide text-warm-gray';
const cardClass = 'rounded-[2rem] border border-blush-100 p-6 shadow-sm md:p-8';
---

<BaseLayout title={`${i.contact.title} — ${i.hero.name}`} description={i.contact.subtitle}>
  <PageTransition client:load>
    <section class="bg-cream pt-24 text-charcoal">
      <div class="mx-auto max-w-6xl px-6 py-12 md:py-16">
        <ScrollReveal client:visible>
          <div class="mx-auto max-w-3xl text-center">
            <p class="font-accent text-sm uppercase tracking-[0.35em] text-rose-gold">{i.contact.eyebrow}</p>
            <h1 class="mt-4 font-heading text-4xl font-semibold tracking-tight md:text-6xl">{i.contact.title}</h1>
            <p class="mt-4 font-body text-lg leading-relaxed text-warm-gray md:text-xl">{i.contact.subtitle}</p>
          </div>
        </ScrollReveal>

        <div class="mt-12 grid gap-8 lg:grid-cols-2">
          <ScrollReveal client:visible className="h-full">
            <div class={`${cardClass} h-full bg-blush-50`}>
              <div class="mb-6 inline-flex rounded-full bg-blush-100 px-4 py-2 font-accent text-sm tracking-[0.2em] text-rose-gold">
                UGC
              </div>
              <h2 class="font-heading text-3xl font-semibold text-charcoal">{i.contact.ugcForm.title}</h2>

              <form name="ugc-contact" method="POST" data-netlify="true" data-error-msg={i.contact.errorRequired} class="contact-form mt-8 space-y-5">
                <input type="hidden" name="form-name" value="ugc-contact" />

                <div>
                  <label for="ugc-company" class={labelClass}>{i.contact.ugcForm.company}</label>
                  <input id="ugc-company" name="Company" type="text" required class={fieldClass} />
                </div>

                <div>
                  <label for="ugc-email" class={labelClass}>{i.contact.ugcForm.email}</label>
                  <input id="ugc-email" name="Email" type="email" required class={fieldClass} />
                </div>

                <div>
                  <label for="ugc-budget" class={labelClass}>{i.contact.ugcForm.budget}</label>
                  <input id="ugc-budget" name="Budget" type="text" required class={fieldClass} />
                </div>

                <div>
                  <label for="ugc-description" class={labelClass}>{i.contact.ugcForm.description}</label>
                  <textarea id="ugc-description" name="Project Description" rows="6" required class={`${fieldClass} resize-y`}></textarea>
                </div>

                <button
                  type="submit"
                  class="inline-flex w-full items-center justify-center rounded-full bg-rose-gold px-6 py-3 font-body text-sm font-semibold uppercase tracking-[0.2em] text-cream transition hover:bg-blush-200 hover:text-charcoal"
                >
                  {i.contact.send}
                </button>
              </form>

              <!-- Success message (hidden by default) -->
              <div class="contact-success hidden mt-8 rounded-2xl border border-green-200 bg-green-50 p-6 text-center">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-green-100">
                  <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="font-heading text-2xl text-charcoal">{i.contact.successTitle}</p>
                <p class="mt-2 font-body text-sm text-warm-gray">{i.contact.successMessage}</p>
              </div>
            </div>
          </ScrollReveal>

          <ScrollReveal client:visible className="h-full" delay={0.15}>
            <div class={`${cardClass} h-full bg-blush-100/70`}>
              <div class="mb-6 inline-flex rounded-full bg-cream px-4 py-2 font-accent text-sm tracking-[0.2em] text-rose-gold">
                {i.contact.seoForm.title}
              </div>
              <h2 class="font-heading text-3xl font-semibold text-charcoal">{i.contact.seoForm.title}</h2>

              <form name="seo-contact" method="POST" data-netlify="true" data-error-msg={i.contact.errorRequired} class="contact-form mt-8 space-y-5">
                <input type="hidden" name="form-name" value="seo-contact" />

                <div>
                  <label for="seo-company" class={labelClass}>{i.contact.seoForm.company}</label>
                  <input id="seo-company" name="Company" type="text" required class={fieldClass} />
                </div>

                <div>
                  <label for="seo-email" class={labelClass}>{i.contact.seoForm.email}</label>
                  <input id="seo-email" name="Email" type="email" required class={fieldClass} />
                </div>

                <div>
                  <label for="seo-budget" class={labelClass}>{i.contact.seoForm.budget}</label>
                  <input id="seo-budget" name="Budget" type="text" required class={fieldClass} />
                </div>

                <div>
                  <label for="seo-description" class={labelClass}>{i.contact.seoForm.description}</label>
                  <textarea id="seo-description" name="Work Description" rows="6" required class={`${fieldClass} resize-y`}></textarea>
                </div>

                <button
                  type="submit"
                  class="inline-flex w-full items-center justify-center rounded-full border border-blush-200 bg-cream px-6 py-3 font-body text-sm font-semibold uppercase tracking-[0.2em] text-rose-gold transition hover:bg-blush-200 hover:text-charcoal"
                >
                  {i.contact.send}
                </button>
              </form>

              <!-- Success message (hidden by default) -->
              <div class="contact-success hidden mt-8 rounded-2xl border border-green-200 bg-green-50 p-6 text-center">
                <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-green-100">
                  <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="font-heading text-2xl text-charcoal">{i.contact.successTitle}</p>
                <p class="mt-2 font-body text-sm text-warm-gray">{i.contact.successMessage}</p>
              </div>
            </div>
          </ScrollReveal>
        </div>
      </div>
    </section>
  </PageTransition>
</BaseLayout>

<script>
  // Set localized validation messages on required fields
  document.querySelectorAll('.contact-form').forEach(form => {
    const errorMsg = form.getAttribute('data-error-msg') || '';
    if (errorMsg) {
      form.querySelectorAll('[required]').forEach(input => {
        (input as HTMLInputElement).setCustomValidity('');
        input.addEventListener('invalid', () => {
          (input as HTMLInputElement).setCustomValidity(errorMsg);
        });
        input.addEventListener('input', () => {
          (input as HTMLInputElement).setCustomValidity('');
        });
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formEl = e.target as HTMLFormElement;
      if (!formEl.checkValidity()) {
        formEl.reportValidity();
        return;
      }
      const data = new FormData(formEl);

      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });
        formEl.classList.add('hidden');
        const success = formEl.parentElement?.querySelector('.contact-success');
        success?.classList.remove('hidden');
      } catch {
        formEl.submit();
      }
    });
  });
</script>
