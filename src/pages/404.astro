---
import '../styles/global.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#FBF4EF" />
    <title>404 — Página no encontrada | Marttelier</title>
    <meta
      name="description"
      content="La página que buscas no está disponible. Vuelve al inicio de Marttelier."
    />
  </head>
  <body class="min-h-screen bg-cream text-charcoal">
    <main class="site-container flex min-h-screen flex-col justify-between py-8 sm:py-12">
      <a
        href="/"
        class="inline-flex w-fit items-center gap-3 text-sm font-semibold tracking-[0.3em] transition hover:text-hazel focus-visible:text-hazel"
        aria-label="Marttelier — volver al inicio"
      >
        <span class="font-heading text-lg">MG</span>
        <span aria-hidden="true" class="h-px w-8 bg-amaranth"></span>
        <span class="text-[0.65rem] font-medium tracking-[0.2em] text-warm-gray">MARTTELIER</span>
      </a>

      <section class="grid flex-1 content-center py-20" aria-labelledby="not-found-title">
        <p class="mb-6 text-xs font-semibold uppercase tracking-[0.24em] text-hazel">Error 404</p>
        <h1
          id="not-found-title"
          class="max-w-4xl font-heading text-5xl font-medium leading-[0.98] tracking-[-0.06em] sm:text-7xl md:text-8xl"
        >
          Esta página<br />
          <span class="font-accent font-normal italic text-hazel">no está aquí.</span>
        </h1>
        <p class="mt-8 max-w-lg text-base leading-7 text-warm-gray sm:text-lg">
          Puede que el enlace esté desactualizado o que la página haya cambiado de dirección.
        </p>
        <a
          href="/"
          class="mt-10 inline-flex w-fit items-center gap-4 rounded-full border border-charcoal px-6 py-3 text-sm font-medium transition hover:border-amaranth hover:bg-amaranth hover:text-ink focus-visible:border-amaranth focus-visible:bg-amaranth focus-visible:text-white"
        >
          Volver al inicio
          <span aria-hidden="true">↗</span>
        </a>
      </section>

      <p class="border-t border-charcoal/10 pt-5 text-xs tracking-[0.16em] text-warm-gray">
        MARTTELIER <span class="px-2 text-hazel">·</span> SEO, traducción y contenido
      </p>
    </main>
  </body>
</html>
