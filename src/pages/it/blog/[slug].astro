---
import { getCollection, render } from 'astro:content';
import BlogArticleLayout from '../../../components/BlogArticleLayout.astro';
import { getBlogAlternateLinksForPost, getBlogStaticPathsForLocale } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return getBlogStaticPathsForLocale(posts, 'it');
}

const { post } = Astro.props;
const posts = await getCollection('blog');
const { Content, headings } = await render(post);
const blogAlternateLinks = getBlogAlternateLinksForPost(posts, post);
---
<BlogArticleLayout post={post} posts={posts} headings={headings} alternateLinks={blogAlternateLinks}>
  <Content />
</BlogArticleLayout>
