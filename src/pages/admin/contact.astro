---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditableText from '../../components/admin/EditableText';
import { getLangFromUrl, t } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);

const fieldClass =
  'w-full border-b border-paper/22 bg-transparent px-0 py-3 font-body text-base text-paper outline-none transition placeholder:text-paper/42 focus:border-amaranth';
const labelClass = 'flex items-center justify-between gap-4 border-b border-paper/10 pb-2 font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-paper';
const hintClass = 'text-[0.62rem] tracking-[0.18em] text-paper/52';
const tabClass = 'inline-flex items-center border-b border-transparent px-0 pb-3 font-body text-[0.72rem] font-semibold uppercase tracking-[0.28em] transition';
const panelClass = 'pt-8';
const successClass = 'contact-success hidden border-t border-paper/14 pt-8 text-paper';
---

<AdminLayout title={`Admin — ${i.contact.title}`} description={i.contact.subtitle}>
  <section data-contact-hero class="bg-paper px-6 pb-14 pt-28 text-ink md:pb-18 md:pt-32">
    <div class="site-container max-w-5xl space-y-6">
      <EditableText client:load i18nKey="contact.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-amaranth" />
      <EditableText client:load i18nKey="contact.title" as="h1" className="max-w-[10ch] font-heading text-5xl leading-[0.92] tracking-[-0.04em] text-ink md:text-7xl" />
      <EditableText client:load i18nKey="contact.subtitle" as="div" className="max-w-3xl font-body text-sm leading-7 tracking-[0.12em] text-ink/72 uppercase md:text-base" />
    </div>
  </section>

  <section data-contact-desk class="bg-ink px-6 py-14 text-paper md:py-18">
    <div class="site-container border border-paper/14 px-6 py-8 md:px-8 md:py-10">
      <div class="border-b border-paper/14 pb-6">
        <div data-contact-tablist role="tablist" aria-label={i.contact.title} class="flex flex-wrap items-start justify-start gap-6 md:gap-8">
          <div class="group/edit relative">
            <button
              type="button"
              id="contact-tab-ugc"
              data-contact-tab="ugc"
              role="tab"
              aria-controls="contact-panel-ugc"
              aria-selected="true"
              tabindex="0"
              class={`${tabClass} contact-tab`}
            >
              <EditableText client:load i18nKey="contact.tabs.ugc" as="span" className="" clickToEdit={false} editButtonTargetId="admin-contact-ugc-tab-edit" />
            </button>
            <span id="admin-contact-ugc-tab-edit" />
          </div>
          <div class="group/edit relative">
            <button
              type="button"
              id="contact-tab-seo"
              data-contact-tab="seo"
              role="tab"
              aria-controls="contact-panel-seo"
              aria-selected="false"
              tabindex="-1"
              class={`${tabClass} contact-tab`}
            >
              <EditableText client:load i18nKey="contact.tabs.seo" as="span" className="" clickToEdit={false} editButtonTargetId="admin-contact-seo-tab-edit" />
            </button>
            <span id="admin-contact-seo-tab-edit" />
          </div>
        </div>
      </div>

      <div class="mt-8 space-y-8">
        <section data-contact-panel="ugc" id="contact-panel-ugc" role="tabpanel" aria-labelledby="contact-tab-ugc" class={panelClass}>
          <form name="ugc-contact" method="POST" data-netlify="true" data-error-msg={i.contact.errorRequired} class="contact-form space-y-6">
            <input type="hidden" name="form-name" value="ugc-contact" />

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="ugc-email" class={labelClass}><EditableText client:load i18nKey="contact.fields.email" as="span" className="" /></label>
                <input id="ugc-email" name="Email" type="email" required class={fieldClass} />
              </div>

              <div>
                <label for="ugc-company" class={labelClass}>
                  <EditableText client:load i18nKey="contact.fields.company" as="span" className="" />
                  <EditableText client:load i18nKey="contact.companyOptional" as="span" className={hintClass} />
                </label>
                <input id="ugc-company" name="Company" type="text" class={fieldClass} />
              </div>
            </div>

            <div>
              <label for="ugc-details" class={labelClass}><EditableText client:load i18nKey="contact.fields.ugcDetails" as="span" className="" /></label>
              <textarea id="ugc-details" name="Project Description" rows="6" required class={`${fieldClass} min-h-[10rem] resize-y`}></textarea>
            </div>

            <div class="flex flex-col gap-4 border-t border-paper/14 pt-6 md:flex-row md:items-end md:justify-between">
              <EditableText client:load i18nKey="contact.responseNote" as="p" className="max-w-xl font-body text-[0.68rem] uppercase tracking-[0.22em] text-paper/58" />
              <div class="group/edit relative">
                <button
                  type="submit"
                  class="inline-flex items-center justify-center border border-amaranth bg-amaranth px-6 py-3 font-body text-xs font-semibold uppercase tracking-[0.26em] text-ink transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_0_var(--color-paper)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_4px_0_var(--color-paper)] focus-visible:outline-none"
                >
                  <EditableText client:load i18nKey="contact.send" as="span" className="" clickToEdit={false} editButtonTargetId="admin-contact-ugc-submit-edit" />
                </button>
                <span id="admin-contact-ugc-submit-edit" />
              </div>
            </div>
          </form>

          <div data-contact-success="ugc" role="status" aria-live="polite" tabindex="-1" class={successClass}>
            <div class="space-y-4">
              <span class="block h-px w-16 bg-amaranth"></span>
              <EditableText client:load i18nKey="contact.response.title" as="p" className="font-heading text-3xl text-paper md:text-4xl" />
              <EditableText client:load i18nKey="contact.response.message" as="p" className="max-w-2xl font-body text-sm leading-7 text-paper/72" />
            </div>
          </div>
        </section>

        <section data-contact-panel="seo" id="contact-panel-seo" role="tabpanel" aria-labelledby="contact-tab-seo" class={panelClass} hidden>
          <form name="seo-contact" method="POST" data-netlify="true" data-error-msg={i.contact.errorRequired} class="contact-form space-y-6">
            <input type="hidden" name="form-name" value="seo-contact" />

            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="seo-email" class={labelClass}><EditableText client:load i18nKey="contact.fields.email" as="span" className="" /></label>
                <input id="seo-email" name="Email" type="email" required class={fieldClass} />
              </div>

              <div>
                <label for="seo-company" class={labelClass}>
                  <EditableText client:load i18nKey="contact.fields.company" as="span" className="" />
                  <EditableText client:load i18nKey="contact.companyOptional" as="span" className={hintClass} />
                </label>
                <input id="seo-company" name="Company" type="text" class={fieldClass} />
              </div>
            </div>

            <div>
              <label for="seo-details" class={labelClass}><EditableText client:load i18nKey="contact.fields.seoDetails" as="span" className="" /></label>
              <textarea id="seo-details" name="Work Description" rows="6" required class={`${fieldClass} min-h-[10rem] resize-y`}></textarea>
            </div>

            <div class="flex flex-col gap-4 border-t border-paper/14 pt-6 md:flex-row md:items-end md:justify-between">
              <EditableText client:load i18nKey="contact.responseNote" as="p" className="max-w-xl font-body text-[0.68rem] uppercase tracking-[0.22em] text-paper/58" />
              <div class="group/edit relative">
                <button
                  type="submit"
                  class="inline-flex items-center justify-center border border-amaranth bg-amaranth px-6 py-3 font-body text-xs font-semibold uppercase tracking-[0.26em] text-ink transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_4px_0_var(--color-paper)] focus-visible:-translate-y-0.5 focus-visible:shadow-[0_4px_0_var(--color-paper)] focus-visible:outline-none"
                >
                  <EditableText client:load i18nKey="contact.send" as="span" className="" clickToEdit={false} editButtonTargetId="admin-contact-seo-submit-edit" />
                </button>
                <span id="admin-contact-seo-submit-edit" />
              </div>
            </div>
          </form>

          <div data-contact-success="seo" role="status" aria-live="polite" tabindex="-1" class={successClass}>
            <div class="space-y-4">
              <span class="block h-px w-16 bg-amaranth"></span>
              <EditableText client:load i18nKey="contact.response.title" as="p" className="font-heading text-3xl text-paper md:text-4xl" />
              <EditableText client:load i18nKey="contact.response.message" as="p" className="max-w-2xl font-body text-sm leading-7 text-paper/72" />
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  import { initContactForms, initContactInquirySwitcher } from '../../lib/contactForms.js';
  import { cleanupContactForms, cleanupContactInquirySwitcher } from '../../lib/contactForms.js';

  const initContactPage = () => {
    initContactInquirySwitcher();
    initContactForms();
  };
  const cleanupContactPage = () => {
    cleanupContactInquirySwitcher();
    cleanupContactForms();
  };
  const handlerKey = '__mgAdminInitContactPage';
  const cleanupHandlerKey = '__mgAdminCleanupContactPage';
  const docWithHandler = document as Document & Record<string, (() => void) | undefined>;

  docWithHandler[handlerKey] && document.removeEventListener('astro:page-load', docWithHandler[handlerKey]);
  docWithHandler[cleanupHandlerKey]
    && document.removeEventListener('astro:before-preparation', docWithHandler[cleanupHandlerKey]);
  docWithHandler[handlerKey] = initContactPage;
  docWithHandler[cleanupHandlerKey] = cleanupContactPage;

  initContactPage();
  document.addEventListener('astro:page-load', initContactPage);
  document.addEventListener('astro:before-preparation', cleanupContactPage);
</script>
