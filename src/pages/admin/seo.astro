---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditableText from '../../components/admin/EditableText';
import AdminTranslationArsenalEditor from '../../components/admin/AdminTranslationArsenalEditor';
import ScrollReveal from '../../components/ScrollReveal';
import { getLangFromUrl, t } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.seoPage;
---

<AdminLayout title={`Admin — ${page.hero.title}`} description={page.hero.paragraphs.join(' ')}>
  <div class="bg-paper" data-admin-seo-page>
    <section class="px-6 pb-16 pt-28 md:pb-20 md:pt-32">
      <div class="site-container max-w-7xl">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
          <EditableText client:load i18nKey="seoPage.hero.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-hazel" />
          <EditableText client:load i18nKey="seoPage.hero.title" as="h1" className="max-w-[16ch] font-heading text-5xl leading-[0.96] tracking-[-0.04em] text-ink md:text-7xl" />
          {page.hero.paragraphs.map((_paragraph, index) => (
            <EditableText client:load i18nKey={`seoPage.hero.paragraphs.${index}`} as="div" className="max-w-5xl font-body text-base leading-8 text-ink-muted md:text-lg" />
          ))}
          <div class="site-text-cta-row">
            <a href="/admin/contact" class="site-text-cta">
              {i.footer.cta}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <EditableText client:load i18nKey="seoPage.services.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="seoPage.services.title" as="h2" className="font-heading text-4xl text-paper md:text-5xl" />
        </div>
        <div class="grid gap-8 border-t border-paper/18 pt-8 md:grid-cols-3">
          {page.services.items.map((_service, index) => (
            <article class="space-y-5 border-b border-paper/18 pb-6 last:border-b-0 md:border-b-0 md:border-r md:pr-6">
              <EditableText client:load i18nKey={`seoPage.services.items.${index}.title`} as="h3" className="font-heading text-2xl leading-tight text-paper md:text-3xl" />
              <EditableText client:load i18nKey={`seoPage.services.items.${index}.description`} as="div" className="text-base leading-8 text-paper/74" />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20">
      <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="seoPage.international.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel" />
          <EditableText client:load i18nKey="seoPage.international.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-5xl" />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="seoPage.international.description" as="div" className="max-w-3xl font-body text-base leading-8 text-ink-muted md:text-lg" />
          <div class="site-text-cta-row">
            <a href="/admin/translation-seo" class="site-text-cta">
              {page.international.translationLinkLabel}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="max-w-4xl space-y-5">
          <EditableText client:load i18nKey="seoPage.why.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="seoPage.why.title" as="h2" className="font-heading text-4xl leading-none text-paper md:text-5xl" />
          <EditableText client:load i18nKey="seoPage.why.description" as="div" className="font-body text-base leading-8 text-paper/72 md:text-lg" />
        </div>
        <div id="admin-seo-arsenal" class="space-y-6 border-t border-paper/18 pt-8">
          <AdminTranslationArsenalEditor client:load scope="seo" />
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20">
      <div class="site-container space-y-8">
<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:items-center lg:gap-16">
          <div class="max-w-3xl space-y-6">
          <EditableText client:load i18nKey="seoPage.budget.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel" />
          <EditableText client:load i18nKey="seoPage.budget.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-5xl" />
          <EditableText client:load i18nKey="seoPage.budget.description" as="div" className="font-body text-base leading-8 text-ink-muted md:text-lg" />
          </div>
          <aside class="seo-budget-highlight space-y-4">
            <EditableText client:load i18nKey="seoPage.budget.highlightTitle" as="h3" className="font-heading text-2xl leading-tight text-ink md:text-3xl" />
            <EditableText client:load i18nKey="seoPage.budget.highlight" as="div" className="font-body text-base leading-8 text-ink" />
          </aside>
        </div>
        <div class="site-text-cta-row">
          <a href="/admin/contact" class="site-text-cta">
            {i.footer.cta}
            <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
