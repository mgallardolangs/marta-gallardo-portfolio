---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ScrollReveal from '../../components/ScrollReveal';
import ParallaxLayer from '../../components/ParallaxLayer';
import FloatingIcon from '../../components/FloatingIcon';
import { ArrowWavy } from '../../components/DoodleArrows';
import StaggerContainer, { StaggerItem } from '../../components/StaggerContainer';
import { getLangFromUrl, t } from '../../i18n';
import EditableText from '../../components/admin/EditableText';
import EditableImage from '../../components/admin/EditableImage';
import AdminBrandVideo from '../../components/admin/AdminBrandVideo';
import AdminOrbitPreview from '../../components/admin/AdminOrbitPreview';
import EditableOrbitCollection from '../../components/admin/EditableOrbitCollection';
import HomeHeroAbstractVisual from '../../components/HomeHeroAbstractVisual.astro';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
---
<AdminLayout title={`Admin — ${i.hero.name}`} description={i.home.hero.description}>
    <div class="overflow-x-hidden bg-paper">
      <!-- admin-home-hero:start -->
      <section data-admin-home-hero class="home-hero bg-paper px-6 pt-20 pb-16 md:pt-24 md:pb-20">
        <div class="site-container home-hero__stage">
          <div class="home-hero__copy">
            <StaggerContainer client:visible className="space-y-6 md:space-y-8" staggerDelay={0.1}>
              <div class="home-hero__clip">
                <StaggerItem>
                  <EditableText client:load i18nKey="home.hero.kicker" as="p" className="home-hero__kicker" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <EditableText client:load i18nKey="hero.name" as="h1" className="home-hero__title" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <div class="home-hero__meta">
                    <EditableText client:load i18nKey="hero.age" as="span" className="" />
                    <span class="home-hero__separator">✦</span>
                    <EditableText client:load i18nKey="hero.city" as="span" className="" />
                  </div>
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <EditableText client:load i18nKey="home.hero.description" as="div" className="home-hero__description" />
                </StaggerItem>
              </div>

              <div class="home-hero__clip">
                <StaggerItem>
                  <div class="home-hero__actions">
                    <div class="group/edit relative flex w-full">
                      <a href="/admin/ugc" class="home-hero__cta home-hero__cta--primary">
                        <EditableText client:load i18nKey="hero.ugcLabel" as="span" className="home-hero__cta-label" clickToEdit={false} editButtonTargetId="admin-home-ugc-cta-edit" />
                      </a>
                      <span id="admin-home-ugc-cta-edit" />
                    </div>
                    <div class="group/edit relative flex w-full">
                      <a href="/admin/translation-seo" class="home-hero__cta home-hero__cta--primary">
                        <EditableText client:load i18nKey="hero.seoLabel" as="span" className="home-hero__cta-label" clickToEdit={false} editButtonTargetId="admin-home-seo-cta-edit" />
                      </a>
                      <span id="admin-home-seo-cta-edit" />
                    </div>
                  </div>
                </StaggerItem>
              </div>
            </StaggerContainer>
          </div>

          <ScrollReveal client:visible direction="none" className="home-hero__visual-shell">
            <HomeHeroAbstractVisual />
          </ScrollReveal>
        </div>
      </section>
      <!-- admin-home-hero:end -->

      <section data-admin-home-orbit class="home-orbit bg-ink px-6 py-16 text-paper md:py-24">
        <div class="site-container grid gap-8 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)_minmax(0,12rem)] lg:grid-rows-[auto_1fr_auto] lg:items-center xl:grid-cols-[minmax(0,21rem)_minmax(0,1fr)_minmax(0,14rem)]">
          <ScrollReveal client:visible direction="right" className="space-y-4 lg:col-start-1 lg:row-start-1 lg:self-start">
            <EditableText client:load i18nKey="home.orbit.kicker" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
            <EditableText client:load i18nKey="home.orbit.title" as="h2" className="max-w-[8ch] font-heading text-[2.8rem] leading-[0.9] tracking-[-0.08em] text-paper md:text-[4.25rem] xl:text-[5.5rem]" />
          </ScrollReveal>

          <ScrollReveal client:visible direction="left" className="order-3 lg:col-start-1 lg:row-start-3 lg:order-none lg:self-end">
            <EditableText client:load i18nKey="home.orbit.description" as="p" className="max-w-md font-body text-sm leading-7 text-white/74 md:text-base md:leading-8" />
          </ScrollReveal>

          <ScrollReveal client:visible direction="left" className="order-2 lg:col-start-3 lg:row-start-1 lg:order-none lg:justify-self-end lg:self-start">
            <EditableText client:load i18nKey="home.orbit.index" as="p" className="font-body text-[0.72rem] font-semibold uppercase tracking-[0.34em] text-white/60 md:text-xs" />
          </ScrollReveal>

          <div class="order-4 lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:order-none">
            <AdminOrbitPreview client:load lang={lang} />
          </div>
        </div>
      </section>

      <section class="bg-paper px-6 py-20 md:py-24">
        <div class="site-container space-y-12">
          <ScrollReveal client:visible direction="right" className="space-y-6">
            <div class="w-16 border-t border-amaranth"></div>
            <EditableText client:load i18nKey="about.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-6xl" />
            <EditableText client:load i18nKey="home.about.highlight" as="p" className="max-w-md font-body text-xl leading-8 text-ink" />
            <EditableText client:load i18nKey="about.text" as="div" className="max-w-3xl font-body text-lg leading-8 text-ink-muted md:text-xl" />
          </ScrollReveal>

          <ScrollReveal client:visible>
            <div class="border-t border-black/10 pt-8">
              <EditableText client:load i18nKey="home.about.languagesLabel" as="p" className="mb-4 font-body text-xs font-semibold uppercase tracking-[0.3em] text-amaranth" />
              <div class="flex flex-wrap gap-3">
                {i.home.about.languages.map((language, idx) => (
                  <EditableText client:load i18nKey={`home.about.languages.${idx}`} as="span" className="border border-black/10 bg-paper px-4 py-2 text-sm text-ink" />
                ))}
              </div>
            </div>
          </ScrollReveal>

          <div class="border-t border-black/10 pt-10">
            <EditableOrbitCollection client:load />
          </div>
        </div>
      </section>

      <section class="bg-ink px-6 py-20 text-paper md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="relative min-h-[32rem] border border-white/10 bg-white/5 p-5 md:min-h-[38rem] md:p-8">
            <ParallaxLayer client:visible speed={-0.18} className="absolute -left-2 top-8 z-20 md:-left-8 md:top-12">
              <FloatingIcon client:visible intensity={10}>
                <div class="h-28 w-28 overflow-hidden border border-white/12 bg-paper shadow-[0_18px_40px_rgb(6_4_3_/_0.24)] md:h-36 md:w-36">
                  <EditableImage client:load imageKey="videoStickers.one" className="h-full w-full" alt="Sticker 1" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.22} className="absolute right-0 top-0 z-20 md:right-4">
              <FloatingIcon client:visible intensity={12}>
                <div class="h-24 w-32 overflow-hidden border border-white/12 bg-white shadow-[0_18px_40px_rgb(6_4_3_/_0.24)] md:h-28 md:w-40">
                  <EditableImage client:load imageKey="videoStickers.two" className="h-full w-full" alt="Sticker 2" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={-0.12} className="absolute -bottom-4 left-6 z-20 md:bottom-8 md:left-10">
              <FloatingIcon client:visible intensity={14}>
                <div class="h-28 w-40 overflow-hidden border border-white/12 bg-white shadow-[0_18px_40px_rgb(6_4_3_/_0.24)] md:h-32 md:w-44">
                  <EditableImage client:load imageKey="videoStickers.three" className="h-full w-full" alt="Sticker 3" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.18} className="absolute bottom-14 right-2 z-20 md:right-0">
              <FloatingIcon client:visible intensity={11}>
                <div class="h-20 w-28 overflow-hidden border border-white/12 bg-amaranth shadow-[0_18px_40px_rgb(6_4_3_/_0.24)] md:h-24 md:w-36">
                  <EditableImage client:load imageKey="videoStickers.four" className="h-full w-full" alt="Sticker 4" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ScrollReveal client:visible direction="up" className="relative mx-auto flex aspect-[9/16] w-full max-w-[22rem] items-center justify-center overflow-hidden border border-white/12 bg-white/8">
              <AdminBrandVideo client:load />
              <div class="absolute left-1/2 top-4 h-1.5 w-24 -translate-x-1/2 rounded-full bg-white/20 pointer-events-none"></div>
              <ArrowWavy client:visible className="absolute bottom-8 right-8 hidden w-24 text-amaranth md:block" />
            </ScrollReveal>
          </div>

          <ScrollReveal client:visible direction="right" className="space-y-6">
            <EditableText client:load i18nKey="home.video.eyebrow" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.36em] text-amaranth" />
            <EditableText client:load i18nKey="home.video.title" as="h2" className="font-heading text-4xl leading-none text-paper md:text-6xl" />
            <EditableText client:load i18nKey="home.video.description" as="div" className="max-w-xl font-body text-lg leading-8 text-white/74 md:text-xl" />
            <div class="mt-6 overflow-hidden border border-white/10">
              <EditableImage client:load imageKey="instagramScreenshot" className="w-full" alt="Instagram" />
            </div>
          </ScrollReveal>
        </div>
      </section>
    </div>
</AdminLayout>
