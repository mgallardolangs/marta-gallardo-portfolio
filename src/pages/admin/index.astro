---
import { getCollection } from 'astro:content';
import AdminLayout from '../../layouts/AdminLayout.astro';
import ScrollReveal from '../../components/ScrollReveal';
import TypedTitle from '../../components/TypedTitle.astro';
import StaggerContainer, { StaggerItem } from '../../components/StaggerContainer';
import HomeHeroPortrait from '../../components/HomeHeroPortrait.astro';
import EditableText from '../../components/admin/EditableText';
import EditableImage from '../../components/admin/EditableImage';
import AdminOrbitPreview from '../../components/admin/AdminOrbitPreview';
import EditableOrbitCollection from '../../components/admin/EditableOrbitCollection';
import EditableSeoSettings from '../../components/admin/EditableSeoSettings';
import { getLangFromUrl, getLocalizedPath, t } from '../../i18n';
import { getLatestAndArchive, scopeBlogPostsToLocale } from '../../lib/blog';
import { netlifyImage } from '../../lib/netlifyImage';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const localizedPosts = scopeBlogPostsToLocale(await getCollection('blog'), lang);
const { latest, archive } = getLatestAndArchive(localizedPosts);
const latestPosts = latest ? [latest, ...archive].slice(0, 3) : archive.slice(0, 3);
const homeServices = [
  { route: '/admin/seo', titleKey: 'home.services.items.seo', title: i.home.services.items.seo },
  { route: '/admin/translation-seo', titleKey: 'home.services.items.translation', title: i.home.services.items.translation },
  { route: '/admin/ugc', titleKey: 'home.services.items.ugc', title: i.home.services.items.ugc },
];
---

<AdminLayout title={`Admin — ${i.nav.home}`} description={i.home.hero.description}>
  <div class="overflow-x-hidden bg-paper">
    <!-- admin-home-hero:start -->
    <section data-admin-home-hero class="home-hero bg-paper px-6 pt-20 pb-16 md:pt-24 md:pb-20">
      <div class="site-container home-hero__stage">
        <div class="home-hero__copy">
          <StaggerContainer client:visible className="flex flex-col gap-8 md:gap-10" staggerDelay={0.1}>
            <div class="home-hero__clip">
              <StaggerItem>
                <EditableText client:load i18nKey="home.hero.kicker" as="p" className="home-hero__kicker" />
              </StaggerItem>
            </div>
            <div class="home-hero__clip">
              <StaggerItem>
                <EditableText client:load i18nKey="home.hero.title" as="h1" className="home-hero__title" />
              </StaggerItem>
            </div>
            <div class="home-hero__clip">
              <StaggerItem>
                <EditableText client:load i18nKey="home.hero.description" as="div" className="home-hero__description" />
              </StaggerItem>
            </div>
            <div class="home-hero__clip">
              <StaggerItem>
                <div class="home-hero__actions">
                  <div class="group/edit relative flex w-full">
                    <a href="/admin/contact" class="home-hero__cta home-hero__cta--primary">
                      <EditableText client:load i18nKey="home.hero.ctaDiagnosis" as="span" className="home-hero__cta-label" clickToEdit={false} editButtonTargetId="admin-home-diagnosis-cta-edit" />
                    </a>
                    <span id="admin-home-diagnosis-cta-edit" />
                  </div>
                  <div class="group/edit relative flex w-full">
                    <a href="#home-services" class="home-hero__cta home-hero__cta--secondary">
                      <EditableText client:load i18nKey="home.hero.ctaServices" as="span" className="home-hero__cta-label" clickToEdit={false} editButtonTargetId="admin-home-services-cta-edit" />
                    </a>
                    <span id="admin-home-services-cta-edit" />
                  </div>
                </div>
              </StaggerItem>
            </div>
          </StaggerContainer>
        </div>
        <ScrollReveal client:visible direction="none" className="home-hero__portrait-shell">
          <HomeHeroPortrait>
            <EditableImage client:load imageKey="heroMainPhoto" className="h-full w-full" alt={i.hero.name} />
          </HomeHeroPortrait>
        </ScrollReveal>
      </div>
    </section>
    <!-- admin-home-hero:end -->

    <section id="home-services" data-admin-home-services class="scroll-mt-24 bg-ink px-6 py-16 text-paper md:scroll-mt-28 md:py-20">
      <div class="site-container space-y-10">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-5 md:gap-6">
          <EditableText client:load i18nKey="nav.services" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
          <EditableText client:load i18nKey="home.services.title" as="h2" className="font-heading text-4xl leading-none text-paper md:text-6xl" />
        </ScrollReveal>
        <div class="border-t border-paper/18">
          {homeServices.map((service, index) => (
            <a
              href={service.route}
              class="group flex items-center justify-between gap-5 border-b border-paper/18 py-5 transition-colors hover:text-amaranth focus-visible:text-amaranth md:py-7"
            >
              <div class="flex min-w-0 items-center gap-4 md:gap-6">
                <span class="font-body text-[0.68rem] font-semibold tracking-[0.24em] text-amaranth">{`0${index + 1}`}</span>
                <EditableText client:load i18nKey={service.titleKey} as="h3" className="font-heading text-2xl font-normal leading-tight text-paper md:text-4xl" />
              </div>
              <span class="font-body text-xl text-amaranth" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section data-admin-home-orbit class="home-orbit bg-ink px-6 py-16 text-paper md:py-24">
      <div class="site-container grid gap-8 lg:grid-cols-[minmax(0,18rem)_minmax(0,1fr)_minmax(0,12rem)] lg:grid-rows-[auto_1fr_auto] lg:items-center xl:grid-cols-[minmax(0,21rem)_minmax(0,1fr)_minmax(0,14rem)]">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-5 lg:col-start-1 lg:row-start-1 lg:self-start">
          <EditableText client:load i18nKey="home.orbit.kicker" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
          <EditableText client:load i18nKey="home.orbit.title" as="h2" className="max-w-[8ch] font-heading text-[2.8rem] leading-[0.9] tracking-[-0.08em] text-paper md:text-[4.25rem] xl:text-[5.5rem]" />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="order-3 lg:col-start-1 lg:row-start-3 lg:order-none lg:self-end">
          <EditableText client:load i18nKey="home.orbit.note" as="p" className="font-body text-[0.72rem] font-semibold uppercase tracking-[0.34em] text-white/60 md:text-xs" />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="order-2 lg:col-start-3 lg:row-start-1 lg:order-none lg:justify-self-end lg:self-start">
          <EditableText client:load i18nKey="home.orbit.index" as="p" className="font-body text-[0.72rem] font-semibold uppercase tracking-[0.34em] text-white/60 md:text-xs" />
        </ScrollReveal>
        <div class="order-4 lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:order-none">
          <AdminOrbitPreview client:load lang={lang} />
        </div>
      </div>
      <div class="site-container mt-12 border-t border-paper/16 pt-8">
        <EditableOrbitCollection client:load />
      </div>
    </section>

    <section data-admin-home-visibility class="bg-paper px-6 py-20 md:py-24">
      <div class="site-container space-y-14">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
          <div class="w-16 border-t border-amaranth"></div>
          <EditableText client:load i18nKey="home.visibility.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-6xl" />
          <EditableText client:load i18nKey="home.visibility.text" as="div" className="max-w-3xl font-body text-lg leading-8 text-ink-muted md:text-xl" />
        </ScrollReveal>
        <div class="border-t border-ink/10 pt-8">
          <EditableText client:load i18nKey="home.about.languagesLabel" as="p" className="mb-5 font-body text-xs font-semibold uppercase tracking-[0.3em] text-amaranth" />
          <StaggerContainer client:visible className="flex flex-wrap gap-3" staggerDelay={0.08}>
            {i.home.about.languages.map((language, index) => (
              <StaggerItem className="inline-flex">
                <EditableText client:load i18nKey={`home.about.languages.${index}`} as="span" className="border border-ink/10 bg-paper px-4 py-2 text-sm text-ink" />
              </StaggerItem>
            ))}
          </StaggerContainer>
        </div>
      </div>
    </section>

    <section data-admin-home-about class="bg-ink px-6 py-20 text-paper md:py-24">
      <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-7">
          <EditableText client:load i18nKey="nav.about" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
          <EditableText client:load i18nKey="home.about.title" as="h2" className="font-heading text-4xl leading-none text-paper md:text-6xl" />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="flex flex-col gap-8 lg:justify-self-end">
          <EditableText client:load i18nKey="home.about.description" as="div" className="max-w-3xl font-body text-lg leading-8 text-white/76 md:text-xl" />
          <div class="site-text-cta-row">
            <a href="/admin/about" class="site-text-cta">
              <EditableText client:load i18nKey="home.about.cta" as="span" className="" clickToEdit={false} />
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-paper px-6 py-20 md:py-24">
      <div class="site-container space-y-12">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="blog.eyebrow" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
          <EditableText client:load i18nKey="home.latestArticles.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-6xl" />
        </ScrollReveal>
        {latestPosts.length > 0 && (
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {latestPosts.map((post, index) => (
              <article class="group flex h-full flex-col border-t border-ink/20 pt-5">
                <a href={`/admin/blog/edit/${post.data.translationKey}`} class="mb-5 block overflow-hidden border border-ink/10 bg-ink/5">
                  {post.data.image ? (
                    <img
                      src={netlifyImage(post.data.image, { width: 720 })}
                      alt={post.data.title}
                      width={720}
                      height={450}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[16/10] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
                    />
                  ) : (
                    <div class="flex aspect-[16/10] items-center justify-center">
                      <span class="font-body text-xs font-semibold uppercase tracking-[0.28em] text-amaranth">{i.blog.latestStory}</span>
                    </div>
                  )}
                </a>
                <div class="flex flex-1 flex-col gap-5">
                  <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ink-muted">
                    {String(index + 1).padStart(2, '0')} · {post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                  </p>
                  <a href={`/admin/blog/edit/${post.data.translationKey}`} class="transition hover:text-amaranth">
                    <h3 class="font-heading text-2xl leading-tight text-ink md:text-3xl">{post.data.title}</h3>
                  </a>
                  <p class="flex-1 font-body text-sm leading-7 text-ink-muted">{post.data.description}</p>
                </div>
              </article>
            ))}
          </div>
        )}
        <a href="/admin/blog" class="inline-flex items-center gap-3 border-b border-amaranth pb-2 font-body text-xs font-semibold uppercase tracking-[0.24em] text-ink transition hover:text-amaranth focus-visible:text-amaranth">
          {i.blog.title}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="bg-paper px-6 pb-16">
      <div class="site-container border border-ink/10 bg-white/85 p-4 md:p-6">
        <EditableSeoSettings client:load />
      </div>
    </section>
  </div>
</AdminLayout>
