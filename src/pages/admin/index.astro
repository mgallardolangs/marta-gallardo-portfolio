---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageTransition from '../../components/PageTransition';
import ScrollReveal from '../../components/ScrollReveal';
import AnimatedScrollText from '../../components/AnimatedScrollText';
import ParallaxLayer from '../../components/ParallaxLayer';
import FloatingIcon from '../../components/FloatingIcon';
import { ArrowWavy } from '../../components/DoodleArrows';
import StaggerContainer, { StaggerItem } from '../../components/StaggerContainer';
import { getLangFromUrl, getLocalizedPath, t } from '../../i18n';
import EditableText from '../../components/admin/EditableText';
import EditableImage from '../../components/admin/EditableImage';
import AdminStoryMap from '../../components/admin/AdminStoryMap';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
---
<AdminLayout title={`Admin — ${i.hero.name}`} description={i.home.hero.description}>
  <PageTransition client:load>
    <div class="overflow-x-hidden pt-24">
      <section class="relative isolate px-6 pb-24 pt-8 md:pb-32 md:pt-14">
        <div class="absolute inset-x-0 top-8 -z-10 h-72 bg-[radial-gradient(circle_at_top,rgba(242,196,196,0.45),transparent_62%)]"></div>
        <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="space-y-10">
            <ScrollReveal client:visible direction="none">
              <EditableText client:load i18nKey="home.hero.kicker" as="p" className="font-accent text-sm uppercase tracking-[0.38em] text-rose-gold" />
            </ScrollReveal>

            <StaggerContainer client:visible className="space-y-8" staggerDelay={0.12}>
              <StaggerItem>
                <EditableText client:load i18nKey="hero.name" as="h1" className="font-heading text-[4.5rem] leading-[0.82] tracking-[-0.05em] text-charcoal sm:text-[5.5rem] md:text-[7rem] lg:text-[8.75rem]" />
              </StaggerItem>

              <StaggerItem>
                <div class="flex flex-wrap items-center gap-3 text-sm uppercase tracking-[0.28em] text-warm-gray md:text-base">
                  <EditableText client:load i18nKey="hero.age" as="span" className="" />
                  <span class="text-blush-300">✦</span>
                  <EditableText client:load i18nKey="hero.city" as="span" className="" />
                </div>
              </StaggerItem>

              <StaggerItem>
                <EditableText client:load i18nKey="home.hero.description" as="div" className="max-w-xl font-body text-lg leading-8 text-warm-gray md:text-xl" />
              </StaggerItem>
            </StaggerContainer>

            <div class="pt-6 flex justify-center lg:justify-start">
              <AnimatedScrollText client:load text={i.home.hero.scrollCue} className="max-w-xs" />
            </div>
          </div>

          <div class="relative min-h-[36rem] lg:min-h-[42rem]">
            <FloatingIcon client:visible intensity={18} className="absolute inset-0">
              <div class="absolute left-4 top-8 hidden h-28 w-28 rounded-full bg-blush-200/45 blur-3xl md:block"></div>
              <div class="absolute bottom-12 right-0 h-36 w-36 rounded-full bg-blush-100 blur-3xl"></div>
            </FloatingIcon>

            <ScrollReveal client:visible delay={0.1} direction="left" className="absolute inset-x-5 top-6 z-20 md:left-auto md:right-[56%] md:top-[10%] md:w-64">
              <a
                href={getLocalizedPath('/ugc', lang)}
                class="block rounded-[1.6rem] border border-blush-200 bg-white/50 px-4 py-3 shadow-[0_30px_70px_rgba(183,110,121,0.12)] backdrop-blur-sm transition hover:bg-white/65"
              >
                <EditableText client:load i18nKey="hero.ugcLabel" as="p" className="font-heading text-lg leading-tight text-charcoal" />
              </a>
            </ScrollReveal>

            <ScrollReveal client:visible delay={0.2} direction="right" className="absolute bottom-2 left-6 z-20 md:bottom-[8%] md:left-[58%] md:w-72">
              <a
                href={getLocalizedPath('/translation-seo', lang)}
                class="block rounded-[1.6rem] border border-blush-200 bg-white/50 px-4 py-3 shadow-[0_30px_70px_rgba(183,110,121,0.12)] backdrop-blur-sm transition hover:bg-white/65"
              >
                <EditableText client:load i18nKey="hero.seoLabel" as="p" className="font-heading text-lg leading-tight text-charcoal" />
              </a>
            </ScrollReveal>

            <div class="absolute inset-0 flex items-center justify-center">
              <div class="photo-frame relative flex h-[29rem] w-full max-w-[24rem] items-center justify-center overflow-hidden rounded-[2.8rem] border border-blush-200/80 bg-blush-100 shadow-[0_35px_120px_rgba(183,110,121,0.18)] md:h-[35rem] md:max-w-[27rem]">
                <EditableImage client:load imageKey="heroMainPhoto" className="absolute inset-0 h-full w-full rounded-[2.8rem]" alt={i.hero.name} />
                <div class="absolute inset-6 rounded-[2.2rem] border border-white/60 pointer-events-none"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="relative overflow-hidden px-6 pb-24 md:pb-32">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
            <div class="relative" style="height: 36rem;">
              <AdminStoryMap client:load className="absolute inset-0" />
            </div>

            <ScrollReveal client:visible direction="right" className="space-y-6 lg:pl-8 xl:pl-14">
              <EditableText client:load i18nKey="about.title" as="h2" className="font-heading text-5xl leading-none text-charcoal md:text-6xl" />
              <EditableText client:load i18nKey="home.about.highlight" as="p" className="max-w-md font-body text-xl leading-8 text-warm-gray" />
              <EditableText client:load i18nKey="about.text" as="div" className="max-w-2xl font-body text-lg leading-8 text-warm-gray md:text-xl" />
            </ScrollReveal>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            <EditableImage client:load imageKey="galleryCutouts.shotOne" className="aspect-square overflow-hidden rounded-[1.75rem] border border-blush-100 bg-white shadow-sm" alt="Gallery cutout 1" />
            <EditableImage client:load imageKey="galleryCutouts.shotTwo" className="aspect-square overflow-hidden rounded-[1.75rem] border border-blush-100 bg-white shadow-sm" alt="Gallery cutout 2" />
            <EditableImage client:load imageKey="galleryCutouts.shotThree" className="aspect-square overflow-hidden rounded-[1.75rem] border border-blush-100 bg-white shadow-sm" alt="Gallery cutout 3" />
            <EditableImage client:load imageKey="galleryCutouts.shotFour" className="aspect-square overflow-hidden rounded-[1.75rem] border border-blush-100 bg-white shadow-sm" alt="Gallery cutout 4" />
            <EditableImage client:load imageKey="galleryCutouts.shotFive" className="aspect-square overflow-hidden rounded-[1.75rem] border border-blush-100 bg-white shadow-sm" alt="Gallery cutout 5" />
          </div>

          <ScrollReveal client:visible className="mt-12">
            <div class="text-center">
              <p class="mb-4 font-accent text-sm uppercase tracking-[0.3em] text-rose-gold">{i.home.about.languagesLabel}</p>
              <StaggerContainer client:visible className="flex flex-wrap justify-center gap-3" staggerDelay={0.08}>
                {i.home.about.languages.map((language) => (
                  <StaggerItem className="inline-flex">
                    <span class="rounded-full border border-blush-100 bg-blush-50 px-5 py-2.5 text-sm text-charcoal">{language}</span>
                  </StaggerItem>
                ))}
              </StaggerContainer>
            </div>
          </ScrollReveal>
        </div>
      </section>

      <section class="relative px-6 pb-24 md:pb-36">
        <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-center">
          <div class="relative min-h-[32rem] rounded-[2.8rem] border border-blush-100 bg-blush-50/70 p-5 md:min-h-[38rem] md:p-8">
            <ParallaxLayer client:visible speed={-0.18} className="absolute -left-2 top-8 z-20 md:-left-10 md:top-12">
              <FloatingIcon client:visible intensity={10}>
                <div class="cutout-card flex h-28 w-28 items-center justify-center rounded-[1.75rem] border border-blush-200 bg-blush-100 text-center font-accent text-sm uppercase tracking-[0.18em] text-charcoal shadow-[0_18px_40px_rgba(183,110,121,0.12)] md:h-36 md:w-36">
                  {i.home.gallery.shotOne}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.22} className="absolute right-0 top-0 z-20 md:right-6">
              <FloatingIcon client:visible intensity={12}>
                <div class="cutout-card flex h-24 w-32 items-center justify-center rounded-[1.75rem] border border-blush-200 bg-white text-center font-accent text-xs uppercase tracking-[0.2em] text-charcoal shadow-[0_18px_40px_rgba(183,110,121,0.12)] md:h-28 md:w-40">
                  {i.home.gallery.shotTwo}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={-0.12} className="absolute -bottom-4 left-6 z-20 md:bottom-8 md:left-10">
              <FloatingIcon client:visible intensity={14}>
                <div class="cutout-card flex h-28 w-40 items-center justify-center rounded-[1.75rem] border border-blush-200 bg-white text-center font-accent text-xs uppercase tracking-[0.2em] text-charcoal shadow-[0_18px_40px_rgba(183,110,121,0.12)] md:h-32 md:w-44">
                  {i.home.gallery.shotThree}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.18} className="absolute bottom-14 right-2 z-20 md:right-0">
              <FloatingIcon client:visible intensity={11}>
                <div class="cutout-card flex h-20 w-28 items-center justify-center rounded-[1.75rem] border border-blush-200 bg-blush-100 text-center font-accent text-[0.65rem] uppercase tracking-[0.24em] text-charcoal shadow-[0_18px_40px_rgba(183,110,121,0.12)] md:h-24 md:w-36 md:text-xs">
                  {i.home.gallery.shotFour}
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ScrollReveal client:visible direction="up" className="relative mx-auto flex aspect-[9/16] w-full max-w-[22rem] items-center justify-center overflow-hidden rounded-[2.8rem] border border-blush-200 bg-blush-100 shadow-[0_35px_100px_rgba(183,110,121,0.14)]">
              <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(255,255,255,0.52),rgba(255,255,255,0.05))]"></div>
              <div class="absolute left-1/2 top-4 h-1.5 w-24 -translate-x-1/2 rounded-full bg-charcoal/12"></div>
              <div class="absolute inset-x-[22%] top-10 h-24 rounded-full bg-white/45 blur-3xl"></div>
              <div class="relative z-10 max-w-sm text-center">
                <p class="font-accent text-sm uppercase tracking-[0.34em] text-rose-gold">{i.home.video.note}</p>
                <p class="mt-5 font-heading text-4xl text-charcoal md:text-5xl">{i.home.video.placeholder}</p>
              </div>
              <ArrowWavy client:visible className="absolute bottom-8 right-8 hidden w-24 text-rose-gold md:block" />
            </ScrollReveal>
          </div>

          <ScrollReveal client:visible direction="right" className="space-y-6">
            <p class="font-accent text-sm uppercase tracking-[0.36em] text-rose-gold">{i.home.video.eyebrow}</p>
            <EditableText client:load i18nKey="home.video.title" as="h2" className="font-heading text-5xl leading-none text-charcoal md:text-6xl" />
            <EditableText client:load i18nKey="home.video.description" as="div" className="max-w-xl font-body text-lg leading-8 text-warm-gray md:text-xl" />
            <div class="mt-6 overflow-hidden rounded-2xl border border-blush-100 shadow-sm">
              <EditableImage client:load imageKey="instagramScreenshot" className="w-full" alt="Instagram" />
            </div>
          </ScrollReveal>
        </div>
      </section>
    </div>
  </PageTransition>
</AdminLayout>

<style>
  .photo-frame {
    animation: float-sway 7s ease-in-out infinite;
  }

  .cutout-card {
    animation: float-sway 6s ease-in-out infinite;
  }

  @keyframes float-sway {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(-1.5deg);
    }
  }
</style>
