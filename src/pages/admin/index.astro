---
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageTransition from '../../components/PageTransition';
import ScrollReveal from '../../components/ScrollReveal';
import ParallaxLayer from '../../components/ParallaxLayer';
import FloatingIcon from '../../components/FloatingIcon';
import { ArrowWavy } from '../../components/DoodleArrows';
import StaggerContainer, { StaggerItem } from '../../components/StaggerContainer';
import { getLangFromUrl, getLocalizedPath, t } from '../../i18n';
import EditableText from '../../components/admin/EditableText';
import EditableImage from '../../components/admin/EditableImage';
import AdminStoryMap from '../../components/admin/AdminStoryMap';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
---
<AdminLayout title={`Admin — ${i.hero.name}`} description={i.home.hero.description}>
  <PageTransition client:load>
    <div class="overflow-x-hidden bg-paper">
      <section class="relative overflow-hidden border-b border-black/10 bg-paper px-6 pt-28 pb-20 md:pt-32 md:pb-24">
        <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,rgba(232,50,86,0.15),transparent_68%)]"></div>
        <div class="site-container relative grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="space-y-8">
            <ScrollReveal client:visible direction="none">
              <div class="inline-flex items-center gap-4 border-y border-black/12 py-3">
                <EditableText client:load i18nKey="home.hero.kicker" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
              </div>
            </ScrollReveal>

            <StaggerContainer client:visible className="space-y-6" staggerDelay={0.12}>
              <StaggerItem>
                <EditableText client:load i18nKey="hero.name" as="h1" className="max-w-[11ch] font-heading text-[4.25rem] leading-[0.82] tracking-[-0.06em] text-ink sm:text-[5.25rem] md:text-[6.8rem] lg:text-[8.2rem]" />
              </StaggerItem>

              <StaggerItem>
                <div class="flex flex-wrap items-center gap-3 text-sm uppercase tracking-[0.28em] text-ink-muted md:text-base">
                  <EditableText client:load i18nKey="hero.age" as="span" className="" />
                  <span class="text-amaranth-soft">✦</span>
                  <EditableText client:load i18nKey="hero.city" as="span" className="" />
                </div>
              </StaggerItem>

              <StaggerItem>
                <EditableText client:load i18nKey="home.hero.description" as="div" className="max-w-xl font-body text-lg leading-8 text-ink-muted md:text-xl" />
              </StaggerItem>
            </StaggerContainer>

            <div class="pt-4">
              <EditableText client:load i18nKey="home.hero.scrollCue" as="p" className="max-w-xs font-body text-sm uppercase tracking-[0.3em] text-ink-muted" />
            </div>
          </div>

          <div class="relative min-h-[36rem] lg:min-h-[42rem]">
            <FloatingIcon client:visible intensity={18} className="absolute inset-0">
              <div class="absolute left-4 top-8 hidden h-28 w-28 rounded-full bg-amaranth-soft/30 blur-3xl md:block"></div>
              <div class="absolute bottom-12 right-0 h-36 w-36 rounded-full bg-amaranth-mist blur-3xl"></div>
            </FloatingIcon>

            <ScrollReveal client:visible delay={0.1} direction="left" className="absolute inset-x-4 top-8 z-20 md:left-auto md:right-[58%] md:w-64">
              <a href={getLocalizedPath('/ugc', lang)} class="block border border-black/10 bg-white/72 p-4 shadow-[0_18px_40px_rgba(6,4,3,0.08)] backdrop-blur-sm">
                <p class="font-body text-[0.7rem] font-semibold uppercase tracking-[0.3em] text-amaranth">UGC</p>
                <EditableText client:load i18nKey="hero.ugcLabel" as="p" className="mt-3 font-heading text-xl leading-tight text-ink" />
              </a>
            </ScrollReveal>

            <ScrollReveal client:visible delay={0.2} direction="right" className="absolute bottom-6 left-6 z-20 md:bottom-[10%] md:left-[60%] md:w-72">
              <a href={getLocalizedPath('/translation-seo', lang)} class="block border border-black/10 bg-white/72 p-4 shadow-[0_18px_40px_rgba(6,4,3,0.08)] backdrop-blur-sm">
                <p class="font-body text-[0.7rem] font-semibold uppercase tracking-[0.3em] text-amaranth">SEO</p>
                <EditableText client:load i18nKey="hero.seoLabel" as="p" className="mt-3 font-heading text-xl leading-tight text-ink" />
              </a>
            </ScrollReveal>

            <div class="absolute inset-0 flex items-center justify-center">
              <div class="relative flex h-[29rem] w-full max-w-[24rem] items-center justify-center overflow-hidden border border-black/10 bg-blush-50 shadow-[0_28px_90px_rgba(6,4,3,0.12)] md:h-[35rem] md:max-w-[27rem]">
                <EditableImage client:load imageKey="heroMainPhoto" className="absolute inset-0 h-full w-full" alt={i.hero.name} />
                <div class="pointer-events-none absolute inset-5 border border-white/60"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="border-b border-black/10 bg-white px-6 py-20 md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div class="relative min-h-[30rem] border border-black/10 bg-paper p-4 md:min-h-[36rem] md:p-6">
            <AdminStoryMap client:load className="absolute inset-0" />
          </div>

          <ScrollReveal client:visible direction="right" className="space-y-6 lg:pl-8 xl:pl-14">
            <div class="w-16 border-t border-amaranth"></div>
            <EditableText client:load i18nKey="about.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-6xl" />
            <EditableText client:load i18nKey="home.about.highlight" as="p" className="max-w-md font-body text-xl leading-8 text-ink" />
            <EditableText client:load i18nKey="about.text" as="div" className="max-w-2xl font-body text-lg leading-8 text-ink-muted md:text-xl" />
          </ScrollReveal>
        </div>

        <ScrollReveal client:visible className="site-container mt-12">
          <div class="border-t border-black/10 pt-8 text-center">
            <EditableText client:load i18nKey="home.about.languagesLabel" as="p" className="mb-4 font-body text-xs font-semibold uppercase tracking-[0.3em] text-amaranth" />
            <div class="flex flex-wrap justify-center gap-3">
              {i.home.about.languages.map((language, idx) => (
                <EditableText client:load i18nKey={`home.about.languages.${idx}`} as="span" className="border border-black/10 bg-paper px-4 py-2 text-sm text-ink" />
              ))}
            </div>
          </div>
        </ScrollReveal>
      </section>

      <section class="bg-ink px-6 py-20 text-paper md:py-24">
        <div class="site-container grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="relative min-h-[32rem] border border-white/10 bg-white/5 p-5 md:min-h-[38rem] md:p-8">
            <ParallaxLayer client:visible speed={-0.18} className="absolute -left-2 top-8 z-20 md:-left-8 md:top-12">
              <FloatingIcon client:visible intensity={10}>
                <div class="h-28 w-28 overflow-hidden border border-white/12 bg-paper shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-36 md:w-36">
                  <EditableImage client:load imageKey="videoStickers.one" className="h-full w-full" alt="Sticker 1" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.22} className="absolute right-0 top-0 z-20 md:right-4">
              <FloatingIcon client:visible intensity={12}>
                <div class="h-24 w-32 overflow-hidden border border-white/12 bg-white shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-28 md:w-40">
                  <EditableImage client:load imageKey="videoStickers.two" className="h-full w-full" alt="Sticker 2" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={-0.12} className="absolute -bottom-4 left-6 z-20 md:bottom-8 md:left-10">
              <FloatingIcon client:visible intensity={14}>
                <div class="h-28 w-40 overflow-hidden border border-white/12 bg-white shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-32 md:w-44">
                  <EditableImage client:load imageKey="videoStickers.three" className="h-full w-full" alt="Sticker 3" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ParallaxLayer client:visible speed={0.18} className="absolute bottom-14 right-2 z-20 md:right-0">
              <FloatingIcon client:visible intensity={11}>
                <div class="h-20 w-28 overflow-hidden border border-white/12 bg-amaranth shadow-[0_18px_40px_rgba(0,0,0,0.24)] md:h-24 md:w-36">
                  <EditableImage client:load imageKey="videoStickers.four" className="h-full w-full" alt="Sticker 4" />
                </div>
              </FloatingIcon>
            </ParallaxLayer>

            <ScrollReveal client:visible direction="up" className="relative mx-auto flex aspect-[9/16] w-full max-w-[22rem] items-center justify-center overflow-hidden border border-white/12 bg-white/8">
              <EditableImage client:load imageKey="brandVideo" className="absolute inset-0 h-full w-full" alt="Brand video" label="🎬 Change video" />
              <div class="absolute left-1/2 top-4 h-1.5 w-24 -translate-x-1/2 rounded-full bg-white/20 pointer-events-none"></div>
              <ArrowWavy client:visible className="absolute bottom-8 right-8 hidden w-24 text-amaranth-soft md:block" />
            </ScrollReveal>
          </div>

          <ScrollReveal client:visible direction="right" className="space-y-6">
            <EditableText client:load i18nKey="home.video.eyebrow" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.36em] text-amaranth-soft" />
            <EditableText client:load i18nKey="home.video.title" as="h2" className="font-heading text-4xl leading-none text-paper md:text-6xl" />
            <EditableText client:load i18nKey="home.video.description" as="div" className="max-w-xl font-body text-lg leading-8 text-white/74 md:text-xl" />
            <div class="mt-6 overflow-hidden border border-white/10">
              <EditableImage client:load imageKey="instagramScreenshot" className="w-full" alt="Instagram" />
            </div>
          </ScrollReveal>
        </div>
      </section>
    </div>
  </PageTransition>
</AdminLayout>
