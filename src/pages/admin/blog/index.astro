---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, t } from '../../../i18n';
import ScrollReveal from '../../../components/ScrollReveal';
import StaggerContainer, { StaggerItem } from '../../../components/StaggerContainer';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<AdminLayout title={`Admin — ${i.blog.title}`} description={i.blog.title}>
  <div class="pt-24 pb-16 max-w-5xl mx-auto px-6">
        <ScrollReveal client:visible>
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <h1 class="font-heading text-5xl md:text-7xl font-light text-charcoal mb-4">{i.blog.title}</h1>
            <div class="w-20 h-0.5 bg-rose-gold"></div>
          </div>
          <a href="/admin/blog/new" class="inline-flex items-center justify-center rounded-full bg-rose-gold px-6 py-3 text-sm font-semibold uppercase tracking-[0.2em] text-white transition hover:opacity-90">
            New post
          </a>
        </div>
      </ScrollReveal>

      {posts.length === 0 ? (
        <p class="mt-10 text-warm-gray font-body text-lg">No posts yet.</p>
      ) : (
        <StaggerContainer client:visible className="mt-10 grid gap-8" staggerDelay={0.12}>
          {posts.map((post) => (
            <StaggerItem>
              <article class="rounded-[2rem] border border-blush-100 bg-white p-6 shadow-sm md:p-8">
                <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
                  <div>
                    <p class="text-xs uppercase tracking-[0.24em] text-rose-gold">{post.data.lang}</p>
                    <h2 class="mt-2 font-heading text-2xl text-charcoal md:text-3xl">{post.data.title}</h2>
                    <p class="mt-3 text-warm-gray font-body leading-relaxed">{post.data.description}</p>
                  </div>
                  <div class="text-sm text-warm-gray">
                    {post.data.date.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}
                  </div>
                </div>
                <div class="mt-5 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full bg-blush-50 px-3 py-1 text-xs text-rose-gold">{tag}</span>
                  ))}
                </div>
              </article>
            </StaggerItem>
          ))}
        </StaggerContainer>
      )}
    </div>
</AdminLayout>
