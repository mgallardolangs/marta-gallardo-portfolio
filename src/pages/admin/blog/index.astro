---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminBlogList from '../../../components/admin/AdminBlogList';
import { getCollection } from 'astro:content';
import { groupBlogPostsForAdmin } from '../../../lib/blog';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const groups = groupBlogPostsForAdmin(posts).map((group, index) => ({
  translationKey: group.translationKey,
  slug: group.slug,
  date: group.date ? new Date(group.date).toISOString() : '',
  image: group.image,
  position: String(index + 1).padStart(2, '0'),
  locales: Object.fromEntries(
    Object.entries(group.locales).map(([locale, post]) => [
      locale,
      { title: post.data.title, tags: post.data.tags },
    ]),
  ),
}));

const groupsJson = JSON.stringify(groups);
---
<AdminLayout title="Admin · Blog" description="Archivo de posts">
  <section class="mx-auto max-w-5xl px-6 pb-16 pt-28">
    <div class="flex flex-col gap-5 border-b border-black/10 pb-6 md:flex-row md:items-end md:justify-between">
      <div class="space-y-3">
        <p class="font-body text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-ink-faint">Archivo de posts</p>
        <h1 class="font-heading text-5xl leading-none text-ink md:text-7xl">Admin · Blog</h1>
      </div>
      <a href="/admin/blog/new" class="inline-flex items-center justify-center border border-black bg-black px-6 py-3 font-body text-xs font-semibold uppercase tracking-[0.24em] text-paper transition hover:bg-amaranth hover:border-amaranth hover:text-ink">
        + Nuevo post
      </a>
    </div>

    <AdminBlogList client:load initialGroupsJson={groupsJson} />
  </section>
</AdminLayout>
