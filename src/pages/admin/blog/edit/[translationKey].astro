---
import { getCollection } from 'astro:content';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import BlogPostForm from '../../../../components/admin/BlogPostForm';
import { groupBlogPostsForAdmin } from '../../../../lib/blog';
import { getPublicLanguagePicker, siteData } from '../../../../lib/siteData';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const groups = groupBlogPostsForAdmin(posts);

  return groups.map((group) => ({
    params: { translationKey: group.translationKey },
    props: {
      initialPost: {
        translationKey: group.translationKey,
        slug: group.slug,
        date: group.date ? new Date(group.date).toISOString() : '',
        image: group.image,
        translations: Object.fromEntries(
          Object.entries(group.locales).map(([locale, post]) => [
            locale,
            {
              title: post.data.title,
              description: post.data.description,
              tags: post.data.tags,
              body: post.body ?? '',
            },
          ]),
        ),
      },
    },
  }));
}

const { initialPost } = Astro.props;
const visibleLocales = getPublicLanguagePicker(siteData);
---
<AdminLayout title="Admin — Editar post" description="Editar una entrada de blog existente">
  <section class="mx-auto max-w-5xl px-6 pb-16 pt-28">
    <div class="border-b border-black/10 pb-6">
      <p class="font-body text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-ink-faint">Blog editorial</p>
      <div class="mt-3 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <h1 class="font-heading text-5xl leading-none text-ink md:text-7xl">Admin — Editar post</h1>
        <a href="/admin/blog/" class="inline-flex items-center gap-3 border-b border-black/10 pb-1 font-body text-xs font-semibold uppercase tracking-[0.24em] text-ink transition hover:border-amaranth hover:text-amaranth">
          <span aria-hidden="true">←</span>
          Volver al archivo
        </a>
      </div>
    </div>

    <div class="pt-8">
      <BlogPostForm client:load mode="edit" visibleLocales={visibleLocales} initialPost={initialPost} />
    </div>
  </section>
</AdminLayout>
