---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditableText from '../../components/admin/EditableText';
import AdminTranslationArsenalEditor from '../../components/admin/AdminTranslationArsenalEditor';
import { getLangFromUrl, t } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.translationPage;
---

<AdminLayout title={`Admin — ${i.nav.translationSeo}`} description={page.hero.text.replaceAll('\n', ' ').replace(/\s+/g, ' ').trim()}>
  <div class="bg-paper" data-admin-translation-page>
    <section class="relative overflow-hidden border-b border-ink bg-paper px-6 pb-18 pt-28 md:pb-20 md:pt-32">
      <div class="site-container relative">
        <div class="max-w-4xl space-y-6 pr-12 md:pr-20">
          <EditableText client:load i18nKey="translationPage.hero.eyebrow" as="p" className="inline-flex border border-ink px-3 py-2 font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.hero.title" as="h1" className="max-w-[14ch] font-heading text-5xl leading-[0.92] tracking-[-0.04em] text-ink md:text-7xl" />
          <EditableText client:load i18nKey="translationPage.hero.text" as="div" className="max-w-3xl text-lg leading-8 text-ink-muted" />

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <EditableText client:load i18nKey="translationPage.hero.ctaPrimary" as="span" className="inline-flex items-center gap-3 border border-amaranth bg-amaranth px-5 py-3 text-xs font-semibold uppercase tracking-[0.24em] text-ink" />
            <EditableText client:load i18nKey="translationPage.hero.ctaSecondary" as="span" className="inline-flex items-center gap-3 border border-ink bg-paper px-5 py-3 text-xs font-semibold uppercase tracking-[0.24em] text-ink" />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ink px-6 py-14 text-paper md:py-18">
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <EditableText client:load i18nKey="translationPage.servicesEyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.services.title" as="h2" className="font-heading text-4xl text-paper md:text-5xl" />
        </div>

        <div class="grid gap-10 border-t border-paper/18 pt-8 md:grid-cols-[0.76fr_1.24fr] md:pt-10">
          <div class="space-y-6">
            {page.services.items.map((_service, index) => (
              <div class="border-b border-paper/18 pb-5">
                <EditableText client:load i18nKey={`translationPage.services.items.${index}.name`} as="h3" className="font-heading text-3xl text-paper md:text-4xl" />
              </div>
            ))}
          </div>

          <div class="space-y-8 border-l border-paper/18 pl-8 md:pl-10">
            {page.services.items.map((_service, index) => (
              <article class={index === 0 ? 'space-y-5' : 'space-y-5 border-t border-paper/18 pt-8'}>
                <EditableText client:load i18nKey={`translationPage.services.items.${index}.headline`} as="h3" className="font-heading text-3xl leading-[0.96] text-paper md:text-4xl" />
                <EditableText client:load i18nKey={`translationPage.services.items.${index}.description`} as="div" className="max-w-2xl text-base leading-8 text-paper/74" />
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18">
      <div class="site-container space-y-10">
        <div class="space-y-3">
          <EditableText client:load i18nKey="translationPage.arsenalEyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.arsenal.title" as="h2" className="font-heading text-4xl text-ink md:text-5xl" />
        </div>

        <AdminTranslationArsenalEditor client:load />
      </div>
    </section>

    <section class="px-6 py-14 md:py-18">
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <EditableText client:load i18nKey="translationPage.experienceEyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.experienceSectionTitle" as="h2" className="font-heading text-4xl text-ink md:text-5xl" />
        </div>

        <section class="border border-ink bg-ink text-paper" data-admin-experience-browser>
          <div class="border-b border-paper/16 bg-paper/8 px-4 pt-4 md:px-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="h-2 w-2 rounded-full bg-amaranth" aria-hidden="true"></span>
                <div class="flex flex-wrap items-end gap-2">
                  <button type="button" class="rounded-t-[7px] border border-b-0 border-paper bg-paper px-4 py-3 text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-ink transition" data-admin-experience-trigger="education"> {page.browserTabs.education} </button>
                  <button type="button" class="rounded-t-[7px] border border-b-0 border-paper/18 bg-paper/14 px-4 py-3 text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-paper/62 transition hover:bg-paper/18 hover:text-paper focus-visible:bg-paper/18 focus-visible:text-paper" data-admin-experience-trigger="experience"> {page.browserTabs.experience} </button>
                </div>
              </div>
              <EditableText client:load i18nKey="translationPage.browserTabs.profileLabel" as="span" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-paper/42" />
            </div>
          </div>

          <div class="px-5 py-6 md:px-6 md:py-8">
            <div class="grid gap-8 lg:grid-cols-[0.62fr_1.38fr]">
              <div class="space-y-5 border-b border-paper/16 pb-6 lg:border-b-0 lg:border-r lg:pb-0 lg:pr-8">
                <EditableText client:load i18nKey="translationPage.experienceStatement" as="p" className="font-heading text-3xl leading-[0.96] text-paper md:text-4xl" />
              </div>

              <div class="space-y-8">
                <div class="space-y-5" data-admin-experience-panel="education">
                  <EditableText client:load i18nKey="translationPage.education.intro" as="div" className="text-base leading-8 text-paper/68" />
                  <div class="space-y-4">
                    {page.education.studies.map((_study, index) => (
                      <div class="flex gap-3">
                        <span class="mt-3 h-2 w-2 rounded-full bg-amaranth"></span>
                        <EditableText client:load i18nKey={`translationPage.education.studies.${index}`} as="span" className="text-base leading-8 text-paper" />
                      </div>
                    ))}
                  </div>
                </div>

                <div class="hidden space-y-8" data-admin-experience-panel="experience">
                  <EditableText client:load i18nKey="translationPage.experience.intro" as="div" className="text-base leading-8 text-paper/68" />
                  <div class="grid gap-px bg-paper/16 lg:grid-cols-3">
                    {page.experience.cards.map((_card, index) => (
                      <article class="bg-ink px-5 py-6">
                        <EditableText client:load i18nKey={`translationPage.experience.cards.${index}.highlight`} as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-amaranth" />
                        <EditableText client:load i18nKey={`translationPage.experience.cards.${index}.title`} as="h3" className="mt-4 font-heading text-2xl text-paper" />
                        <EditableText client:load i18nKey={`translationPage.experience.cards.${index}.text`} as="div" className="mt-4 text-sm leading-7 text-paper/72" />
                      </article>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section class="bg-ink px-6 py-14 text-paper md:py-18" data-admin-methodology>
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <EditableText client:load i18nKey="translationPage.methodologyEyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.methodologyDisplayTitle" as="h2" className="max-w-4xl font-heading text-4xl text-paper md:text-5xl" />
        </div>

        <div class="relative">
          <span class="absolute left-6 top-4 block h-[calc(100%-2rem)] w-px bg-paper/18 md:hidden" data-methodology-connector></span>
          <span class="absolute left-10 right-10 top-8 hidden h-px bg-paper/18 md:block" data-methodology-connector></span>

          <div class="grid items-stretch gap-6 md:grid-cols-4">
            {page.methodology.steps.map((_step, index) => (
              <article class="group relative flex h-full flex-col overflow-visible pl-16 md:pl-0">
                <div class="absolute left-0 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-paper/24 font-body text-sm font-semibold uppercase tracking-[0.16em] text-amaranth transition group-hover:-translate-y-1 group-hover:border-amaranth group-hover:bg-amaranth group-hover:text-ink group-focus-visible:-translate-y-1 group-focus-visible:border-amaranth group-focus-visible:bg-amaranth group-focus-visible:text-ink md:relative md:mx-auto">
                  0{index + 1}
                </div>
                <div class="border border-paper/18 px-5 py-6 transition group-hover:-translate-y-1 group-hover:border-amaranth/60 group-focus-visible:-translate-y-1 group-focus-visible:border-amaranth/60 md:mt-6 md:flex-1 md:h-full md:min-h-[170px]">
                  <EditableText client:load i18nKey={`translationPage.methodology.steps.${index}.title`} as="h3" className="font-heading text-2xl text-paper" />
                  <EditableText client:load i18nKey={`translationPage.methodology.steps.${index}.description`} as="div" className="mt-4 text-sm leading-7 text-paper/72" />
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18" data-admin-why>
      <div class="site-container space-y-8">
        <div class="space-y-3">
          <EditableText client:load i18nKey="translationPage.whyEyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.whyChooseMe.title" as="h2" className="max-w-3xl font-heading text-4xl text-ink md:text-5xl" />
        </div>

        <div class="grid gap-0 border border-ink md:grid-cols-3 md:divide-x md:divide-ink">
          {page.whyChooseMe.cards.map((_card, index) => (
            <article class="relative overflow-hidden border-b border-ink last:border-b-0 md:border-b-0">
              <div class="relative space-y-5 px-5 py-6">
                <p class="font-body text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-amaranth">{`[ 0${index + 1} ]`}</p>
                <EditableText client:load i18nKey={`translationPage.whyChooseMe.cards.${index}.title`} as="h3" className="font-heading text-3xl text-ink" />
                <EditableText client:load i18nKey={`translationPage.whyChooseMe.cards.${index}.text`} as="div" className="text-sm leading-7 text-ink-muted" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>

  <script>
    const root = document.querySelector('[data-admin-experience-browser]');
    if (root instanceof HTMLElement) {
      const triggers = Array.from(root.querySelectorAll('[data-admin-experience-trigger]'));
      const panels = Array.from(root.querySelectorAll('[data-admin-experience-panel]'));

      const setActivePanel = (panelId) => {
        triggers.forEach((trigger) => {
          const isActive = trigger.getAttribute('data-admin-experience-trigger') === panelId;
          trigger.classList.toggle('border-paper', isActive);
          trigger.classList.toggle('bg-paper', isActive);
          trigger.classList.toggle('text-ink', isActive);
          trigger.classList.toggle('border-paper/18', !isActive);
          trigger.classList.toggle('bg-paper/14', !isActive);
          trigger.classList.toggle('text-paper/62', !isActive);
        });

        panels.forEach((panel) => {
          const isActive = panel.getAttribute('data-admin-experience-panel') === panelId;
          panel.classList.toggle('hidden', !isActive);
        });
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const panelId = trigger.getAttribute('data-admin-experience-trigger');
          if (panelId) setActivePanel(panelId);
        });
      });

      setActivePanel('education');
    }
  </script>
</AdminLayout>
