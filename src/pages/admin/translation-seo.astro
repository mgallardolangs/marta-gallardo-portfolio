---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditableText from '../../components/admin/EditableText';
import EditableCollection from '../../components/admin/EditableCollection';
import { getLangFromUrl, t } from '../../i18n';
import { siteData as imagesData } from '../../lib/siteData';
import { getTranslationArsenalColumns } from '../../lib/translationPage.js';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.translationPage;
const arsenalColumns = getTranslationArsenalColumns(lang, imagesData);
---

<AdminLayout title={`Admin — ${i.nav.translationSeo}`} description={page.hero.text.replaceAll('\n', ' ').replace(/\s+/g, ' ').trim()}>
  <div class="bg-paper">
    <section class="relative overflow-hidden border-b border-black/10 bg-paper px-6 pb-20 pt-28 md:pb-24 md:pt-32">
      <div class="absolute inset-x-0 top-0 h-72 bg-[radial-gradient(circle_at_top,rgba(232,50,86,0.14),transparent_68%)]"></div>
      <div class="site-container relative grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
        <div class="max-w-4xl space-y-6">
          <div class="inline-flex items-center gap-4 border-y border-black/12 py-3">
            <EditableText client:load i18nKey="translationPage.hero.eyebrow" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.28em] text-amaranth" />
          </div>

          <EditableText client:load i18nKey="translationPage.hero.title" as="h1" className="max-w-[14ch] font-heading text-5xl leading-[0.92] tracking-[-0.04em] text-ink md:text-7xl" />
          <EditableText client:load i18nKey="translationPage.hero.text" as="div" className="max-w-3xl text-lg leading-8 text-ink-muted" />

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <EditableText client:load i18nKey="translationPage.hero.ctaPrimary" as="span" className="inline-flex items-center gap-3 rounded-full border border-amaranth bg-amaranth px-5 py-3 text-xs font-semibold uppercase tracking-[0.24em] text-ink" />
            <EditableText client:load i18nKey="translationPage.hero.ctaSecondary" as="span" className="inline-flex items-center gap-3 rounded-full border border-black/10 bg-white px-5 py-3 text-xs font-semibold uppercase tracking-[0.24em] text-ink" />
          </div>
        </div>

        <div class="border border-black/10 bg-white/84 p-6 shadow-[0_18px_40px_rgba(6,4,3,0.06)] backdrop-blur md:p-8">
          <EditableText client:load i18nKey="translationPage.hero.backgroundLabel" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.24em] text-amaranth" />
        </div>
      </div>
    </section>

    <section class="bg-ink px-6 py-14 text-paper md:py-18">
      <div class="site-container grid gap-10 md:grid-cols-[0.95fr_1.05fr]">
        <div class="space-y-6">
          <EditableText client:load i18nKey="translationPage.services.title" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.28em] text-paper" />

          <div class="space-y-6">
            {page.services.items.map((service, index) => (
              <div class="border-b border-white/10 pb-5">
                <EditableText client:load i18nKey={`translationPage.services.items.${index}.name`} as="h2" className="font-heading text-3xl text-paper md:text-4xl" />
                <EditableText client:load i18nKey={`translationPage.services.items.${index}.description`} as="div" className="mt-4 max-w-xl text-sm leading-7 text-white/72" />
                <span class="mt-4 block h-px bg-amaranth/30"></span>
              </div>
            ))}
          </div>
        </div>

        <div class="border border-white/10 bg-white/5 p-6 md:p-8">
          <EditableText client:load i18nKey="translationPage.services.items.0.name" as="p" className="font-body text-xs font-semibold uppercase tracking-[0.3em] text-paper" />
          <EditableText client:load i18nKey="translationPage.services.items.0.description" as="div" className="mt-4 text-lg leading-8 text-white/78" />
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18">
      <div class="site-container space-y-10">
        <EditableText client:load i18nKey="translationPage.arsenal.title" as="h2" className="font-heading text-4xl text-ink md:text-5xl" />

        <div class="grid gap-6">
          <EditableCollection
            client:load
            kind="languages"
            title={page.arsenal.languagesTitle}
            description="Edit ES/EN/FR names and levels. New languages inherit Spanish in DE/IT/CA until code-managed translations are updated."
          />
          <EditableCollection
            client:load
            kind="tools"
            title={page.arsenal.toolsTitle}
            description="Edit ES/EN/FR labels and upload logos. Tool IDs stay stable for public rendering and publishing."
          />
          <EditableCollection
            client:load
            kind="skills"
            title={page.arsenal.skillsTitle}
            description="Edit the combined linguistic and web optimization chips that power the public arsenal section."
          />
        </div>

        <div class="grid gap-6 lg:grid-cols-3">
          <article class="border border-black/10 bg-white p-6 shadow-[0_16px_36px_rgba(6,4,3,0.05)]">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.languagesTitle}</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {arsenalColumns.languages.map((language) => (
                <div class="border border-black/10 bg-paper px-4 py-4">
                  <p class="font-heading text-2xl text-ink">{language.label}</p>
                  <p class="mt-2 text-sm text-ink-muted">{language.level}</p>
                </div>
              ))}
            </div>
          </article>

          <article class="border border-black/10 bg-white p-6 shadow-[0_16px_36px_rgba(6,4,3,0.05)]">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.toolsTitle}</p>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {arsenalColumns.tools.map((tool) => (
                <div class="flex items-center gap-4 border border-black/10 bg-paper px-4 py-4">
                  <div class="flex h-12 w-12 items-center justify-center border border-black/10 bg-white">
                    <img src={tool.logoSrc} alt={tool.label} class="h-7 w-7 object-contain" />
                  </div>
                  <p class="text-sm leading-6 text-ink">{tool.label}</p>
                </div>
              ))}
            </div>
          </article>

          <article class="border border-black/10 bg-white p-6 shadow-[0_16px_36px_rgba(6,4,3,0.05)]">
            <p class="font-body text-xs font-semibold uppercase tracking-[0.26em] text-amaranth">{page.arsenal.skillsTitle}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              {arsenalColumns.skills.map((skill) => (
                <span class="border border-black/10 bg-paper px-4 py-2 text-sm text-ink">{skill.label}</span>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18">
      <div class="site-container border border-black/10 bg-white shadow-[0_20px_64px_rgba(6,4,3,0.08)]">
        <div class="border-b border-black/10 bg-paper px-4 py-4 md:px-6">
          <div class="flex flex-wrap items-center gap-3">
            <EditableText client:load i18nKey="translationPage.browserTabs.education" as="span" className="rounded-full border border-amaranth bg-amaranth px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-ink" />
            <EditableText client:load i18nKey="translationPage.browserTabs.experience" as="span" className="rounded-full border border-black/10 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.24em] text-ink-muted" />
          </div>
        </div>

        <div class="grid gap-8 p-6 md:p-8 lg:grid-cols-2">
          <div class="space-y-6">
            <EditableText client:load i18nKey="translationPage.education.intro" as="div" className="text-base leading-8 text-ink-muted" />
            <div class="space-y-4">
              {page.education.studies.map((_study, index) => (
                <div class="flex gap-3">
                  <span class="mt-3 h-2 w-2 rounded-full bg-amaranth"></span>
                  <EditableText client:load i18nKey={`translationPage.education.studies.${index}`} as="span" className="text-base leading-8 text-ink" />
                </div>
              ))}
            </div>
          </div>

          <div class="space-y-8">
            <EditableText client:load i18nKey="translationPage.experience.intro" as="div" className="text-base leading-8 text-ink-muted" />
            <div class="grid gap-5">
              {page.experience.cards.map((card, index) => (
                <article class="border border-black/10 bg-paper p-5">
                  <EditableText client:load i18nKey={`translationPage.experience.cards.${index}.highlight`} as="p" className="font-body text-xs font-semibold uppercase tracking-[0.24em] text-amaranth" />
                  <EditableText client:load i18nKey={`translationPage.experience.cards.${index}.title`} as="h3" className="mt-4 font-heading text-2xl text-ink" />
                  <EditableText client:load i18nKey={`translationPage.experience.cards.${index}.text`} as="div" className="mt-4 text-sm leading-7 text-ink-muted" />
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ink px-6 py-14 text-paper md:py-18">
      <div class="site-container space-y-10">
        <EditableText client:load i18nKey="translationPage.methodology.title" as="h2" className="font-heading text-4xl text-paper md:text-5xl" />

        <div class="grid gap-6 md:grid-cols-4">
          {page.methodology.steps.map((_step, index) => (
            <article class="relative pl-16 md:pl-0">
              <div class="absolute left-0 top-0 flex h-12 w-12 items-center justify-center rounded-full border border-white/12 bg-white/6 font-body text-sm font-semibold uppercase tracking-[0.16em] text-amaranth md:relative md:mx-auto">
                0{index + 1}
              </div>
              <div class="border border-white/10 bg-white/5 p-6 md:mt-6">
                <EditableText client:load i18nKey={`translationPage.methodology.steps.${index}.title`} as="h3" className="font-heading text-2xl text-paper" />
                <EditableText client:load i18nKey={`translationPage.methodology.steps.${index}.description`} as="div" className="mt-4 text-sm leading-7 text-white/72" />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-14 md:py-18">
      <div class="site-container space-y-10">
        <EditableText client:load i18nKey="translationPage.whyChooseMe.title" as="h2" className="max-w-3xl font-heading text-4xl text-ink md:text-5xl" />

        <div class="grid gap-6 md:grid-cols-3">
          {page.whyChooseMe.cards.map((_card, index) => (
            <article class="border border-black/10 bg-white p-6 shadow-[0_16px_36px_rgba(6,4,3,0.05)]">
              <div class="flex items-start gap-3">
                <span class="text-amaranth">[</span>
                <div class="space-y-4">
                  <EditableText client:load i18nKey={`translationPage.whyChooseMe.cards.${index}.title`} as="h3" className="font-heading text-3xl text-ink" />
                  <EditableText client:load i18nKey={`translationPage.whyChooseMe.cards.${index}.text`} as="div" className="text-sm leading-7 text-ink-muted" />
                </div>
                <span class="text-amaranth">]</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
