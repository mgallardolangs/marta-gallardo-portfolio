---
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditableText from '../../components/admin/EditableText';
import AdminTranslationArsenalEditor from '../../components/admin/AdminTranslationArsenalEditor';
import ScrollReveal from '../../components/ScrollReveal';
import { getLangFromUrl, t } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.translationServicePage;
---

<AdminLayout title={`Admin — ${page.hero.title}`} description={page.hero.description}>
  <div class="bg-paper" data-admin-translation-page>
    <section class="px-6 pb-16 pt-28 md:pb-20 md:pt-32">
      <div class="site-container max-w-7xl">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
          <EditableText client:load i18nKey="translationServicePage.hero.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-amaranth" />
          <EditableText client:load i18nKey="translationServicePage.hero.title" as="h1" className="max-w-[18ch] font-heading text-5xl leading-[0.96] tracking-[-0.04em] text-ink md:text-7xl" />
          <EditableText client:load i18nKey="translationServicePage.hero.description" as="div" className="max-w-5xl font-body text-lg leading-8 text-ink-muted" />
          <div class="site-text-cta-row">
            <a href="/admin/contact" class="site-text-cta">
              {i.footer.cta}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <EditableText client:load i18nKey="translationServicePage.localization.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationServicePage.localization.title" as="h2" className="font-heading text-4xl text-paper md:text-5xl" />
        </div>
        <div class="grid gap-8 border-t border-paper/18 pt-8 md:grid-cols-2">
          {page.localization.items.map((_service, index) => (
            <article class="space-y-5 border-b border-paper/18 pb-7 last:border-b-0 md:border-b-0 md:border-r md:pr-8">
              <EditableText client:load i18nKey={`translationServicePage.localization.items.${index}.title`} as="h3" className="font-heading text-2xl leading-tight text-paper md:text-3xl" />
              <EditableText client:load i18nKey={`translationServicePage.localization.items.${index}.description`} as="div" className="text-base leading-8 text-paper/74" />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20">
      <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="translationServicePage.multilingualSeo.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationServicePage.multilingualSeo.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-5xl" />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="translationServicePage.multilingualSeo.description" as="div" className="max-w-3xl font-body text-base leading-8 text-ink-muted md:text-lg" />
          <div class="site-text-cta-row">
            <a href="/admin/seo" class="site-text-cta">
              {page.multilingualSeo.seoLinkLabel}
              <span class="site-text-cta__arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20">
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <EditableText client:load i18nKey="translationServicePage.digitalContent.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationServicePage.digitalContent.title" as="h2" className="font-heading text-4xl text-paper md:text-5xl" />
        </div>
        <div class="grid gap-8 border-t border-paper/18 pt-8 md:grid-cols-2">
          {page.digitalContent.items.map((_service, index) => (
            <article class="space-y-5 border-b border-paper/18 pb-7 last:border-b-0 md:border-b-0 md:border-r md:pr-8">
              <EditableText client:load i18nKey={`translationServicePage.digitalContent.items.${index}.title`} as="h3" className="font-heading text-2xl leading-tight text-paper md:text-3xl" />
              <EditableText client:load i18nKey={`translationServicePage.digitalContent.items.${index}.description`} as="div" className="text-base leading-8 text-paper/74" />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="admin-translation-arsenal" class="px-6 py-16 md:py-20">
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <EditableText client:load i18nKey="translationServicePage.arsenal.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationServicePage.arsenal.title" as="h2" className="font-heading text-4xl text-ink md:text-5xl" />
        </div>
        <AdminTranslationArsenalEditor client:load scope="translation" />
      </div>
    </section>
  </div>
</AdminLayout>
