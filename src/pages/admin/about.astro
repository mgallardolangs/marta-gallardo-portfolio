---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminBrandVideo from '../../components/admin/AdminBrandVideo';
import AdminTranslationExperienceEditor from '../../components/admin/AdminTranslationExperienceEditor';
import EditableText from '../../components/admin/EditableText';
import ScrollReveal from '../../components/ScrollReveal';
import { getLangFromUrl, t } from '../../i18n';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.aboutPage;
const experience = i.translationPage;
---

<AdminLayout title={`Admin — ${page.hero.title}`} description={page.hero.story}>
  <div class="bg-paper" data-admin-about-page>
    <section class="px-6 pb-16 pt-28 md:pb-20 md:pt-32">
      <div class="site-container grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:gap-16">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-8">
          <EditableText client:load i18nKey="aboutPage.hero.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-hazel" />
          <EditableText client:load i18nKey="aboutPage.hero.title" as="h1" className="max-w-[13ch] font-heading text-5xl leading-[0.96] tracking-[-0.04em] text-ink md:text-7xl" />
          <EditableText client:load i18nKey="aboutPage.hero.subtitle" as="h2" className="font-heading text-2xl leading-tight text-ink md:text-3xl" />
          <EditableText client:load i18nKey="aboutPage.hero.story" as="div" className="max-w-2xl font-body text-base leading-8 text-ink-muted md:text-lg" />
        </ScrollReveal>

        <ScrollReveal client:visible direction="left" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="home.video.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.32em] text-hazel" />
          <div class="relative mx-auto aspect-[9/16] w-full max-w-[22rem] overflow-hidden border border-ink/12 bg-ink">
            <AdminBrandVideo client:load />
          </div>
          <EditableText client:load i18nKey="home.video.description" as="div" className="max-w-xl font-body text-sm leading-7 text-ink-muted md:text-base" />
        </ScrollReveal>
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20" data-admin-about-trajectory>
      <div class="site-container space-y-10">
        <div class="space-y-5">
          <EditableText client:load i18nKey="aboutPage.trajectoryEyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="translationPage.experienceSectionTitle" as="h2" className="font-heading text-4xl text-paper md:text-5xl" />
        </div>

        <AdminTranslationExperienceEditor
          client:load
          initialContent={{
            browserTabsAriaLabel: experience.browserTabsAriaLabel,
            browserTabs: {
              education: experience.browserTabs.education,
              experience: experience.browserTabs.experience,
            },
            experienceStatement: experience.experienceStatement,
            education: {
              intro: experience.education.intro,
              studies: experience.education.studies,
            },
            experience: {
              intro: experience.experience.intro,
              cards: experience.experience.cards,
            },
          }}
        />
      </div>
    </section>

    <section class="px-6 py-16 md:py-20">
      <div class="site-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-7">
          <EditableText client:load i18nKey="aboutPage.principles.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-hazel" />
          <EditableText client:load i18nKey="aboutPage.principles.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-5xl" />
          <div class="flex flex-wrap gap-3">
            {page.principles.items.map((_principle, index) => (
              <EditableText client:load i18nKey={`aboutPage.principles.items.${index}`} as="span" className="border border-ink/16 px-3 py-2 font-body text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-ink" />
            ))}
          </div>
        </ScrollReveal>

        <ScrollReveal client:visible direction="left" className="flex flex-col gap-7 border-t border-ink/16 pt-7 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
          <EditableText client:load i18nKey="aboutPage.work.title" as="h3" className="font-heading text-3xl leading-tight text-ink md:text-4xl" />
          <EditableText client:load i18nKey="aboutPage.work.description" as="div" className="max-w-2xl font-body text-base leading-8 text-ink-muted md:text-lg" />
        </ScrollReveal>
      </div>
    </section>
  </div>
</AdminLayout>
