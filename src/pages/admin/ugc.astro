---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ScrollReveal from '../../components/ScrollReveal';
import PageTransition from '../../components/PageTransition';
import ParallaxLayer from '../../components/ParallaxLayer';
import VideoGallery from '../../components/VideoGallery';
import PhotoMasonry from '../../components/PhotoMasonry';
import { getLangFromUrl, t } from '../../i18n';
import imagesData from '../../data/images.json';
import EditableText from '../../components/admin/EditableText';
import EditableImage from '../../components/admin/EditableImage';
import AdminNicheCard from '../../components/admin/AdminNicheCard';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const images = imagesData as {
  nicheBackgrounds?: Record<string, string>;
  nicheIcons?: Record<string, string>;
  ugcVideos?: Record<string, string[]>;
  ugcPhotos?: Record<string, string[]>;
};

const niches = [
  { id: 'travel', ...i.ugcPage.niches.travel },
  { id: 'languages', ...i.ugcPage.niches.languages },
  { id: 'art', ...i.ugcPage.niches.art },
].map((niche) => ({
  ...niche,
  videos: images.ugcVideos?.[niche.id] ?? [],
  photos: images.ugcPhotos?.[niche.id] ?? [],
  iconImage: images.nicheIcons?.[niche.id] ?? '',
}));

const allPhotos = images.ugcPhotos?.all ?? [];
---
<AdminLayout title={`Admin — ${i.ugc.title}`} description={i.ugcPage.pageDescription}>
  <PageTransition client:load>
    <div id="top" class="bg-cream pt-24">
      <section class="relative overflow-hidden border-b border-blush-100 bg-gradient-to-b from-blush-50 via-cream to-cream">
        <ParallaxLayer client:visible className="pointer-events-none absolute inset-x-0 top-4 hidden md:block" speed={-0.12}>
          <div class="mx-auto max-w-6xl px-6 text-right font-accent text-7xl italic tracking-[0.18em] text-rose-gold/10">
            <EditableText client:load i18nKey="ugcPage.hero.backgroundLabel" as="span" className="" />
          </div>
        </ParallaxLayer>

        <div class="relative z-10 mx-auto max-w-6xl px-6 pt-28 pb-16 md:pt-32 md:pb-24">
          <div class="grid gap-12 lg:grid-cols-[1fr_minmax(280px,380px)] lg:items-center lg:gap-16">
            <ScrollReveal client:visible className="max-w-xl">
              <EditableText client:load i18nKey="ugcPage.hero.eyebrow" as="p" className="font-accent text-sm uppercase tracking-[0.35em] text-rose-gold" />
              <EditableText client:load i18nKey="ugcPage.hero.headline" as="h1" className="mt-4 font-heading text-5xl leading-none text-charcoal md:text-7xl" />
              <EditableText client:load i18nKey="ugcPage.hero.description" as="div" className="mt-6 font-body text-lg leading-8 text-warm-gray md:text-xl" />
            </ScrollReveal>

            <ScrollReveal client:visible delay={0.12}>
              <div class="hero-carousel relative aspect-[3/4] w-full max-w-sm mx-auto overflow-hidden rounded-3xl shadow-lg" data-interval="3500">
                {(images.ugcPhotos?.all ?? []).length > 0 ? (
                  (images.ugcPhotos?.all ?? []).map((src, idx) => (
                    <img
                      src={src}
                      alt={`UGC ${idx + 1}`}
                      class="carousel-slide absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-in-out"
                      style={`transform: translateX(${idx * 100}%);`}
                      loading="lazy"
                    />
                  ))
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-blush-100 to-blush-200">
                    <span class="text-4xl opacity-30">📸</span>
                  </div>
                )}
              </div>
            </ScrollReveal>
          </div>
        </div>
      </section>

      <section class="px-6 py-16 md:py-20">
        <div class="mx-auto max-w-5xl text-center">
          <ScrollReveal client:visible>
            <EditableText client:load i18nKey="ugcPage.hero.nicheIntroTitle" as="p" className="font-heading text-3xl italic leading-snug text-charcoal md:text-5xl lg:text-6xl" />
          </ScrollReveal>
          <ScrollReveal client:visible delay={0.15}>
            <EditableText client:load i18nKey="ugcPage.hero.nicheIntroText" as="p" className="mx-auto mt-8 max-w-3xl font-body text-lg leading-8 text-warm-gray md:text-xl" />
          </ScrollReveal>
        </div>
      </section>

      <section class="px-6 pb-16 md:pb-20">
        <div class="mx-auto max-w-6xl">
          <ScrollReveal client:visible>
            <div class="grid gap-4 md:grid-cols-3">
              <AdminNicheCard client:load id="travel" labelKey="ugcPage.niches.travel.label" accentKey="ugcPage.niches.travel.accent" backgroundImageKey="nicheBackgrounds.travel" iconImageKey="nicheIcons.travel" />
              <AdminNicheCard client:load id="languages" labelKey="ugcPage.niches.languages.label" accentKey="ugcPage.niches.languages.accent" backgroundImageKey="nicheBackgrounds.languages" iconImageKey="nicheIcons.languages" />
              <AdminNicheCard client:load id="art" labelKey="ugcPage.niches.art.label" accentKey="ugcPage.niches.art.accent" backgroundImageKey="nicheBackgrounds.art" iconImageKey="nicheIcons.art" />
            </div>
          </ScrollReveal>
        </div>
      </section>

      {niches.map((niche, index) => (
        <section
          id={niche.id}
          class={`mx-auto max-w-6xl scroll-mt-28 px-6 py-16 md:py-20 ${index < niches.length - 1 ? 'border-b border-blush-100' : ''}`}
        >
          <ScrollReveal client:visible className="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div class="max-w-3xl">
              <div class="flex items-center gap-4">
                <EditableText client:load i18nKey={`ugcPage.niches.${niche.id}.eyebrow`} as="p" className="font-accent text-sm uppercase tracking-[0.35em] text-rose-gold" />
                <EditableImage client:load imageKey={`nicheIcons.${niche.id}`} className="h-12 w-12 rounded-2xl overflow-hidden" alt={`${niche.id} icon`} />
              </div>
              <EditableText client:load i18nKey={`ugcPage.niches.${niche.id}.label`} as="h2" className="mt-4 font-heading text-4xl text-charcoal md:text-6xl" />
              <EditableText client:load i18nKey={`ugcPage.niches.${niche.id}.intro`} as="p" className="mt-4 font-body text-base leading-8 text-warm-gray md:text-lg" />
            </div>
            <a
              href="#top"
              class="inline-flex items-center gap-2 self-start rounded-full border border-blush-200 bg-blush-50 px-4 py-2 font-body text-sm text-charcoal transition hover:border-rose-gold hover:text-rose-gold"
            >
              {i.ugcPage.backToTop}
              <span aria-hidden="true">↑</span>
            </a>
          </ScrollReveal>

          {niche.videos.length > 0 && (
            <div class="mt-10">
              <VideoGallery client:visible videos={niche.videos.map((src: string) => ({ src }))} />
            </div>
          )}

          {niche.photos.length > 0 && (
            <div class="mt-10">
              <PhotoMasonry client:visible photos={niche.photos} />
            </div>
          )}

          {(!niche.videos.length && !niche.photos.length) && (
            <div class="mt-10 flex aspect-[3/1] items-center justify-center rounded-2xl border-2 border-dashed border-blush-200 bg-blush-50/50">
              <p class="font-body text-sm text-warm-gray">📸 Content coming soon</p>
            </div>
          )}
        </section>
      ))}

      {allPhotos.length > 0 && (
        <section class="mx-auto max-w-7xl px-4 py-16 md:py-20">
          <ScrollReveal client:visible>
            <h2 class="mb-10 font-heading text-4xl text-charcoal md:text-6xl">📸</h2>
          </ScrollReveal>
          <PhotoMasonry client:visible photos={allPhotos} />
        </section>
      )}
    </div>
  </PageTransition>
</AdminLayout>

<script>
  document.querySelectorAll('.hero-carousel').forEach((container) => {
    const slides = Array.from(container.querySelectorAll('.carousel-slide'));
    if (slides.length <= 1) return;
    const interval = parseInt((container as HTMLElement).dataset.interval || '3500');
    let current = 0;
    let autoTimer: number;

    const goTo = (idx: number) => {
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        (slide as HTMLElement).style.transform = `translateX(${(i - current) * 100}%)`;
      });
    };

    const next = () => goTo(current + 1);
    const prev = () => goTo(current - 1);

    const resetAuto = () => {
      clearInterval(autoTimer);
      autoTimer = window.setInterval(next, interval);
    };

    autoTimer = window.setInterval(next, interval);

    container.addEventListener('wheel', (event: Event) => {
      const wheelEvent = event as WheelEvent;
      if (Math.abs(wheelEvent.deltaX) > Math.abs(wheelEvent.deltaY) || Math.abs(wheelEvent.deltaY) > 30) {
        event.preventDefault();
        if (wheelEvent.deltaX > 0 || wheelEvent.deltaY > 0) next(); else prev();
        resetAuto();
      }
    }, { passive: false });

    let touchStartX = 0;
    container.addEventListener('touchstart', (event: Event) => {
      touchStartX = (event as TouchEvent).touches[0].clientX;
    });
    container.addEventListener('touchend', (event: Event) => {
      const diff = touchStartX - (event as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) next(); else prev();
        resetAuto();
      }
    });
  });
</script>
