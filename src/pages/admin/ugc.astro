---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ScrollReveal from '../../components/ScrollReveal';
import UgcContactSheet from '../../components/UgcContactSheet';
import EditableText from '../../components/admin/EditableText';
import EditableUgcPortfolio from '../../components/admin/EditableUgcPortfolio';
import { getLangFromUrl, t } from '../../i18n';
import { siteData } from '../../lib/siteData';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
const page = i.ugcPage;
---

<AdminLayout title={`Admin — ${page.pageTitle}`} description={page.pageDescription}>
  <div class="bg-paper">
    <section class="px-6 pt-20 pb-5 md:pt-24 md:pb-6">
      <div class="site-container">
        <ScrollReveal client:visible className="max-w-6xl flex flex-col gap-6">
          <EditableText client:load i18nKey="ugcPage.hero.eyebrow" as="p" className="text-xs font-semibold uppercase tracking-[0.34em] text-amaranth" />
          <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:items-end">
            <EditableText client:load i18nKey="ugcPage.pageTitle" as="h1" className="block text-4xl leading-none text-ink md:text-6xl" />
            <EditableText client:load i18nKey="ugcPage.contactSheet.headline" as="p" className="text-balance text-lg font-semibold uppercase leading-[1.18] tracking-[0.13em] text-ink md:text-2xl lg:justify-self-end lg:text-right lg:text-3xl" />
          </div>
        </ScrollReveal>

        <div class="mt-5 overflow-hidden" aria-hidden="true">
          <div class="ugc-hero-rule h-px bg-ink/20" />
        </div>
      </div>
    </section>

    <section class="px-6 pb-16 md:pb-20">
      <div class="site-container">
        <UgcContactSheet
          client:load
          adminPreview
          items={siteData.ugcPortfolio}
          lang={lang}
          copy={i.ugcPage.contactSheet}
        />
      </div>
    </section>

    <section class="bg-ink px-6 py-16 text-paper md:py-20" data-admin-ugc-benefits>
      <div class="site-container grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <ScrollReveal client:visible direction="right" className="flex flex-col gap-6">
          <EditableText client:load i18nKey="ugcPage.benefits.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="ugcPage.benefits.title" as="h2" className="font-heading text-4xl leading-none text-paper md:text-5xl" />
        </ScrollReveal>
        <ScrollReveal client:visible direction="left">
          <EditableText client:load i18nKey="ugcPage.benefits.description" as="div" className="max-w-3xl font-body text-base leading-8 text-paper/74 md:text-lg" />
        </ScrollReveal>
      </div>
    </section>

    <section class="px-6 py-16 md:py-20" data-admin-ugc-process>
      <div class="site-container space-y-10">
        <div class="max-w-3xl space-y-5">
          <EditableText client:load i18nKey="ugcPage.process.eyebrow" as="p" className="font-body text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-amaranth" />
          <EditableText client:load i18nKey="ugcPage.process.title" as="h2" className="font-heading text-4xl leading-none text-ink md:text-5xl" />
        </div>

        <div class="grid items-stretch gap-6 md:grid-cols-2 xl:grid-cols-4">
          {i.ugcPage.process.steps.map((_step, index) => (
            <article class="group relative flex h-full flex-col border border-ink/18 px-5 py-6 transition hover:border-amaranth/60 focus-within:border-amaranth/60">
              <p class="font-body text-sm font-semibold uppercase tracking-[0.16em] text-amaranth">{`0${index + 1}`}</p>
              <EditableText client:load i18nKey={`ugcPage.process.steps.${index}.title`} as="h3" className="mt-5 font-heading text-2xl text-ink" />
              <EditableText client:load i18nKey={`ugcPage.process.steps.${index}.description`} as="div" className="mt-4 text-sm leading-7 text-ink-muted" />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-ink/10 px-6 py-16">
      <div class="site-container space-y-10">
        <div class="max-w-3xl space-y-5">
          <p class="text-xs font-semibold uppercase tracking-[0.32em] text-amaranth">Editor</p>
          <h2 class="text-3xl text-ink md:text-4xl">Portfolio UGC de 12 espacios fijos</h2>
          <p class="text-base leading-8 text-ink/68">
            Actualiza el contenido multimedia, las fichas y los textos localizados sin cambiar el orden de los espacios.
          </p>
        </div>
        <EditableUgcPortfolio client:load />
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .ugc-hero-rule {
    transform-origin: left;
    animation: ugc-hero-rule-draw 0.7s ease-out both;
  }

  @keyframes ugc-hero-rule-draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }

    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
