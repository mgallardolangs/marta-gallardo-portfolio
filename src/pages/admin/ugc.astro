---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ScrollReveal from '../../components/ScrollReveal';
import TypedTitle from '../../components/TypedTitle.astro';
import UgcContactSheet from '../../components/UgcContactSheet';
import EditableUgcPortfolio from '../../components/admin/EditableUgcPortfolio';
import { getLangFromUrl, t } from '../../i18n';
import { siteData } from '../../lib/siteData';

const lang = getLangFromUrl(Astro.url);
const i = t(lang);
---

<AdminLayout title={`Admin — ${i.ugc.title}`} description={i.ugcPage.pageDescription}>
  <div class="bg-paper">
    <section class="px-6 pt-28 pb-8 md:pt-32 md:pb-10">
      <div class="site-container">
        <ScrollReveal client:visible className="max-w-6xl">
          <p class="text-xs font-semibold uppercase tracking-[0.34em] text-amaranth">
            {i.ugcPage.contactSheet.eyebrow}
          </p>
          <TypedTitle
            as="h1"
            text={i.ugcPage.hero.headline}
            trigger="load"
            class="mt-5 block max-w-[9ch] text-5xl leading-none text-ink md:text-7xl"
          />
          <p class="mt-8 max-w-5xl text-balance text-2xl font-semibold uppercase leading-[1.18] tracking-[0.18em] text-ink md:text-4xl">
            {i.ugcPage.contactSheet.headline}
          </p>
        </ScrollReveal>

        <div class="mt-8 overflow-hidden" aria-hidden="true">
          <div class="ugc-hero-rule h-px bg-ink/20" />
        </div>
      </div>
    </section>

    <section class="px-6 pb-16 md:pb-20">
      <div class="site-container">
        <UgcContactSheet
          client:load
          adminPreview
          items={siteData.ugcPortfolio}
          lang={lang}
          copy={i.ugcPage.contactSheet}
        />
      </div>
    </section>

    <section class="border-t border-ink/10 px-6 py-16">
      <div class="site-container space-y-8">
        <div class="max-w-3xl space-y-3">
          <p class="text-xs font-semibold uppercase tracking-[0.32em] text-amaranth">Editor</p>
          <h2 class="text-3xl text-ink md:text-4xl">Fixed 12-slot UGC portfolio</h2>
          <p class="text-base leading-7 text-ink/68">
            Update media and ES / EN / FR copy without changing the approved authored order.
          </p>
        </div>

        <EditableUgcPortfolio client:load />
      </div>
    </section>
  </div>
</AdminLayout>

<style>
  .ugc-hero-rule {
    transform-origin: left;
    animation: ugc-hero-rule-draw 0.7s ease-out both;
  }

  @keyframes ugc-hero-rule-draw {
    from {
      transform: scaleX(0);
      opacity: 0;
    }

    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
